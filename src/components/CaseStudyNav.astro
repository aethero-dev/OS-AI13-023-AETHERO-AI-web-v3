---
/**
 * Pojízdné okno případovky — obsah stránky (zadání DK 2026-08-04).
 *
 * Design = čtecí panel (CteciRezim): tmavé sklo, blur, tyrkysové kolečko.
 * Chování = ObsahPlovouci z Pilgerlandu, jen ukotvené VLEVO: jeden seznam
 * odkazů, nahoře stránky stojí v levém sloupci, a jakmile ho čtenář
 * odscrolluje, přilepí se ke sloupci jako kolečko a rozbaluje se na klik.
 *
 * Proč ne dva prvky (statický + plovoucí): odečítač by přečetl tytéž odkazy
 * dvakrát a nepoznal, který je který.
 *
 * Bez JavaScriptu zůstane obyčejný seznam odkazů nahoře — kotvy fungují
 * vždycky, plovoucí chování je jen navrch (kolečko odkrývá až skript).
 */
interface Props {
  lang?: 'cs' | 'en';
  kapitoly: { id: string; text: string }[];
}
const { lang = 'cs', kapitoly } = Astro.props;
const t = lang === 'en'
  ? { nadpis: 'Contents', otevrit: 'Open page contents', zavrit: 'Close page contents' }
  : { nadpis: 'Obsah', otevrit: 'Otevřít obsah stránky', zavrit: 'Zavřít obsah stránky' };
---

<div class="csnav-misto" data-csnav-misto>
  <nav class="csnav" data-csnav aria-labelledby="csnav-nadpis">
    <button
      type="button"
      class="csnav-prepinac"
      data-csnav-prepinac
      data-otevrit={t.otevrit}
      data-zavrit={t.zavrit}
      aria-expanded="false"
      aria-controls="csnav-panel"
    >
      <span class="csnav-ikona" aria-hidden="true"></span>
      <span class="sr-only" data-csnav-popisek>{t.otevrit}</span>
    </button>

    <div class="csnav-panel" id="csnav-panel" data-csnav-panel>
      <p class="csnav-nadpis" id="csnav-nadpis">{t.nadpis}</p>
      <ol class="csnav-seznam">
        {kapitoly.map((k) => (
          <li>
            <a href={`#${k.id}`} class="csnav-odkaz" data-csnav-odkaz data-cil={k.id}>{k.text}</a>
          </li>
        ))}
      </ol>
    </div>
  </nav>
</div>

<style>
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  /* ── stav v textu — sklo z čtecího panelu ── */
  .csnav-panel {
    background: rgba(10, 14, 46, 0.86);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.42);
    padding: 18px;
  }
  .csnav-nadpis {
    font-family: var(--font-primary); font-size: 13px; font-weight: 600;
    letter-spacing: 0.09em; text-transform: uppercase;
    color: var(--neutral-500); margin: 0 0 12px;
  }
  .csnav-seznam { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .csnav-odkaz {
    display: block;
    font-family: var(--font-primary); font-size: 13px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--neutral-300); text-decoration: none;
    padding: 6px 8px 6px 10px;
    border-left: 2px solid transparent; border-radius: 0 7px 7px 0;
    transition: color var(--transition-base), border-color var(--transition-base), background var(--transition-base);
  }
  .csnav-odkaz:hover { color: #fff; background: rgba(255, 255, 255, 0.06); }
  .csnav-odkaz:focus-visible { outline: 2px solid var(--action-hover); outline-offset: 1px; }
  /* kapitola, ve které čtenář právě je */
  .csnav-odkaz[aria-current='true'] { color: var(--action); border-left-color: var(--action); }

  /* ── kolečko — dokud obsah stojí v textu, není k ničemu, ukáže se až
     přilepené. Vzhled spouštěče čtecího panelu (plné tyrkysové kolečko). ── */
  .csnav-prepinac {
    display: none;
    width: 54px; height: 54px; border-radius: 50%;
    border: 0; background: var(--action);
    cursor: pointer; padding: 0; place-items: center;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45), 0 0 0 6px rgba(22, 190, 207, 0.14);
    transition: var(--transition-base);
  }
  .csnav-prepinac:hover { background: var(--action-hover); transform: scale(1.06); }
  .csnav-prepinac:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  /* tři čárky = seznam */
  .csnav-ikona { position: relative; width: 18px; height: 12px; display: block; }
  .csnav-ikona::before,
  .csnav-ikona::after {
    content: ''; position: absolute; left: 0; width: 100%; height: 2px;
    border-radius: 1px; background: #00121a;
  }
  .csnav-ikona::before { top: 0; box-shadow: 0 5px 0 #00121a; }
  .csnav-ikona::after { bottom: 0; }

  /* ── přilepený stav — VLEVO, zarovnaný se sloupcem obsahu případovky.
     Drží se levé hrany layoutu (max-width 1200), ne okraje okna; když se
     vedle sloupce nevejde, spadne na okraj. ── */
  .csnav.je-plovouci {
    position: fixed;
    left: max(var(--space-24), calc(50vw - 600px + var(--space-24)));
    top: 50%;
    transform: translateY(-50%);
    z-index: 50;
    transition: opacity var(--transition-base);
  }
  /* Nad CTA a patičkou kolečko nesvítí — tyrkysová na tyrkysové by zmizela
     a pod případovkou už není kam navigovat (DK 2026-08-04). */
  .csnav.je-plovouci.je-schovany { opacity: 0; pointer-events: none; }
  .csnav.je-plovouci .csnav-prepinac { display: grid; }
  .csnav.je-plovouci .csnav-panel { display: none; }

  .csnav.je-plovouci.je-otevreny .csnav-panel {
    display: block;
    position: absolute;
    left: 0;
    top: calc(100% + 8px);
    width: min(17rem, calc(100vw - 2 * var(--space-24)));
    max-height: 70svh;
    overflow-y: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .csnav-prepinac, .csnav-odkaz { transition: none; }
    .csnav-prepinac:hover { transform: none; }
  }

  /* Telefon: kolečko vlevo dole (pokyn DK „jen vlevo“), panel jde nahoru */
  @media (max-width: 900px) {
    .csnav.je-plovouci {
      left: var(--space-16);
      top: auto;
      bottom: var(--space-16);
      transform: none;
    }
    .csnav.je-plovouci.je-otevreny .csnav-panel {
      top: auto;
      bottom: calc(100% + 8px);
      width: min(17rem, calc(100vw - 2 * var(--space-16)));
    }
  }

  @media print { .csnav.je-plovouci { display: none; } }
</style>

<script>
  const misto = document.querySelector<HTMLElement>('[data-csnav-misto]');
  const obsah = document.querySelector<HTMLElement>('[data-csnav]');
  const prepinac = document.querySelector<HTMLButtonElement>('[data-csnav-prepinac]');
  const popisek = document.querySelector<HTMLElement>('[data-csnav-popisek]');
  const odkazy = [...document.querySelectorAll<HTMLAnchorElement>('[data-csnav-odkaz]')];

  if (misto && obsah && prepinac && odkazy.length) {
    const texty = {
      otevrit: prepinac.dataset.otevrit ?? 'Otevřít obsah stránky',
      zavrit: prepinac.dataset.zavrit ?? 'Zavřít obsah stránky',
    };

    const nastavOtevreno = (otevreno: boolean) => {
      obsah.classList.toggle('je-otevreny', otevreno);
      prepinac.setAttribute('aria-expanded', String(otevreno));
      if (popisek) popisek.textContent = otevreno ? texty.zavrit : texty.otevrit;
    };

    /* Místo si drží výšku, kterou obsah zabíral v textu — jinak by stránka
       v okamžiku přilepení poskočila. Práh se měří od dokumentu, ne přes
       offsetTop: obsah sedí v gridu. */
    let vyskaVTextu = 0;
    let prahY = 0;
    const zmerVysku = () => {
      if (obsah.classList.contains('je-plovouci')) return;
      const r = obsah.getBoundingClientRect();
      vyskaVTextu = r.height;
      prahY = r.top + window.scrollY + vyskaVTextu;
      misto.style.minHeight = '';
    };

    /* Konec případovky: jakmile do pásma kolečka vjede CTA (tyrkysová na
       tyrkysové) nebo patička, kolečko se schová. */
    const konec = document.querySelector<HTMLElement>('.cs-cta, footer');
    const uzKonci = () => {
      if (!konec) return false;
      const mobil = window.matchMedia('(max-width: 900px)').matches;
      const stredKolecka = mobil ? window.innerHeight - 16 - 27 : window.innerHeight / 2;
      return konec.getBoundingClientRect().top < stredKolecka + 40;
    };

    let tika = false;
    const prekresli = () => {
      tika = false;
      const y = window.scrollY || document.documentElement.scrollTop;
      const plovouci = y > prahY;

      if (plovouci !== obsah.classList.contains('je-plovouci')) {
        if (plovouci) {
          misto.style.minHeight = `${vyskaVTextu}px`;
          obsah.classList.add('je-plovouci');
          nastavOtevreno(false);
        } else {
          obsah.classList.remove('je-plovouci', 'je-otevreny');
          misto.style.minHeight = '';
          prepinac.setAttribute('aria-expanded', 'false');
          if (popisek) popisek.textContent = texty.otevrit;
        }
      }

      if (obsah.classList.contains('je-plovouci')) {
        const schovat = uzKonci();
        if (schovat !== obsah.classList.contains('je-schovany')) {
          obsah.classList.toggle('je-schovany', schovat);
          if (schovat) nastavOtevreno(false);
        }
      }
    };

    zmerVysku();
    prekresli();
    window.addEventListener('scroll', () => {
      if (!tika) { tika = true; requestAnimationFrame(prekresli); }
    }, { passive: true });
    window.addEventListener('resize', () => { zmerVysku(); prekresli(); }, { passive: true });

    prepinac.addEventListener('click', () => nastavOtevreno(!obsah.classList.contains('je-otevreny')));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && obsah.classList.contains('je-otevreny')) {
        nastavOtevreno(false);
        prepinac.focus();
      }
    });

    // klik na kapitolu panel zavře, ať nepřekrývá cíl skoku
    odkazy.forEach((a) => a.addEventListener('click', () => nastavOtevreno(false)));

    /* Zvýraznění kapitoly, ve které čtenář právě je — pruh pod hlavičkou
       webu (87 px): nejvýše položená sekce, která do něj vjela, je aktivní. */
    const cile = odkazy
      .map((a) => document.getElementById(a.dataset.cil ?? ''))
      .filter((el): el is HTMLElement => el !== null);

    if ('IntersectionObserver' in window && cile.length) {
      const viditelne = new Set<string>();
      const oznac = () => {
        let aktivni = '';
        for (const el of cile) if (viditelne.has(el.id)) { aktivni = el.id; break; }
        odkazy.forEach((a) => {
          if (a.dataset.cil === aktivni) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        });
      };
      const pozorovatel = new IntersectionObserver(
        (zaznamy) => {
          for (const z of zaznamy) {
            if (z.isIntersecting) viditelne.add(z.target.id);
            else viditelne.delete(z.target.id);
          }
          oznac();
        },
        { rootMargin: '-100px 0px -66% 0px' }
      );
      cile.forEach((el) => pozorovatel.observe(el));
    }
  }
</script>
