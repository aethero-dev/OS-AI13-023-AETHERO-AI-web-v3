---
export interface Props { lang?: string; }
const { lang = 'cs' } = Astro.props;
// Odkazy bez jazykového prefixu - jazyk určuje doména (DK 2026-08-21).
const p = '';

const intentLinks = lang === 'en'
  ? [
      { label: 'I need a brand', href: `${p}/what-we-do/i-need-a-brand/` },
      { label: "I'm planning a new Shopify store", href: `${p}/what-we-do/new-shopify-store/` },
      { label: 'I want to migrate to Shopify', href: `${p}/what-we-do/switch-to-shopify/` },
      { label: "We're considering international expansion", href: `${p}/what-we-do/international-expansion/` },
      { label: "I'm looking for a growth partner", href: `${p}/what-we-do/growth-and-support/` },
      { label: 'I need custom development or an app', href: `${p}/what-we-do/custom-development-and-apps/` },
      { label: 'I need analysis & strategy', href: `${p}/what-we-do/analysis-and-strategy/` },
    ]
  : [
      { label: 'Potřebuji brand', href: `${p}/co-umime/potrebuji-brand/` },
      { label: 'Přemýšlím o novém Shopify e-shopu', href: `${p}/co-umime/novy-shopify-e-shop/` },
      { label: 'Chci přejít na Shopify', href: `${p}/co-umime/prechod-na-shopify/` },
      { label: 'Zvažujeme zahraniční expanzi', href: `${p}/co-umime/expanze-do-zahranici/` },
      { label: 'Hledám partnera pro rozvoj či podporu', href: `${p}/co-umime/rozvoj-a-podpora/` },
      { label: 'Potřebuji custom úpravy či aplikace', href: `${p}/co-umime/custom-vyvoj-a-aplikace/` },
      { label: 'Potřebuji analýzu a strategii', href: `${p}/co-umime/analyza-a-strategie/` },
    ];
---

<footer>
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href={`${p}/`} class="logo" aria-label="aethero">
        <img src="/ae-logo.svg" alt="æthero" width="140" height="35" loading="lazy" />
      </a>
      <img src="/shopify-plus-badge.svg" alt="Shopify Plus Partner" class="shopify-badge" width="130" height="45" loading="lazy" />
    </div>

    <div class="footer-intent">
      <p class="footer-label">
        {lang === 'en' ? 'What can we do for you around Shopify?' : 'Co pro vás okolo Shopify můžeme udělat?'}
      </p>
      <ul>
        {intentLinks.map((l, i) => (
          <li>
            <a href={l.href}>
              <span class="footer-num">0{i + 1}</span>
              {l.label} ➔
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="container footer-legal">
    <p class="footer-copy">
      © {new Date().getFullYear()} AETHERO s.r.o.
    </p>
    <ul class="footer-legal-links">
      <li>
        <a href={`${p}/gdpr/`}>
          {lang === 'en' ? 'Privacy policy' : 'Zásady zpracování osobních údajů'}
        </a>
      </li>
      <li>
        <button type="button" class="footer-cookie-btn" id="ae-open-cookies">
          {lang === 'en' ? 'Cookie settings' : 'Nastavení cookies'}
        </button>
      </li>
    </ul>
  </div>
</footer>

<script>
  document.getElementById('ae-open-cookies')?.addEventListener('click', () => {
    const open = (window as any).aeOpenCookieSettings;
    if (typeof open === 'function') open();
  });
</script>

<style>
  footer {
    /* Tmavší než tělo webu (#000326) - patička se má propadnout, ne svítit
       (DK 2026-08-05; první pokus straight-blue byl omyl opačným směrem) */
    background: #000218;
  }

  .footer-legal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-24);
    flex-wrap: wrap;
    padding: var(--space-24) var(--space-24);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .footer-copy {
    margin: 0;
    font-size: 13px;
    color: var(--neutral-300); /* rozsvíceno o polovinu (DK 21.8.) */
    display: flex; align-items: center; gap: var(--space-16);
  }
  .footer-legal-links {
    display: flex;
    /* row EXPLICITNĚ - obecné `ul { flex-direction: column }` níž by jinak
       poslalo právní odkazy pod sebe (DK 2026-08-05: „na jeden řádek") */
    flex-direction: row;
    align-items: center;
    gap: var(--space-24);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  .footer-legal-links a,
  .footer-cookie-btn {
    font-size: 13px;
    color: var(--neutral-300); /* rozsvíceno o polovinu (DK 21.8.) */
    text-decoration: none;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: inherit;
  }
  .footer-legal-links a:hover,
  .footer-cookie-btn:hover {
    color: var(--action);
    text-decoration: underline;
  }
  .footer-legal-links a:focus-visible,
  .footer-cookie-btn:focus-visible {
    outline: 2px solid var(--action);
    outline-offset: 2px;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: var(--space-80) var(--space-24);
  }

  .footer-brand {
    /* Badge POD logem, stejná šířka jako logo (DK 2026-08-21, DS blok 4) */
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .logo { display: flex; align-items: center; }
  .logo img { opacity: 0.9; width: 180px; height: auto; }
  .shopify-badge { display: block; width: 180px; height: auto; }

  .footer-label {
    font-family: var(--font-primary);
    font-size: 16px;
    font-weight: 400;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 20px;
    line-height: 1.4;
  }

  ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  ul a {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-family: var(--font-secondary);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--action);
    transition: color var(--transition-base);
  }
  ul a:hover { color: #fff; text-decoration: underline; text-underline-offset: 3px; }

  .footer-num {
    font-family: var(--font-primary);
    font-size: 14px;
    font-weight: 700;
    color: rgba(255,255,255,0.7);
    flex-shrink: 0;
    letter-spacing: 0.05em;
  }

  @media (max-width: 768px) {
    .footer-inner {
      flex-direction: column;
      gap: var(--space-40);
      padding: var(--space-40) var(--space-24);
    }
    .footer-brand {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }
</style>
