---
import { altPath } from '../../lib/i18n-paths';

export interface Props { lang?: string; }
const { lang = 'cs' } = Astro.props;
const p = lang === 'en' ? '/en' : '/cs';

// Přepínač jazyka — protějšek řeší altPath, ne záměna prefixu.
// Blogové články mají v každém jazyce jiný slug, takže prostá záměna
// vedla z článku rovnou do 404 (audit prokliků AE-38, 2026-08-02).
const currentPath = Astro.url.pathname;
const otherLang = lang === 'en' ? 'cs' : 'en';
const isActive = (href: string) => {
  if (href === `${p}/`) return currentPath === `${p}/`;
  return currentPath === href || currentPath.startsWith(href + '/');
};
// null = protějšek neexistuje → přepínač se nevykreslí (lepší než odkaz do 404)
const otherPath = altPath(currentPath, otherLang);

const navItems = lang === 'en'
  ? [
      { label: 'HOME', href: `${p}/` },
      {
        label: 'WHAT WE DO',
        href: `${p}/co-umime`,
        dropdown: [
          { label: 'Brand & Identity', href: `${p}/co-umime/potrebuji-brand` },
          { label: 'New Shopify Store', href: `${p}/co-umime/novy-shopify-e-shop` },
          { label: 'Migration to Shopify', href: `${p}/co-umime/prechod-na-shopify` },
          { label: 'International Expansion', href: `${p}/co-umime/expanze-do-zahranici` },
          { label: 'Development & Support', href: `${p}/co-umime/rozvoj-a-podpora` },
          { label: 'Strategy & Analytics', href: `${p}/co-umime/analyza-a-strategie` },
          { label: 'Custom Development', href: `${p}/co-umime/custom-vyvoj-a-aplikace` },
        ],
      },
      {
        label: 'APPS',
        href: `${p}/co-umime/custom-vyvoj-a-aplikace`,
        activeMatch: [`${p}/esyncer`, `${p}/ae-translator`],
        dropdown: [
          { label: 'eSyncer', href: `${p}/esyncer` },
          { label: 'AE Translator', href: `${p}/ae-translator` },
        ],
      },
      { label: 'BLOG', href: `${p}/blog` },
      { label: 'ABOUT', href: `${p}/o-nas` },
      { label: 'CONTACT', href: `${p}/kontakt` },
    ]
  : [
      { label: 'ÚVOD', href: `${p}/` },
      {
        label: 'CO UMÍME',
        href: `${p}/co-umime`,
        dropdown: [
          { label: 'Potřebuji brand', href: `${p}/co-umime/potrebuji-brand` },
          { label: 'Nový Shopify e-shop', href: `${p}/co-umime/novy-shopify-e-shop` },
          { label: 'Přechod na Shopify', href: `${p}/co-umime/prechod-na-shopify` },
          { label: 'Expanze do zahraničí', href: `${p}/co-umime/expanze-do-zahranici` },
          { label: 'Rozvoj a podpora', href: `${p}/co-umime/rozvoj-a-podpora` },
          { label: 'Analýza a strategie', href: `${p}/co-umime/analyza-a-strategie` },
          { label: 'Custom vývoj a aplikace', href: `${p}/co-umime/custom-vyvoj-a-aplikace` },
        ],
      },
      {
        label: 'APLIKACE',
        href: `${p}/co-umime/custom-vyvoj-a-aplikace`,
        activeMatch: [`${p}/esyncer`, `${p}/ae-translator`],
        dropdown: [
          { label: 'eSyncer', href: `${p}/esyncer` },
          { label: 'AE Translator', href: `${p}/ae-translator` },
        ],
      },
      { label: 'BLOG', href: `${p}/blog` },
      { label: 'O NÁS', href: `${p}/o-nas` },
      { label: 'KONTAKT', href: `${p}/kontakt` },
    ];
---

<header id="site-header">
  <div class="header-inner container">
    <a href={`${p}/`} class="logo" aria-label="aethero">
      <img src="/ae-logo.svg" alt="æthero" width="140" height="35" loading="eager" />
    </a>

    <nav id="nav-menu" role="navigation" aria-label={lang === 'en' ? 'Main navigation' : 'Hlavní navigace'}>
      <button class="nav-close" id="nav-close" aria-label={lang === 'en' ? 'Close menu' : 'Zavřít menu'}>
        <span></span>
        <span></span>
      </button>
      <ul class="nav-list">
        {navItems.map((item) => {
          const am = (item as { activeMatch?: string[] }).activeMatch;
          const active = am ? am.some(isActive) : isActive(item.href);
          return (
          <li class={item.dropdown ? 'has-dropdown' : ''}>
            <a href={item.href} class={`nav-link${active ? ' is-active' : ''}`}>
              {item.label}
              {item.dropdown && (
                <svg class="nav-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              )}
            </a>
            {item.dropdown && (
              <ul class="dropdown">
                {item.dropdown.map((sub) => (
                  <li><a href={sub.href} class={`dropdown-link${currentPath === sub.href ? ' is-active' : ''}`}>{sub.label}</a></li>
                ))}
              </ul>
            )}
          </li>
          );
        })}
        <!-- mobile-only lang switch inside nav overlay -->
        {otherPath && (
          <li class="mobile-lang-li">
            <a href={otherPath} class="mobile-lang-link" aria-label={`Switch to ${otherLang.toUpperCase()}`}>
              {otherLang.toUpperCase()}
            </a>
          </li>
        )}
      </ul>
    </nav>

    {otherPath && (
      <a href={otherPath} class="lang-switch" aria-label={`Switch to ${otherLang.toUpperCase()}`}>
        {otherLang.toUpperCase()}
      </a>
    )}

    <button class="hamburger" id="hamburger" aria-label={lang === 'en' ? 'Open menu' : 'Otevřít menu'} aria-expanded="false" aria-controls="nav-menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const hamburger = document.getElementById('hamburger')!;
  const navMenu = document.getElementById('nav-menu')!;

  // Transparent → solid on scroll + hide on scroll down (mobile)
  let lastY = window.scrollY;
  const onScroll = () => {
    const y = window.scrollY;
    header.classList.toggle('scrolled', y > 40);

    const menuOpen = hamburger.getAttribute('aria-expanded') === 'true';
    if (!menuOpen && window.innerWidth <= 900) {
      if (y > lastY && y > 80) {
        header.classList.add('nav-hidden');
      } else if (y < lastY) {
        header.classList.remove('nav-hidden');
      }
    }
    lastY = y;
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const closeMenu = () => {
    hamburger.setAttribute('aria-expanded', 'false');
    hamburger.classList.remove('open');
    navMenu.classList.remove('open');
    document.body.style.overflow = '';
  };

  // Close button inside panel
  document.getElementById('nav-close')?.addEventListener('click', closeMenu);

  // Hamburger toggle
  hamburger.addEventListener('click', () => {
    const open = hamburger.getAttribute('aria-expanded') === 'true';
    hamburger.setAttribute('aria-expanded', String(!open));
    hamburger.classList.toggle('open', !open);
    navMenu.classList.toggle('open', !open);
    document.body.style.overflow = open ? '' : 'hidden';
  });

  // Close mobile menu on nav link click
  navMenu.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  // Desktop dropdown: keyboard accessibility (Escape closes)
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('.has-dropdown').forEach((el) => {
        (el as HTMLElement).blur();
      });
    }
  });
</script>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    transition: background var(--transition-base), box-shadow var(--transition-base), padding var(--transition-base), transform 0.3s ease;
    padding: 22px 0;
    background: transparent;
    /* fallback předchozí verze (ztmavující pruh): background: linear-gradient(to bottom, rgba(0,0,0,0.35) 0%, transparent 100%); */
  }

  /* Základní stav: glassmorphism strip — frosted nahoře, přes mask se vytrácí dolů.
     V ::before, aby blur/mask nezasáhly text menu. Po scrollu se skryje. */
  header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to bottom, rgba(0, 3, 38, 0.5) 0%, rgba(0, 3, 38, 0.12) 55%, transparent 100%);
    backdrop-filter: blur(10px) saturate(1.3);
    -webkit-backdrop-filter: blur(10px) saturate(1.3);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 45%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 45%, transparent 100%);
    transition: opacity var(--transition-base);
    pointer-events: none;
  }
  header.scrolled::before { opacity: 0; }

  /* ──────────────────────────────────────────────────────────────
     PŘEDCHOZÍ VERZE (fallback pro vrácení) — plná tmavá lišta přes celou šířku.
     Pro návrat: nahradit blok „header.scrolled" + smazat „header.scrolled .header-inner"
     a vrátit .header-inner bez border/border-radius/transition:
        header.scrolled { background: rgba(0, 3, 38, 1); padding: 16px 0; }
     (verze rovněž v gitu: commit 6567363, před glassmorphism lištou)
     ────────────────────────────────────────────────────────────── */

  /* Po scrollu: hlavička sama zprůhlední, plovoucí skleněná lišta je .header-inner */
  header.scrolled {
    background: transparent;
    padding: 12px 0;
  }
  header.nav-hidden {
    transform: translateY(-100%);
  }

  .header-inner {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: 0 24px;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    transition: background var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base), padding var(--transition-base);
  }

  /* Plovoucí glassmorphism lišta (à la open-design, ale náš rounding + tmavý frost) */
  header.scrolled .header-inner {
    background: rgba(255, 255, 255, 0.07);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18), 0 8px 32px rgba(0, 0, 0, 0.35);
    padding: 4px var(--space-24);
  }

  /* Logo */
  .logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    transition: opacity var(--transition-base);
  }
  .logo img { display: block; transition: width var(--transition-base); }
  .logo:hover { opacity: 0.8; }
  /* Po odlepení zmenšit logo */
  header.scrolled .logo img { width: 108px; height: auto; }

  /* Nav — col 2 (1fr, center) */
  nav {
    display: flex;
    justify-content: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    /* nav texty o 5px níž vůči liště (logo + jazyk beze změny) — relative, nemění výšku */
    position: relative;
    top: 5px;
  }

  li { position: relative; }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 8px 14px;
    font-family: var(--font-secondary);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--text-primary);
    transition: color var(--transition-base);
    white-space: nowrap;
    line-height: 1.4;
  }
  .nav-link:hover,
  .nav-link.is-active {
    color: var(--action);
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1.5px;
  }
  .nav-link.is-active { color: #fff; }

  .nav-chevron {
    opacity: 0.5;
    transition: transform var(--transition-base), opacity var(--transition-base);
    flex-shrink: 0;
  }
  .has-dropdown:hover .nav-chevron,
  .has-dropdown:focus-within .nav-chevron {
    transform: rotate(180deg);
    opacity: 1;
  }

  /* Dropdown — bridged gap so submenu is always clickable */
  .has-dropdown { position: relative; }

  /* Invisible bridge between nav-link and dropdown — prevents hover gap */
  .has-dropdown::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 0;
    right: 0;
    height: 6px;
  }

  .dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    min-width: 220px;
    background: var(--ae-bg-primary);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--radius-md);
    box-shadow: 0 16px 40px rgba(0,0,0,0.6);
    padding: 6px 0;
    list-style: none;
    z-index: 500;
  }
  .has-dropdown:hover .dropdown,
  .has-dropdown:focus-within .dropdown {
    display: block;
  }

  .dropdown-link {
    display: block;
    padding: 6px 20px;
    font-size: 18px;
    font-family: var(--font-secondary);
    font-weight: 600;
    letter-spacing: 0;
    color: rgba(255,255,255,0.8);
    line-height: 1.1;
    transition: color var(--transition-base), background var(--transition-base);
    white-space: nowrap;
  }
  .dropdown-link:hover,
  .dropdown-link.is-active {
    color: var(--action);
    background: rgba(13,212,205,0.06);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .dropdown-link.is-active { color: #fff; }

  /* Language switcher — col 3 */
  .lang-switch {
    font-family: var(--font-secondary);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0;
    color: rgba(255,255,255,0.7);
    padding: 5px 10px;
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 4px;
    transition: color var(--transition-base), border-color var(--transition-base);
    white-space: nowrap;
  }
  .lang-switch:hover { color: #fff; border-color: var(--action); }

  /* Hamburger — col 4, hidden on desktop */
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }
  .hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--text-primary);
    border-radius: 2px;
    transform-origin: center;
    /* zavírání: čáry se vrátí zpět až po zpoždění 0.2s (střed se nejdřív objeví) */
    transition: transform 0.2s 0.2s ease, opacity 0s 0.2s, background-color 0s 0.2s;
  }
  /* otevírání: rotace okamžitě, střed zmizí s delay */
  .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); transition: transform 0.2s ease; }
  .hamburger.open span:nth-child(2) { opacity: 0; transition: opacity 0s 0.1s; }
  .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); transition: transform 0.2s ease; }

  /* Close button inside nav panel — hidden on desktop */
  .nav-close { display: none; }

  /* Mobile lang switch inside nav — hidden on desktop */
  .mobile-lang-li { display: none; }

  /* ─── MOBILE ≤ 900px ─── */
  @media (max-width: 900px) {
    .header-inner {
      grid-template-columns: 1fr auto auto;
      gap: 0 12px;
      position: relative; /* creates stacking context so children sit above nav overlay */
      z-index: 2;
    }

    .hamburger { display: flex; }

    /* Collapse desktop lang-switch — mobile has it inside nav */
    .lang-switch { display: none; }

    /* Nav overlay — pravý panel 2/3 šířky */
    nav {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      left: auto;
      width: 67%;
      background: rgba(0, 3, 38, 0.98);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      display: flex;
      align-items: flex-start;
      justify-content: flex-start;
      padding: 72px 20px 48px 20px;
      transform: translateX(100%);
      transition: transform 0.3s ease;
      z-index: 1;
      justify-self: unset;
      overflow-y: auto;
    }
    nav.open { transform: translateX(0); }

    .nav-list {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      width: 100%;
      top: 0; /* na mobilu žádný nudge */
    }

    .nav-link {
      font-size: 22px;
      font-weight: 600;
      padding: 8px 0;
      justify-content: flex-start;
    }

    /* Dropdowns always visible and expanded in mobile */
    .dropdown {
      position: static;
      display: block;
      background: transparent;
      border: none;
      box-shadow: none;
      padding: 0 0 0 16px; /* indent doprava — hierarchie */
      margin-top: 0;       /* těsně pod rodičem */
      margin-bottom: 24px; /* výrazné oddělení od další skupiny */
      min-width: unset;
    }
    .has-dropdown::after { display: none; }
    .nav-chevron { display: none; }

    .dropdown-link {
      font-size: 16px;
      text-align: left;
      color: rgba(255,255,255,0.55);
      padding: 3px 0;
    }
    .dropdown-link:hover { color: var(--action); background: transparent; }

    .nav-close {
      display: flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      top: 20px;
      right: 20px;
      width: 36px;
      height: 36px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 0;
    }
    .nav-close span {
      display: block;
      position: absolute;
      width: 22px;
      height: 2px;
      background: var(--text-primary);
      border-radius: 2px;
      transition: background var(--transition-base);
    }
    .nav-close span:nth-child(1) { transform: rotate(45deg); }
    .nav-close span:nth-child(2) { transform: rotate(-45deg); }
    .nav-close:hover span { background: var(--action); }

    /* Mobile lang switch visible inside nav */
    .mobile-lang-li {
      display: flex;
      margin-top: 24px;
    }
    .mobile-lang-link {
      font-family: var(--font-primary);
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 0;
      color: rgba(255,255,255,0.5);
      padding: 6px 16px;
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 4px;
      transition: color var(--transition-base), border-color var(--transition-base);
    }
    .mobile-lang-link:hover { color: #fff; border-color: var(--action); }
  }

  @media (max-width: 480px) {
    .nav-link { font-size: 20px; padding: 8px 0; }
  }
</style>
