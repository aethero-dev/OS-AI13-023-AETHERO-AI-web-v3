---
export interface Props {
  label: string;
  title: string;
  subtitle: string;
  ctaLabel?: string;
  ctaHref?: string;
  cta2Label?: string;
  cta2Href?: string;
  ctaLower?: boolean;
  lang?: 'cs' | 'en';
  image?: string;
  imageAlt?: string;
}
const { label, title, subtitle, ctaLabel = 'Zavolejme si', ctaHref = 'tel:+420776067663', cta2Label, cta2Href, ctaLower = true, lang = 'cs', image, imageAlt = '' } = Astro.props;
const contactHref = cta2Href || `/${lang}/kontakt`;
const contactLabel = cta2Label || (lang === 'en' ? 'Find out how' : 'Zjistěte jak');
---

<section class={`service-hero${image ? ' service-hero--with-image' : ''}`}>
  <div class="hero-bg-image" aria-hidden="true">
    <img src="/ae-bgr-w-glass-b-2x-v3.webp" alt="" loading="eager" />
  </div>
  <div class="hero-blob" aria-hidden="true"></div>
  <div class={`container${image ? ' service-hero-split' : ' service-hero-inner'}`}>
    <div class="hero-text">
      <h1 set:html={title} />
      <p class="hero-sub">{subtitle}</p>
      <div class="hero-ctas">
        <a href={ctaHref} class={`btn-primary${ctaLower ? ' btn-primary--lower' : ''}`}>{ctaLabel}</a>
        <a href={contactHref} class={`btn-ghost${ctaLower ? ' btn-ghost--lower' : ''}`}>{contactLabel}</a>
      </div>
    </div>
    {image && (
      <div class="hero-image-wrap" aria-hidden="true">
        <img src={image} alt={imageAlt} class="hero-image" loading="eager" />
      </div>
    )}
  </div>
</section>

<style>
  .service-hero {
    position: relative;
    padding: 215px 0 153px;
    /* Byla tu vlastní barva #07051B, jenže stránka má #000326 — na rozhraní
       sekcí z toho byl vidět proužek. Teď táž barva jako zbytek stránky. */
    background: var(--ae-bg-primary);
    overflow: hidden;
  }
  .hero-bg-image {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .hero-bg-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
    display: block;
  }
  .hero-bg-image::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 160px;
    background: linear-gradient(to bottom, transparent 0%, #000326 100%);
  }
  .hero-blob {
    position: absolute;
    top: -20%;
    right: -5%;
    width: 600px;
    height: 600px;
    background: radial-gradient(ellipse, rgba(203,0,215,0.15) 0%, rgba(9,32,102,0.2) 50%, transparent 70%);
    border-radius: 50%;
    filter: blur(60px);
    pointer-events: none;
  }
  .service-hero-inner { position: relative; z-index: 1; max-width: 720px; }

  /* Split layout — text left, image right */
  .service-hero-split {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
  }
  /* Obrázek objektu má fialové pozadí zapečené v sobě a sedí na spodní hraně
     hero. Bez přechodu se useknul ostrou vodorovnou čarou (DK 2026-08-04).
     Přechod jde přes celou šířku a končí přesně v barvě stránky, takže
     hero se do dalšího obsahu napojí místo aby o něj zavadil. */
  .service-hero--with-image { padding-bottom: 0; }
  /* Vyšší hero jen na desktopu. Na mobilu se obsah smrskne a min-height by
     pod tlačítky nechalo prázdnou fialovou plochu (DK 2026-08-04). */
  @media (min-width: 901px) {
    .service-hero--with-image { min-height: 860px; }
  }
  .service-hero--with-image::after {
    content: '';
    position: absolute; left: 0; right: 0; bottom: 0;
    height: 240px; z-index: 1; pointer-events: none;
    background: linear-gradient(to bottom,
      rgba(0, 3, 38, 0) 0%,
      rgba(0, 3, 38, 0.55) 45%,
      var(--ae-bg-primary) 100%);
  }
  /* text a tlačítka musí zůstat nad přechodem */
  .service-hero-split { z-index: 2; }
  .hero-text { position: relative; text-align: left; }
  .hero-image-wrap {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-top: 40px;
  }
  /* Sekce hned za heroem začíná výš — dřív mezi nimi bylo 120 px prázdna
     a nadpis se propadal pod zlom (DK 2026-08-04). */
  .service-hero + :global(.section) { padding-top: var(--space-64); }
  .hero-image {
    width: 100%;
    max-width: 540px;
    height: auto;
    display: block;
    filter: drop-shadow(0 40px 80px rgba(203,0,215,0.25));
  }

  @media (max-width: 900px) {
    /* Mobil: obrázek nahoře, text dole */
    .service-hero--with-image { padding-top: 0; }
    .service-hero-split {
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .hero-image-wrap {
      order: -1;
      display: flex;
      justify-content: center;
      align-items: flex-end;
      padding-top: 80px;
      padding-bottom: 0;
      width: 100%;
      max-height: 300px;
      overflow: hidden;
    }
    .hero-image {
      max-width: 260px;
      height: auto;
    }
    .hero-text { padding-top: 24px; }
  }
  h1 {
    font-size: var(--fs-64);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: var(--space-24);
    color: #fff;
    text-transform: uppercase;
  }
  h1 :global(span) { color: #fff !important; }
  .hero-sub {
    font-size: 20px;
    color: rgba(255,255,255,0.85);
    line-height: 1.6;
    margin-bottom: var(--space-40);
    max-width: 560px;
  }
  .hero-ctas { display: flex; gap: var(--space-16); flex-wrap: wrap; }

  @media (max-width: 768px) {
    .service-hero { padding: 154px 0 92px; }
    .service-hero--with-image { padding: 0 0 72px; }
    .hero-sub { font-size: 18px; }
  }
  @media (max-width: 480px) {
    .service-hero { padding: 123px 0 74px; }
    .service-hero--with-image { padding: 0 0 56px; }
    h1 { font-size: var(--fs-48); }
    .hero-sub { font-size: 16px; }
    .hero-blob { width: 300px; height: 300px; }
    .hero-image-wrap { padding-top: 64px; max-height: 240px; }
    .hero-image { max-width: 200px; }
  }
</style>
