---
import '../styles/global.css';
import { ANALYTICS_ID, CONSENT_KEY, analyticsEnabled } from '../config/analytics';
import { altPath } from '../lib/i18n-paths';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  lang?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title,
  description = 'Česká digitální agentura. Design, strategie a technologie pro e-commerce.',
  ogImage = '/og-image.png',
  lang = 'cs',
  jsonLd,
} = Astro.props;
// Cíl LAUNCH.md §1: canonical/OG per JAZYK, ne per aktuální host - CS vždy
// na .cz, EN vždy na .agency, bez ohledu na to, ze které domény přišel
// request (dokud .cz neběží ostře, je jazyk jediný spolehlivý ukazatel).
// primaryDomain = firma jako entita (Organization schema), ne stránka.
const primaryDomain = 'https://aethero.cz';
const langSiteUrl = lang === 'cs' ? 'https://aethero.cz' : 'https://aethero.agency';
const canonicalUrl = `${langSiteUrl}${Astro.url.pathname}`;
// Protějšky pro hreflang - přes altPath, ne prostou záměnou prefixu.
// null = stránka protějšek nemá (mimo jazykové větve, nebo článek bez páru)
// a hreflang se nevykreslí; dřív mířil na neexistující URL (AE-8).
// Absolutně cross-domain (LAUNCH.md §1): cs vždy .cz, en vždy .agency.
const altCs = altPath(Astro.url.pathname, 'cs');
const altEn = altPath(Astro.url.pathname, 'en');

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "AETHERO s.r.o.",
  "alternateName": "aethero",
  "url": primaryDomain,
  // Google chce u Organization skutečné logo, ne favicon; navíc favicon.svg
  // se po výměně ikony (2026-08-02) už nepoužívá.
  "logo": `${primaryDomain}/ae-logo.svg`,
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+420776067663",
    "areaServed": ["CZ","SK","PL","AT","DE"],
    "availableLanguage": ["Czech","English"]
  },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Budovcova 700/14",
    "addressLocality": "České Budějovice",
    "postalCode": "370 01",
    "addressCountry": "CZ"
  },
  "sameAs": ["https://aethero.cz"]
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": `${title} | aethero`,
  "description": description,
  "url": canonicalUrl,
  "inLanguage": lang === 'cs' ? 'cs-CZ' : 'en-US',
  "publisher": { "@type": "Organization", "name": "AETHERO s.r.o.", "url": primaryDomain }
};

const schemas = [orgSchema, webPageSchema, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- Favicon: zdroj je značková ikona AE-2026-FAVICON-agency.png (BRAND AE).
       SVG varianta se záměrně nepoužívá - v prohlížečích má přednost před PNG
       a přebíjela by novou ikonu. -->
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
  <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#030626" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <!-- Fonty jsou self-hostované (src/styles/fonts.css) - žádná cizí doména
       v kritické cestě, žádná IP návštěvníka do USA bez souhlasu (AE-5).
       Preload jen dvou řezů, které jsou v prvním viewportu: nadpisy Kanit 700
       a běžný text Montserrat 400. Zbytek se dotáhne, až bude potřeba. -->
  <link rel="preload" href="/fonts/kanit-700-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/montserrat-400-latin.woff2" as="font" type="font/woff2" crossorigin />
  <title>{title} | aethero</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="canonical" href={canonicalUrl} />
  {altCs && <link rel="alternate" hreflang="cs" href={`https://aethero.cz${altCs}`} />}
  {altEn && <link rel="alternate" hreflang="en" href={`https://aethero.agency${altEn}`} />}
  {altEn && <link rel="alternate" hreflang="x-default" href={`https://aethero.agency${altEn}`} />}
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:locale" content={lang === 'cs' ? 'cs_CZ' : 'en_US'} />
  <meta property="og:title" content={`${title} | aethero`} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${langSiteUrl}${ogImage}`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} | aethero`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${langSiteUrl}${ogImage}`} />
  {schemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}

  {analyticsEnabled && (
    <script is:inline define:vars={{ ANALYTICS_ID, CONSENT_KEY }}>
      // Měření se načte AŽ po souhlasu - do té doby se nespouští nic.
      // Zdroj pravdy o souhlasu je u nás (localStorage), ne u měřicího nástroje.
      window.dataLayer = window.dataLayer || [];
      window.aeLoadAnalytics = function () {
        if (window.__aeAnalyticsLoaded) return;
        window.__aeAnalyticsLoaded = true;
        var isGtm = ANALYTICS_ID.indexOf('GTM-') === 0;
        var s = document.createElement('script');
        s.async = true;
        if (isGtm) {
          window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          s.src = 'https://www.googletagmanager.com/gtm.js?id=' + ANALYTICS_ID;
        } else {
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ANALYTICS_ID;
          s.onload = function () {
            function gtag() { window.dataLayer.push(arguments); }
            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', ANALYTICS_ID, { anonymize_ip: true });
          };
        }
        document.head.appendChild(s);
      };
      // Vracející se návštěvník, který už souhlas dal
      try {
        if (localStorage.getItem(CONSENT_KEY) === 'accept') window.aeLoadAnalytics();
      } catch (e) {}
    </script>
  )}
</head>
<body>
  <slot />
  <script>
    // Czech typography: non-breaking space after single-char prepositions/conjunctions
    const SKIP = new Set(['H1','H2','H3','H4','H5','H6','SCRIPT','STYLE','CODE','PRE','TEXTAREA','INPUT']);
    const RE = /\b([kvzsauioKVZSAUIO]) /g;

    function fixNode(node) {
      if (node.nodeType === 3) {
        node.nodeValue = node.nodeValue.replace(RE, '$1 ');
      } else if (node.nodeType === 1 && !SKIP.has(node.tagName)) {
        node.childNodes.forEach(fixNode);
      }
    }

    fixNode(document.body);

    // edge-glow: nepravidelný světelný přejezd po hraně karty, jen když je prvek ve viewportu
    (function () {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const rand = (min, max) => min + Math.random() * (max - min);
      document.querySelectorAll('.edge-glow').forEach((el) => {
        if (el.dataset.egInit) return; el.dataset.egInit = '1';
        let timer = null;
        const stop = () => { if (timer) { clearTimeout(timer); timer = null; } el.classList.remove('is-sweeping'); };
        const schedule = (delay) => { timer = setTimeout(() => { el.classList.add('is-sweeping'); schedule(rand(15000, 45000)); }, delay); };
        el.addEventListener('animationend', () => el.classList.remove('is-sweeping'));
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting && !timer) schedule(rand(2500, 5000));
            else if (!e.isIntersecting) stop();
          });
        }, { threshold: 0.25 });
        io.observe(el);
      });
    })();
  </script>
</body>
</html>
