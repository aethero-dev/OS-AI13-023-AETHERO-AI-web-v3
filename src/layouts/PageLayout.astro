---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import CookieConsent from '../components/layout/CookieConsent.astro';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  lang?: string;
  /** Schéma stránky (Article, FAQPage…). MUSÍ se předat do BaseLayoutu -
      dokud tady chybělo, články sice schéma posílaly, ale tiše se zahazovalo
      a do HTML se nikdy nedostalo (AE-7, opraveno 2026-08-02). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** O nás: logo se z menu schová a žije velké v hero (DK 2026-08-05) */
  skryjLogo?: boolean;
}

const { title, description, ogImage, lang, jsonLd, skryjLogo } = Astro.props;
---

<BaseLayout {title} {description} {ogImage} {lang} {jsonLd}>
  <a href="#main-content" class="skip-link">
    {lang === 'en' ? 'Skip to content' : 'Přeskočit na obsah'}
  </a>
  <Header lang={lang} skryjLogo={skryjLogo} />
  <main id="main-content">
    <slot />
  </main>
  <Footer lang={lang} />
  <CookieConsent lang={lang} />
</BaseLayout>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 16px;
    z-index: 9999;
    padding: 12px 20px;
    background: var(--action);
    color: #000326;
    font-family: var(--font-primary);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 0 0 6px 6px;
    transition: top 0.15s ease;
  }
  .skip-link:focus {
    top: 0;
    outline: 3px solid #fff;
    outline-offset: 2px;
  }
</style>
