---
// 404 lokalizovaná pro CS - Cloudflare "404-page" not_found_handling
// (wrangler.jsonc) hledá 404.html od rewritnuté cesty nahoru, takže
// /cs/cokoli dostane tuhle a /en/cokoli tu z src/pages/en/404.astro.
// Kořenová src/pages/404.astro zůstává jako poslední bilingvní záchrana.
// Vzniklo: nález BP Claude 31.8. (revize webu, bod P2.4).
import PageLayout from '../../layouts/PageLayout.astro';
---

<PageLayout
  title="404 - stránka nenalezena"
  description="Stránka neexistuje nebo byla přesunuta."
  lang="cs"
>
  <section class="nf">
    <div class="container">
      <p class="nf-code" aria-hidden="true">404</p>
      <h1 class="h2">Stránka nenalezena</h1>
      <p class="nf-sub">Tahle adresa neexistuje, nebo se přestěhovala jinam.</p>
      <div class="nf-actions">
        <a href="/" class="btn-action">Zpět na úvod</a>
      </div>
      <p class="nf-links">
        Hledáte něco konkrétního?
        <a href="/co-umime/" class="text-link">Co umíme</a> ·
        <a href="/blog/" class="text-link">Blog</a> ·
        <a href="/kontakt/" class="text-link">Kontakt</a>
      </p>
    </div>
  </section>
</PageLayout>

<style>
  .nf {
    padding: 200px 0 120px; /* fixed header offset dle vzoru .cs-layout */
    text-align: center;
    min-height: 70vh;
  }
  .nf-code {
    font-family: var(--font-primary);
    font-size: var(--fs-160);
    font-weight: 700;
    line-height: 1;
    margin: 0;
    color: var(--text-secondary);
    opacity: 0.35;
  }
  .nf h1 { margin: 8px 0 16px; }
  .nf-sub {
    color: rgba(255, 255, 255, 0.8);
    font-size: var(--fs-20);
    margin: 0 auto;
    max-width: 600px;
  }
  .nf-actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    margin: 40px 0 48px;
  }
  .nf-links { color: var(--neutral-500); font-size: var(--text-body); }
  @media (max-width: 480px) {
    .nf { padding: 154px 0 80px; }
  }
</style>
