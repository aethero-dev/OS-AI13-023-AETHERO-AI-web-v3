---
import PageLayout from '../../../layouts/PageLayout.astro';
import { useStoryblokApi, renderRichText } from '@storyblok/astro';
import ArticleFaq from '../../../components/ArticleFaq.astro';
import { articleExtras } from '../../../data/article-extras';

interface PostSummary {
  slug: string; title: string; perex: string; readTime: string; date: string; img: string;
}

const SLUG_IMG: Record<string, string> = {
  'povinne-tlacitko-shopify': '/blog-01.webp',
  'ai-seo-2026': '/blog-02.webp',
  'shopify-editions-zima-2026': '/blog-03.webp',
  'preklad-platebni-metody-shopify': '/blog-04.webp',
  'shopify-vs-shoptet': '/blog-05.webp',
};

const STATIC_ALL: PostSummary[] = [
  { slug: 'povinne-tlacitko-shopify', title: 'Povinné tlačítko v Shopify: nečekejte, až z toho bude problém', perex: 'Jak správně nastavit povinné tlačítko v Shopify.', readTime: '7 min', date: '2026-05-01', img: '/blog-01.webp' },
  { slug: 'ai-seo-2026', title: 'AI SEO — nová tvrdá realita vyhledávání pro e-shopy (2026)', perex: 'Jak umělá inteligence mění SEO a co to znamená pro váš e-shop.', readTime: '7 min', date: '2026-01-15', img: '/blog-02.webp' },
  { slug: 'shopify-editions-zima-2026', title: 'Shopify Editions — Zima 2026', perex: 'Přehled nejdůležitějších novinek ze Shopify Editions Winter 2026.', readTime: '5 min', date: '2025-12-10', img: '/blog-03.webp' },
  { slug: 'preklad-platebni-metody-shopify', title: 'Překlad platební metody v Shopify, když Translate & Adapt nepomáhá', perex: 'Praktický návod jak přeložit platební metody v Shopify mimo standardní nástroje.', readTime: '3 min', date: '2025-10-05', img: '/blog-04.webp' },
  { slug: 'shopify-vs-shoptet', title: 'Jakou e-commerce platformu zvolit? Shopify versus Shoptet', perex: 'Detailní srovnání Shopify a Shoptetu pro český trh.', readTime: '18 min', date: '2025-06-01', img: '/blog-05.webp' },
];

export async function getStaticPaths() {
  try {
    const storyblok = useStoryblokApi();
    const { data } = await storyblok.get('cdn/stories', {
      version: 'published',
      starts_with: 'blog/',
      content_type: 'blog_post',
      per_page: 100,
      sort_by: 'first_published_at:desc',
    });
    if (data.stories.length > 0) {
      const allPosts: PostSummary[] = data.stories.map((s: any) => ({
        slug: s.slug,
        title: s.content.title,
        perex: s.content.perex || '',
        readTime: s.content.read_time || '5 min',
        date: s.first_published_at?.split('T')[0] || s.created_at.split('T')[0],
        img: s.content.featured_image?.filename || SLUG_IMG[s.slug] || '/blog-01.webp',
      }));
      return data.stories.map((story: any) => ({
        params: { slug: story.slug },
        props: {
          title: story.content.title,
          readTime: story.content.read_time || '5 min',
          date: story.first_published_at?.split('T')[0] || story.created_at.split('T')[0],
          perex: story.content.perex || '',
          content: story.content.content,
          featuredImage: story.content.featured_image?.filename || null,
          isStoryblok: true,
          allPosts,
        },
      }));
    }
  } catch (_e) {}

  return STATIC_ALL.map(post => ({
    params: { slug: post.slug },
    props: {
      title: post.title, readTime: post.readTime, date: post.date,
      perex: post.perex, content: null, featuredImage: post.img,
      isStoryblok: false, allPosts: STATIC_ALL,
    },
  }));
}

const { title, readTime, date, perex, content, featuredImage, isStoryblok, allPosts } = Astro.props;
const { slug } = Astro.params;
const renderedContent = isStoryblok && content ? renderRichText(content) : null;
const formatDate = (d: string) => new Date(d).toLocaleDateString('cs-CZ', { day: 'numeric', month: 'long', year: 'numeric' });
const dateFormatted = formatDate(date);
const otherPosts = ((allPosts || []) as PostSummary[]).filter(p => p.slug !== slug).slice(0, 3);
const extras = articleExtras[slug as string] || {};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": perex,
  "datePublished": date,
  "inLanguage": "cs-CZ",
  "image": featuredImage || undefined,
  "publisher": {
    "@type": "Organization",
    "name": "AETHERO s.r.o.",
    "url": "https://aethero.agency"
  },
  "author": {
    "@type": "Organization",
    "name": "AETHERO s.r.o."
  }
};
---

<PageLayout {title} description={perex} lang="cs" jsonLd={articleSchema}>

  <section class="blog-hero">
    {featuredImage && (
      <div class="hero-img-wrap">
        <img src={featuredImage} alt={title} width="1200" height="630" loading="eager" />
        <div class="hero-meta-bar">
          <div class="container">
            <div class="blog-meta">
              <span>{dateFormatted}</span>
              <span class="dot" aria-hidden="true">·</span>
              <span>{readTime} čtení</span>
            </div>
          </div>
        </div>
      </div>
    )}
    {!featuredImage && (
      <div class="container blog-hero-inner--no-img">
        <div class="blog-meta">
          <span>{dateFormatted}</span>
          <span class="dot" aria-hidden="true">·</span>
          <span>{readTime} čtení</span>
        </div>
      </div>
    )}
    <div class="container blog-hero-inner">
      <h1>{title}</h1>
      <p class="blog-perex">{perex}</p>
    </div>
  </section>

  {extras.cta && (
    <section class="article-cta">
      <div class="container article-cta-inner">
        {extras.cta.title && <h2 class="h2-mini article-cta-title">{extras.cta.title}</h2>}
        {extras.cta.note && <p class="article-cta-note">{extras.cta.note}</p>}
        <a href={extras.cta.href} class="article-cta-btn">
          {extras.cta.label}
          <span aria-hidden="true">➔</span>
        </a>
      </div>
    </section>
  )}

  <article class="section bg-primary">
    <div class="container article-inner">
      {renderedContent ? (
        <div class="article-body sb-content" set:html={renderedContent} />
      ) : (
        <div class="article-body">
          <p class="coming-soon">Obsah článku bude brzy doplněn.</p>
        </div>
      )}
    </div>
  </article>

  {extras.faq && extras.faq.length > 0 && (
    <ArticleFaq title={extras.faqTitle} items={extras.faq} />
  )}

  <section class="cta-section">
    <div class="container cta-inner">
      <h2>Máme spolu co probrat?<br />Dejte vědět:</h2>
      <div class="cta-contacts">
        <a href="mailto:info@aethero.cz" class="cta-contact">info@aethero.cz</a>
        <a href="tel:+420776067663" class="cta-contact">+420 776 067 663</a>
      </div>
    </div>
  </section>

  {otherPosts.length > 0 && (
    <section class="more-articles">
      <div class="container">
        <h2 class="h3-maxi more-heading">Další články</h2>
        <div class="more-grid">
          {otherPosts.map(post => (
            <a href={`/cs/blog/${post.slug}`} class="more-card">
              <div class="more-card-img">
                <img src={post.img} alt={post.title} loading="lazy" width="600" height="340" />
              </div>
              <div class="more-card-body">
                <span class="more-date">{formatDate(post.date)}</span>
                <h3 class="h3-mini more-title">{post.title}</h3>
                <span class="more-cta">Číst článek →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

</PageLayout>

<style>
  /* ── Velké CTA hned pod perexem ── */
  .article-cta {
    background: var(--ae-bg-primary);
    padding: var(--space-40) 0 0;
  }
  .article-cta-inner {
    max-width: 760px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /* struktura dle B-07 CTA Banner: nadpis → doprovodný text → jedna akce */
    gap: 0;
    padding: var(--space-40) var(--space-40) calc(var(--space-40) + 4px);
    border-radius: var(--radius-md);
    /* Výsek z obrázku hlaviček služeb (jeho pravá, čistě fialová část —
       modrý roh vlevo nahoře se nepoužívá) + fialový přechod přes něj,
       aby text držel kontrast. Bez tyrkysové, ta zůstává jen tlačítku. */
    background-image:
      linear-gradient(100deg, rgba(12, 4, 44, 0.78) 0%, rgba(58, 18, 122, 0.55) 100%),
      url('/ae-bgr-w-glass-b-2x-v3.webp');
    background-size: cover;
    background-position: 78% 45%;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
  }
  .article-cta-title {
    margin: 0 0 12px;
    max-width: 20ch;
  }
  .article-cta-note {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
  }
  .article-cta-btn {
    /* větší vzduch kolem tlačítka — ať akce nesplývá s textem */
    margin-top: var(--space-32);
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 18px 32px;
    border-radius: var(--radius-md);
    background: var(--action);
    color: #00121a;
    font-size: 20px;
    font-weight: 700;
    text-decoration: none;
    line-height: 1.2;
  }
  .article-cta-btn:hover {
    filter: brightness(1.08);
  }
  .article-cta-btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  @media (max-width: 640px) {
    .article-cta-inner {
      padding: var(--space-32) var(--space-24);
      /* .container má na mobilu vlastní boční padding, ale ten výše
         přepisujeme — box by pak dosedl na okraje displeje. */
      margin-left: 16px;
      margin-right: 16px;
    }
    .article-cta-title {
      max-width: none;
    }
    .article-cta-btn {
      font-size: 17px;
      padding: 16px 24px;
      width: 100%;
      justify-content: center;
      margin-top: var(--space-24);
    }
  }

  .blog-hero {
    background: var(--ae-bg-primary);
  }

  .hero-img-wrap {
    width: 100%;
    height: 600px;
    overflow: hidden;
    position: relative;
  }
  .hero-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .hero-meta-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-16) 0;
    background: linear-gradient(to bottom, transparent, rgba(8,8,16,0.72));
  }

  .blog-hero-inner--no-img {
    max-width: 760px;
    padding-top: var(--space-48);
  }
  .blog-hero-inner {
    max-width: 760px;
    /* jen horní padding — `padding: X 0 0` by přepsalo boční odsazení
       .containeru a nadpis by na mobilu dosedl na okraj displeje */
    padding-top: var(--space-32);
  }
  article.section { padding-top: var(--space-40); }
  .blog-meta {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    font-size: 14px;
    color: var(--neutral-500);
    margin-bottom: var(--space-24);
  }
  .dot { opacity: 0.4; }
  .blog-hero h1 {
    font-size: var(--fs-72);
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: var(--space-24);
  }
  .blog-perex {
    font-size: var(--fs-24);
    color: var(--neutral-300);
    line-height: 1.6;
  }

  .article-inner { max-width: 760px; }
  .article-body { font-size: 18px; color: var(--neutral-300); line-height: 1.7; }

  .article-body.sb-content :global(h2) { font-size: var(--fs-36); font-weight: 700; margin: 2em 0 0.75em; color: var(--text-primary); }
  .article-body.sb-content :global(h3) { font-size: var(--fs-28); font-weight: 600; margin: 1.75em 0 0.6em; color: var(--text-primary); }
  .article-body.sb-content :global(p) { margin-bottom: 1.4em; }
  .article-body.sb-content :global(ul), .article-body.sb-content :global(ol) { padding-left: 1.5em; margin-bottom: 1.4em; }
  .article-body.sb-content :global(li) { margin-bottom: 0.4em; line-height: 1.7; }
  .article-body.sb-content :global(a) { color: var(--action); text-decoration: underline; text-underline-offset: 3px; }
  .article-body.sb-content :global(strong) { font-weight: 700; color: var(--text-primary); }
  .article-body.sb-content :global(em) { font-style: italic; }
  .article-body.sb-content :global(blockquote) { border-left: 3px solid var(--action); padding-left: 1.5em; margin: 1.5em 0; font-style: italic; color: var(--neutral-400); }
  .article-body.sb-content :global(code) { background: rgba(255,255,255,0.07); padding: 2px 6px; border-radius: 4px; font-size: 0.9em; font-family: monospace; }
  .article-body.sb-content :global(pre) { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 8px; padding: 1.5em; overflow-x: auto; margin-bottom: 1.4em; }
  .article-body.sb-content :global(img) { border-radius: var(--radius-sm); max-width: 100%; margin: 1.5em 0; }
  .article-body.sb-content :global(hr) { border: none; border-top: 1px solid rgba(255,255,255,0.08); margin: 2.5em 0; }

  .coming-soon { color: var(--neutral-500); font-style: italic; }

  .more-articles {
    background: var(--ae-bg-deep);
    padding: var(--space-80) 0 var(--space-120);
  }
  .more-heading { margin-bottom: var(--space-40); }
  .more-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-32);
  }
  .more-card {
    display: flex;
    flex-direction: column;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: var(--radius-md);
    overflow: hidden;
    text-decoration: none;
    transition: border-color var(--transition-base), transform var(--transition-base);
  }
  .more-card:hover { border-color: rgba(255,255,255,0.14); transform: translateY(-2px); }
  .more-card-img {
    aspect-ratio: 16/9;
    overflow: hidden;
    background: rgba(255,255,255,0.04);
  }
  .more-card-img img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
    transition: transform 0.4s ease;
  }
  .more-card:hover .more-card-img img { transform: scale(1.03); }
  .more-card-body {
    padding: var(--space-24);
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .more-date {
    font-size: 13px;
    color: var(--neutral-500);
    margin-bottom: var(--space-12);
    display: block;
  }
  .more-title {
    color: var(--action);
    margin-bottom: var(--space-16);
    flex: 1;
  }
  .more-card:hover .more-title {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .more-cta {
    font-size: var(--text-body);
    font-weight: 600;
    color: var(--action);
    align-self: flex-end;
  }

  @media (max-width: 1024px) {
    .more-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .blog-hero { padding: 120px 0 60px; }
    .blog-hero h1 { font-size: var(--fs-48); }
    .blog-perex { font-size: 20px; }
    .more-grid { grid-template-columns: 1fr; gap: var(--space-24); }
  }
  @media (max-width: 480px) {
    .blog-hero { padding: 90px 0 48px; }
    .blog-hero h1 { font-size: var(--fs-36); }
  }
</style>
