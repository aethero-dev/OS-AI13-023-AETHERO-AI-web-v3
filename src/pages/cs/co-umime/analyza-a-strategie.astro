---
import PageLayout from '../../../layouts/PageLayout.astro';
import ServiceHero from '../../../components/layout/ServiceHero.astro';
import WorkSidebar from '../../../components/layout/WorkSidebar.astro';

const processItems = [
  { icon: '<path d="M9 17H7A5 5 0 0 1 7 7h2"/><path d="M15 7h2a5 5 0 1 1 0 10h-2"/><line x1="8" x2="16" y1="12" y2="12"/>', title: 'Napojení dat', desc: 'Pošlete nám exporty nebo API přístup. Bez přístupu pomůžeme - data vytáhneme sami, diskrétně.' },
  { icon: '<line x1="12" x2="12" y1="20" y2="10"/><line x1="18" x2="18" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="16"/>', title: 'Analýza', desc: 'Projdeme data do hloubky: objednávky, kampaně, zákazníci. Typicky 1–3 dny podle rozsahu.' },
  { icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>', title: 'Živá spolupráce', desc: 'Výsledky procházíme s vámi v reálném čase. Strategie šitá na míru - žádné šablony.' },
  { icon: '<path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/>', title: 'Strategický dokument + plán', desc: 'Online dokument s analýzou a klikacím 365denním plánem, kdykoli přístupný.' },
];

const analyzeItemsSidebar = [
  { icon: '<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>', title: 'E-mail marketing', desc: 'Leadhub, Klaviyo, Mailchimp, Ecomail. Kampaně, automations, segmenty, open rate, CTR, revenue na email.' },
  { icon: '<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>', title: 'E-shopová platforma', desc: 'Shoptet, Shopify, WooCommerce - objednávky, zákazníci, produkty, sezónnost, retence, AOV.' },
  { icon: '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>', title: 'Google Analytics / GA4', desc: 'Zdroje návštěvnosti, konverzní cesty, atribuční model, výkon kanálů, chování uživatelů.' },
  { icon: '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>', title: 'Google Ads', desc: 'Výkon kampaní, ROAS, search terms, ztracená imprese, příležitosti pro škálování nebo úsporu.' },
  { icon: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>', title: 'Meta Ads', desc: 'Facebook & Instagram - dosah, frekvence, CPM, ROAS, audience overlap, funnel analýza.' },
  { icon: '<circle cx="12" cy="12" r="10"/><line x1="2" x2="22" y1="12" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>', title: 'Crawling webu', desc: 'Data nejsou v exportu? Projdeme e-shop automaticky - produktový katalog, ceny, kategorie, UX vzory.' },
];

const deliverables = [
  '<strong class="hl">Přehled klíčových metrik</strong> - dvouletý horizont, meziroční srovnání, identifikace trendů',
  '<strong class="hl">Příčiny poklesu nebo růstu</strong> - konkrétní měsíce, konkrétní kanály, konkrétní dopady v Kč',
  '<strong class="hl">Analýza top kampaní a automations</strong> - co funguje, co nefunguje a proč',
  '<strong class="hl">Cross-sell mapa</strong> - nejčastější produktové kombinace z reálných objednávek zákazníků',
  '<strong class="hl">Segmentační doporučení</strong> - RFM analýza, Klub vs. zákazníci, win-back příležitosti',
  '<strong class="hl">Konkrétní marketingová doporučení</strong> - nad rámec emailu: SEO, Pinterest, NPS, atribuční model',
  '<strong class="hl">365denní akční plán</strong> - 40+ konkrétních úkolů, každý s prioritou a odhadovaným přínosem',
];

const forWho = [
  'Váš e-shop generuje data, ale nemáte kapacitu nebo know-how je správně přečíst',
  'Tušíte, že e-maily, reklamy nebo flows fungují lépe - ale nevíte jak to udělat',
  'Potřebujete konkrétní akční plán s jasnou prioritizací, ne obecná doporučení',
  'Rozhodujete se, kam investovat marketingový rozpočet v příštím roce',
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Analýza a strategie",
  "serviceType": "Analýza a strategie e-commerce",
  "description": "Přestaňte hádat - zjistěte proč váš e-shop neroste. Propojíme vaše data a dodáme strategii, která rovnou funguje.",
  "provider": { "@type": "Organization", "name": "AETHERO s.r.o.", "url": "https://aethero.cz" },
  "areaServed": ["CZ", "SK", "PL", "AT", "DE"],
  "url": "https://aethero.cz/co-umime/analyza-a-strategie/"
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "aethero", "item": "https://aethero.cz/" },
    { "@type": "ListItem", "position": 2, "name": "Co umíme", "item": "https://aethero.cz/co-umime/" },
    { "@type": "ListItem", "position": 3, "name": "Analýza a strategie" }
  ]
};
---

<PageLayout title="Analýza a strategie" description="Přestaňte hádat - zjistěte proč váš e-shop neroste. Propojíme vaše data a dodáme strategii, která rovnou funguje." lang="cs" jsonLd={[serviceSchema, breadcrumbSchema]}>
  <ServiceHero
    label="Analýza a strategie"
    title="ANALÝZA <br /><span style='color:#fff'>A STRATEGIE</span>"
    subtitle="Víte, proč váš e-shop roste? A proč někdy neroste? Propojíme vaše data, zapojíme AI + kontext - a výsledky jsou opravdu působivé."
    ctaLabel="Zavolejme si"
    ctaHref="tel:+420776067663"
    cta2Label="Zjistěte jak"
    cta2Href="#jak-to-funguje"
    image="/aethero-gradient-222.png"
    imageAlt="Analýza a strategie pro e-shop"
  />

  <!-- Přestaňte hádat + JAK TO FUNGUJE sidebar -->
  <section class="section bg-primary">
    <div class="container intro-layout">
      <div class="intro-main">
        <h2 class="h1 intro-h2">Přestaňte hádat, <br /><span class="accent-purple">ZJISTĚTE PROČ</span></h2>
        <p class="intro-text">Váš e-shop vám totiž něco říká. <strong class="hl">Posloucháte ho?</strong> Každý e-shop má v sobě a v datech schovaný příběh - kde vydělává, kde krvácí, proč někteří zákazníci zůstávají a jiní zmizí po prvním nákupu. <strong class="hl">Ta data už dávno máte, jen je nikdo nečte.</strong> A měl by.</p>
        <p class="intro-text">Chce to zkušenost a trochu technického voo-doo, ale pak se s vašimi daty, plány a ochočenou AI posadíme, propojíme je s čím je potřeba: Google Ads, Analytics, Metou i s mailovým klientem a <strong class="hl">vrátíme vám strategii, která má čísla u každého doporučení</strong>: kolik to vydělá, kolik ušetří, kdy to zapnout.</p>
        <a href="#cta" class="btn-action btn-action--lg">Chcete analýzu? Zavolejte</a>
      </div>
      <WorkSidebar heading="CO ANALYZUJEME" items={analyzeItemsSidebar} />
    </div>
  </section>

  <!-- Jak to funguje -->
  <section class="section bg-primary" id="jak-to-funguje">
    <div class="container">
      <div class="jak-grid">
        <WorkSidebar heading="JAK TO FUNGUJE" items={processItems} />
        <div>
          <h2 class="h2 section-title">Od dat ke strategii <br />za 1–2 týdny</h2>
          <p class="section-text body">Pošlete nám přístupy nebo exporty - zbytek je na nás. Projdeme data do hloubky, posadíme se s vámi v reálném čase a vrátíme vám živý strategický dokument s klikacím 365denním plánem a číslem u každého doporučení.</p>
          <p class="section-text body"><strong>Žádné šablony. Žádné obecné rady. Strategie šitá přímo na váš e-shop.</strong></p>
          <a href="#cta" class="btn-action btn-action--lg">Chci analýzu - zavolám</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Vaše data říkají víc + Pro koho -->
  <section class="section bg-primary">
    <div class="container">
      <div class="data-forwho-grid">
        <div>
          <h2 class="h2 section-title">Vaše data říkají víc, <br />než si myslíte</h2>
          <p class="section-text body">API přístup, CSV exporty nebo crawling webu - dokážeme napojit téměř jakýkoliv zdroj dat. Propojíme data z vašeho e-shopu, emailové kampaně, GAds, Analytiku i sociální sítě. A vy pak dostanete konkrétní strategii s kvantifikovaným přínosem každého doporučení - žádné obecné rady.</p>
          <p class="section-text body">Nejčastěji pracujeme s e-shopy od 3M Kč ročního obratu na Shoptetu, Shopify a WooCommerce.</p>
        </div>
        <div>
          <h2 class="h3 section-title">Služba je pro vás, <span class="text-action">pokud...</span></h2>
          <ul class="arrow-list">
            {forWho.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section bg-primary">
    <div class="container">
      <h2 class="h2 testimonials-label">Reference majitelů e-shopů</h2>
      <div class="testimonials-grid">
        <div class="testimonial-card">
          <p class="testimonial-text">„Výstup byl kvalitně zpracovaný, přehledný a hlavně plný konkrétních podnětů, které můžeme rovnou využít pro další růst našeho e-shopu. Žádná obecná doporučení, ale řešení šitá nám na míru."</p>
          <div class="google-review">
            <svg class="google-g-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-label="Google">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            <div class="google-stars">★★★★★</div>
          </div>
          <div class="testimonial-footer">
            <img src="/ref-lucie.jpg" alt="Lucie" class="testimonial-avatar" />
            <div class="testimonial-person">
              <span>Lucie, majitelka</span>
              <a href="https://www.fleppi.cz" target="_blank" rel="noopener noreferrer" class="text-link">Fleppi.cz</a>
            </div>
            <a href="https://www.fleppi.cz" target="_blank" rel="noopener noreferrer" class="testimonial-logo-link">
              <img src="/ref-fleppi-logo.png" alt="fleppi" class="testimonial-logo" />
            </a>
          </div>
        </div>
        <div class="testimonial-card">
          <p class="testimonial-text">„Jsem z toho nadšený, protože poprvé mám ucelený obraz o všem, co se v e-shopu děje, na jednom místě. Ta největší pecka je v tom, jak se ty data mezi sebou propojují. Vidím jestli je ten obsah na webu skutečně zaujal a k tomu si přihodím info z mailingu - na co nám lidi nejlépe reagují v e-mailech. Právě tyhle přesahy, kdy vidím celou cestu zákazníka od vyhledávání až po nákup, mi dovolují dělat v Shopify úpravy, které mají hlavu a patu."</p>
          <div class="testimonial-footer">
            <img src="/ref-petr.png" alt="Petr" class="testimonial-avatar" />
            <div class="testimonial-person">
              <span>Petr, majitel</span>
              <a href="https://bu1.cz" target="_blank" rel="noopener noreferrer" class="text-link">BU1.cz</a>
            </div>
            <a href="https://bu1.cz" target="_blank" rel="noopener noreferrer" class="testimonial-logo-link">
              <img src="/ref-bu1-logo.svg" alt="BU1" class="testimonial-logo" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Výstup / Case study -->
  <section class="section bg-primary">
    <div class="container">
      <h2 class="h2-mini section-title-center">Dostanete výstup, <br /><span class="text-action">který rovnou použijete.</span></h2>
      <div class="output-col">
        <div>
          <p class="section-text body">Žádné tabulky v Excelu, které si nikdo neotevře. Výsledkem je <strong class="hl">živý strategický dokument dostupný online</strong> - přehledný, konkrétní, s klikacím akčním plánem.</p>
          <ul class="arrow-list" style="margin-bottom: var(--space-32)">
            {deliverables.map((d) => (
              <li><span set:html={d}></span></li>
            ))}
          </ul>
        </div>
        <div class="case-study-wrap">
          <div class="case-study-card">
            <img src="/fleppi-study-v2.webp" alt="Mailingová strategie pro fleppi.cz" class="case-study-img" loading="lazy" />
            <a href="/pripadova-studie-email-marketing-fleppi-cz/" class="ref-card-cta">Přečtěte si <br/>případovou studii</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section" id="cta">
    <div class="container cta-inner">
      <h2>Chci díky analýze zjistit <br />kde nám to skřípe - volám, píši!</h2>
      <div class="cta-contacts">
        <a href="mailto:info@aethero.cz" class="cta-contact">info@aethero.cz</a>
        <a href="tel:+420776067663" class="cta-contact">+420 776 067 663</a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  /* Intro + sidebar = 2 sloupce */
  .intro-layout { display: grid; grid-template-columns: 1fr 420px; gap: var(--space-64); align-items: start; }
  @media (max-width: 900px) { .intro-layout { grid-template-columns: 1fr; gap: var(--space-40); } }
  /* .hl (bold lavender) - globální utilita v global.css */
  .jak-grid { display: grid; grid-template-columns: 420px 1fr; gap: var(--space-80); align-items: start; }
  @media (max-width: 900px) { .jak-grid { grid-template-columns: 1fr; } }

  .data-forwho-grid { display: grid; grid-template-columns: 2fr 1fr; gap: var(--space-80); align-items: start; }
  @media (max-width: 900px) { .data-forwho-grid { grid-template-columns: 1fr; } }

  .section-mid { padding: var(--space-80) 0; }
  .section-title-center { margin-bottom: var(--space-40); text-align: center; }
  .section-text-center { text-align: center; max-width: 600px; margin: 0 auto; }

  .output-col { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-80); align-items: start; }

  .case-study-wrap { display: flex; }
  .case-study-card { position: relative; border-radius: var(--radius-md); overflow: hidden; }
  .case-study-img { display: block; width: 100%; height: auto; }

  .case-tag { font-size: 14px; font-weight: 700; letter-spacing: 0; color: rgba(255,255,255,0.55); text-transform: uppercase; }

  .testimonials-label { margin-bottom: var(--space-40); text-align: center; }
  .testimonials-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: stretch; }
  .testimonial-card {
    background: var(--card-button);
    border-radius: var(--radius-md);
    padding: 48px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .testimonial-header { display: flex; align-items: center; gap: 20px; }
  .testimonial-avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    object-position: top center;
    flex-shrink: 0;
    border: 3px solid rgba(255,255,255,0.15);
  }
  .testimonial-person { min-width: 0; flex: 1; }
  .testimonial-person span { display: block; font-size: 16px; color: rgba(255,255,255,0.85); font-weight: 600; }
  .testimonial-person .text-link { display: block; font-size: 16px; margin-top: 4px; }
  .person-name-row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .testimonial-text {
    font-size: 18px;
    color: rgba(255,255,255,0.85);
    line-height: 1.75;
    font-style: italic;
    font-family: var(--font-secondary);
    margin: 0;
    flex: 1;
  }
  .testimonial-footer { display: flex; align-items: center; gap: 20px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,0.08); }
  .google-g-icon { width: 20px; height: 20px; display: block; }
  .google-stars { color: #FABB05; font-size: 16px; letter-spacing: 1px; line-height: 1; }
  .google-review { display: flex; flex-direction: row; align-items: center; gap: 6px; flex-shrink: 0; margin-top: 16px; }
  .testimonial-logo-link { display: inline-flex; flex-shrink: 0; margin-left: auto; }
  .testimonial-logo { height: 48px; width: auto; max-width: 140px; object-fit: contain; flex-shrink: 0; }
  .testimonial-logo--light { background: rgba(255,255,255,0.95); border-radius: 8px; width: auto; height: 56px; padding: 8px 12px; object-fit: contain; object-position: center; }


  @media (max-width: 1024px) {
    .output-col { grid-template-columns: 1fr; }
    .case-study-wrap { display: none; }
    .testimonials-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 768px) {
  }
</style>
