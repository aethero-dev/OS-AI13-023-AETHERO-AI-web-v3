---
import PageLayout from '../../../layouts/PageLayout.astro';
import ArticleFaq from '../../../components/ArticleFaq.astro';
import ServiceHero from '../../../components/layout/ServiceHero.astro';
import WorkSidebar from '../../../components/layout/WorkSidebar.astro';

// Čtyři kroky, jak u nás začíná spolupráce na podpoře. Nahradily zástupné
// „Doplnit / Obsah doplníme", které stálo na ostrém webu (DK 2026-08-04).
const startSteps = [
  { icon: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>', title: 'Napište, co vás pálí', desc: 'Stačí pár vět nebo odkaz na e-shop. Nepotřebujeme zadání na tři strany - potřebujeme vědět, co vás brzdí.' },
  { icon: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>', title: 'Podíváme se pod kapotu', desc: 'Projdeme šablonu, aplikace a napojené systémy. Řekneme, co je příčina a co jen příznak - i když to znamená, že problém není tam, kde jste čekali.' },
  { icon: '<path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z"/>', title: 'Dostanete varianty', desc: 'Co se dá vyřešit hned, co si zaslouží projekt a čemu se vyplatí se vyhnout. Vždycky s odhadem času a ceny.' },
  { icon: '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>', title: 'Jedeme dál', desc: 'Jednorázová oprava, nebo dlouhodobá podpora - obojí je v pořádku. Nikoho neuvazujeme na smlouvu, kterou by nechtěl.' },
];

// FAQ postavené na tom, co se lidi o agenturní podpoře Shopify opravdu ptají
// (rešerše 2026-08-04: xgentech, Shopify Partners blog, retainer stránky
// agentur). Vybráno sedm otázek, které dávají smysl pro český trh a na které
// umíme odpovědět konkrétně - ne obecná omáčka.
//
// Psáno pro AI SEO podle vlastního článku: odpověď hned v prvních větách,
// konkrétní čísla, žádné marketingové výplně. Komponenta ArticleFaq k tomu
// přidá FAQPage schema, takže se otázky mohou zobrazit přímo ve vyhledávání
// i v AI odpovědích.
const faq = [
  {
    q: 'Musím mít smlouvu na dlouhodobou podporu, nebo stačí jednorázová oprava?',
    a: [
      'Stačí jednorázová oprava. Spousta spoluprací u nás začíná jedním problémem, který nikdo jiný nevyřešil, a pak už pokračuje sama.',
      'Dlouhodobá podpora dává smysl, když se úpravy opakují, e-shop roste, nebo potřebujete mít jistotu, že o víkendu někdo zvedne telefon. Nikoho do ní netlačíme.',
    ],
  },
  {
    q: 'Kolik podpora stojí?',
    a: [
      'Záleží na tom, jestli jde o jednu úpravu, nebo o průběžnou péči. Drobnost může být na pár hodin, custom aplikace je projekt.',
      'Po krátkém ujasnění zadání dostanete varianty s odhadem času a ceny - a doporučení, co má nejlepší poměr cena/výkon. Bez toho by každé číslo bylo vymyšlené.',
    ],
  },
  {
    q: 'Převezmete e-shop, který stavěl někdo jiný?',
    a: [
      'Ano, a děláme to často. Začneme tím, že projdeme šablonu, aplikace a napojené systémy a řekneme vám, v jakém stavu to je.',
      'Nepřepisujeme cizí práci ze zásady. Pokud něco funguje, necháme to být; měníme to, co brzdí nebo hrozí, že se rozbije.',
    ],
  },
  {
    q: 'Jak rychle reagujete, když se něco rozbije?',
    a: [
      'U výpadku prodeje jdeme na to okamžitě - to je jediná věc, která má u e-shopu absolutní přednost.',
      'U běžných úprav se domlouváme na termínu předem, ať víte, s čím počítat. Nesnažíme se tvářit, že všechno je hotové do hodiny.',
    ],
  },
  {
    q: 'Co když má můj problém řešení jen přes aplikaci z App Store?',
    a: [
      'Pak vám ji doporučíme. Nemáme důvod stavět na míru něco, co za pár set korun měsíčně umí hotová appka od někoho, kdo ji vyvíjí naplno.',
      'Custom vývoj dává smysl tam, kde appka neexistuje, kde by jich bylo potřeba pět najednou, nebo kde by měsíční poplatky za dva roky přerostly cenu vlastního řešení.',
    ],
  },
  {
    q: 'Umíte pomoct s výkonem a Core Web Vitals?',
    a: [
      'Ano. Řešíme rychlost šablony, zátěž od aplikací i stabilitu při špičkách v prodeji.',
      'Většina pomalých Shopify e-shopů je pomalá kvůli nakupeným aplikacím a skriptům třetích stran, ne kvůli Shopify samotnému. Začínáme tím, že změříme, co který skript stojí.',
    ],
  },
  {
    q: 'Poradíte si s mezinárodním prodejem přes Shopify Markets?',
    a: [
      'Ano. Nastavíme trhy, měny, jazyky, domény, daňová pravidla, dopravu i lokální platby tak, aby to fungovalo bez duplikace e-shopu.',
      'Nejčastější chyba je rozjet druhý samostatný e-shop pro zahraničí. Skoro vždycky se to vrátí jako dvojnásobná práce s produkty i obsahem.',
    ],
  },
];

const features = [
  { title: 'Technický support & troubleshooting', desc: 'Řešíme komplexní technické problémy v Liquid šablonách, custom aplikacích, Shopify Functions, checkoutu i napojených službách. Identifikujeme příčiny chyb, ne jen jejich symptomy.', img: '/support.jpg', reverse: false },
  { title: 'Rozšiřování funkcionalit & custom vývoj', desc: 'Vyvíjíme custom úpravy na míru – pokročilá práce s produkty, cenotvorbou, checkoutem, logikou dopravy a plateb, včetně vlastních aplikací.', img: '/custom.webp', reverse: true },
  { title: 'Integrace & systémová architektura', desc: 'Navrhujeme a realizujeme robustní integrace na ERP, CRM, skladové a logistické systémy. Automatizujeme datové toky a nastavujeme škálovatelnou architekturu bez vendor locku.', img: '/system1.webp', reverse: false },
  { title: 'Nastavení Shopify Markets pro mezinárodní expanzi', desc: 'Technické nastavení více trhů, měn, jazyků, domén, daňových pravidel, dopravy a lokálních plateb. Připravíme e-shop na provoz napříč zemí bez duplikace řešení.', img: '/shopify-international.webp', reverse: true },
  { title: 'Výkon, stabilita & škálování', desc: 'Výkon šablon, zátěž aplikací, Core Web Vitals a celkovou stabilitu e-shopu udržíme ve stavu, aby zvládal vysokou návštěvnost i špičky v prodeji.', img: '/vykon.webp', reverse: false },
  { title: 'Design & UX podpora s technickým přesahem', desc: 'Pomůžeme s úpravami designu, UX optimalizací a implementací design systému přímo v Shopify – od práce s existující šablonou až po custom řešení, to vše v souladu s brandem i technickými best practices.', img: '/ux-we-do.webp', reverse: true },
  { title: 'Technické konzultace i dlouhodobý support', desc: 'Jsme váš technický partner pro kontinuální rozvoj – od auditů a code review až po strategická rozhodnutí o dalším směřování Shopify řešení.', img: '/longtime-support.jpg', reverse: false },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Rozvoj a podpora",
  "serviceType": "Podpora a rozvoj Shopify e-shopu",
  "description": "Dlouhodobý technický partner pro váš Shopify projekt. Jsme tu pro support, rozvoj, integrace i strategii.",
  "provider": { "@type": "Organization", "name": "AETHERO s.r.o.", "url": "https://aethero.cz" },
  "areaServed": ["CZ", "SK", "PL", "AT", "DE"],
  "url": "https://aethero.cz/co-umime/rozvoj-a-podpora/"
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "aethero", "item": "https://aethero.cz/" },
    { "@type": "ListItem", "position": 2, "name": "Co umíme", "item": "https://aethero.cz/co-umime/" },
    { "@type": "ListItem", "position": 3, "name": "Rozvoj a podpora" }
  ]
};
---

<PageLayout title="Rozvoj a podpora" description="Dlouhodobý technický partner pro váš Shopify projekt. Jsme tu pro support, rozvoj, integrace i strategii." lang="cs" jsonLd={[serviceSchema, breadcrumbSchema]}>
  <ServiceHero
    label="Rozvoj a podpora"
    title="ROZVOJ <br /><span style='color:#fff'>A PODPORA</span>"
    subtitle="Shopify projekt? Jsme připraveni, kde je třeba pomoci? Chybí vám lidé, čas, znalosti? Napište, zavolejte."
    ctaLabel="Zavolejme si"
    ctaHref="tel:+420776067663"
    cta2Label="Zjistěte jak"
    cta2Href="#co-udelame"
    image="/lifebuoy.webp"
    imageAlt="Rozvoj a podpora Shopify"
  />

  <!-- Intro + panel JAK ZAČNEME -->
  <section class="section bg-primary">
    <div class="container intro-layout">
      <div class="intro-main">
        <h2 class="h1 intro-h2"><span class="accent-purple">S ČÍM CHCETE POMOCI</span> <br />na Shopify projektu?</h2>
        <p class="intro-text"><strong class="hl">Někdy hledání videí k&nbsp;řešení problému prostě nestačí</strong> a&nbsp;je potřeba hlubší technický vhled, zkušenost z&nbsp;více reálných projektů a&nbsp;tím možnost najít širší souvislosti.</p>
        <p class="intro-text">Chceme, abyste věděli, že ani po pár letech <strong class="hl">nemáme nos nahoru a&nbsp;když to půjde, pomůžeme vám</strong>.</p>
        <p class="intro-text">Rozvoj a&nbsp;podpora Shopify projektů nekončí spuštěním e-shopu. Víme, že ne každý problém má řešení v&nbsp;tutoriálu nebo videu - často je potřeba hlubší technický vhled, zkušenost z&nbsp;reálných projektů a&nbsp;schopnost vidět souvislosti.</p>
        <p class="intro-text">Jsme tu jako partner pro další rozvoj vašeho Shopify řešení, ať už jde o&nbsp;optimalizace výkonu, nové funkce, integrace nebo strategická rozhodnutí. I&nbsp;po letech práce se Shopify přistupujeme ke&nbsp;každému projektu s&nbsp;pokorou a&nbsp;otevřeností - pokud to půjde, pomůžeme vám najít funkční a&nbsp;udržitelné řešení.</p>
        <a href="#cta" class="btn-action btn-action--lg">Tak pojďme na to</a>
      </div>
      <WorkSidebar heading="JAK ZAČNEME" items={startSteps} />
    </div>
  </section>

  <!-- Co pro vás uděláme -->
  <section class="section bg-primary">
    <div class="container">
      <h2 class="h2-mini section-title" id="co-udelame">Co pro vás můžeme v rámci <br />naší technické podpory udělat</h2>
    </div>
  </section>

  <!-- Feature sections -->
  {features.map((f) => (
    <section class={`feature-section${f.reverse ? ' feature-section--reverse' : ''}`}>
      <div class="container feature-inner">
        <div class="feature-text">
          <h3 class="h3 feature-title">{f.title}</h3>
          <p class="body">{f.desc}</p>
        </div>
        <div class="feature-img-wrap">
          <img src={f.img} alt={f.title} class="feature-img" loading="lazy" />
        </div>
      </div>
    </section>
  ))}

  <ArticleFaq title="Časté otázky k podpoře a rozvoji Shopify" items={faq} />

  <!-- CTA -->
  <section class="cta-section" id="cta">
    <div class="container cta-inner">
      <h2>Pomůžeme? Dejte vědět</h2>
      <div class="cta-contacts">
        <a href="mailto:info@aethero.cz" class="cta-contact">info@aethero.cz</a>
        <a href="tel:+420776067663" class="cta-contact">+420 776 067 663</a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  /* Intro + panel = 2 sloupce. Panel měl do 2026-08-04 zástupný obsah
     („Obsah doplníme" 4×); teď nese skutečné kroky. */
  .intro-layout { display: grid; grid-template-columns: 1fr 355px; gap: var(--space-64); align-items: start; }
  @media (max-width: 900px) { .intro-layout { grid-template-columns: 1fr; gap: var(--space-40); } }
  /* .hl (bold lavender) - globální utilita v global.css */
  .section-title { text-align: center; }

  .feature-section--reverse .feature-inner { direction: rtl; }
  .feature-section--reverse .feature-text,
  .feature-section--reverse .feature-img-wrap { direction: ltr; }
  .feature-title { margin-bottom: var(--space-24); color: #fff; }
  .feature-img-wrap { display: flex; align-items: center; justify-content: center; }


  @media (max-width: 1024px) {
    .feature-inner { grid-template-columns: 1fr; }
    .feature-section--reverse .feature-inner { direction: ltr; }
    .feature-img-wrap { display: none; }
  }
</style>
