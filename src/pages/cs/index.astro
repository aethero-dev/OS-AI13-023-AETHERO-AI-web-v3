---

<PageLayout
  title="Jsme Shopify specialisté"
  description="Česká Shopify agentura. Design, strategie a technologie pro váš e-commerce úspěch."
  lang="cs"
>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="container hero-inner">
      <div class="hero-left">
        <div class="hero-heading">
          <!-- H1 typewriter - 3 řádky, stabilní výška (sizer + per-line placeholder), 30s pauza -->
          <div class="sp-h1-typer"
               style="--speed:85; --back:65; --pause:900; --between:350; --restart:30000;
                      --l1-sizer:'Jsme'; --l2-sizer:'Shopify'; --l3-sizer:'specialisté';">
            <style>
              .sp-h1-typer .l1,
              .sp-h1-typer .l2,
              .sp-h1-typer .l3,
              .sp-h1-typer .sizer{ padding-right: 1ch; box-sizing: border-box; }
              .sp-h1-typer{ padding:1rem 0; color:inherit; font-family:inherit; }
              .sp-h1-typer .title{ margin:0; line-height:1.15; font-size:inherit; color:inherit; }
              .sp-h1-typer .row{ display:grid; white-space:normal; word-break:break-word; width:100%; }
              .sp-h1-typer .row > .sizer,
              .sp-h1-typer .row > .live{ grid-area:1/1; }
              .sp-h1-typer .sizer{ visibility:hidden; white-space:normal; word-break:break-word; }
              .sp-h1-typer .live{ display:grid; grid-template-rows:auto auto auto; align-content:start; }
              .sp-h1-typer .l1, .sp-h1-typer .l2, .sp-h1-typer .l3{ display:block; }
              .sp-h1-typer .l1[data-empty="1"]::after{ content: var(--l1-sizer,'Jsme'); visibility:hidden; display:block; }
              .sp-h1-typer .l2[data-empty="1"]::after{ content: var(--l2-sizer,'Shopify'); visibility:hidden; display:block; }
              .sp-h1-typer .l3[data-empty="1"]::after{ content: var(--l3-sizer,'specialisté'); visibility:hidden; display:block; }
              .sp-h1-typer .caret{ display:inline-block; width:.6ch; margin-left:.1ch; border-right:2px solid currentColor; vertical-align:baseline; animation: spCaret 1s steps(1,end) infinite; }
              @keyframes spCaret{ 0%,40%,100%{opacity:1} 50%,90%{opacity:0} }
              @media (prefers-reduced-motion: reduce){ .sp-h1-typer .caret{ animation:none; opacity:1; } }
            </style>
            <h1 class="title" aria-live="polite">
              <span class="row">
                <span class="sizer">Jsme <br>Shopify <br>specialisté</span>
                <span class="live">
                  <span class="l1">Jsme</span>
                  <span class="l2">æthero</span>
                  <span class="l3" data-empty="1"></span>
                  <span class="caret" aria-hidden="true"></span>
                </span>
              </span>
            </h1>
            <script>
              (function(){
                var script = document.currentScript;
                var root = (script && script.closest('.sp-h1-typer')) || document.querySelector('.sp-h1-typer');
                if(!root || root.dataset.init) return; root.dataset.init = '1';
                var cs = getComputedStyle(root);
                function numVar(n,fb){ var v=(cs.getPropertyValue(n)||'').trim(); return v?parseFloat(v):fb; }
                var SPEED=numVar('--speed',85), BACK=numVar('--back',65), PAUSE=numVar('--pause',900), BETWEEN=numVar('--between',350), RESTART=numVar('--restart',30000);
                if(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches){ SPEED=BACK=PAUSE=BETWEEN=0; }
                var l1=root.querySelector('.l1'), l2=root.querySelector('.l2'), l3=root.querySelector('.l3'), caret=root.querySelector('.caret');
                function sleep(ms){ return new Promise(r=>setTimeout(r,ms)); }
                function setEmpty(el,isEmpty){ if(isEmpty) el.setAttribute('data-empty','1'); else el.removeAttribute('data-empty'); }
                function moveCaret(el){ if(!el||!caret) return; if(caret.parentNode!==el) el.appendChild(caret); }
                async function typeInto(el,text){ moveCaret(el); setEmpty(el,false); for(var i=1;i<=text.length;i++){ el.textContent=text.slice(0,i); if(SPEED) await sleep(SPEED); } }
                async function typeAppend(el,text){ moveCaret(el); setEmpty(el,false); var base=el.textContent; for(var i=1;i<=text.length;i++){ el.textContent=base+text.slice(0,i); if(SPEED) await sleep(SPEED); } }
                async function eraseAppend(el,text){ moveCaret(el); for(var i=0;i<text.length;i++){ el.textContent=el.textContent.slice(0,-1); if(BACK) await sleep(BACK); } }
                async function eraseAll(el){ moveCaret(el); while(el.textContent.length){ el.textContent=el.textContent.slice(0,-1); if(BACK) await sleep(BACK); } setEmpty(el,true); }
                function clearLines(){ l1.textContent=''; l2.textContent=''; l3.textContent=''; setEmpty(l1,true); setEmpty(l2,true); setEmpty(l3,true); }
                async function runOnce(prvni){
                  if(!prvni){
                    clearLines();
                    await typeInto(l1,'Jsme'); if(PAUSE) await sleep(PAUSE);
                    await typeInto(l2,'æthero');
                  }
                  if(PAUSE) await sleep(PAUSE);
                  await eraseAll(l2); if(BETWEEN) await sleep(BETWEEN);
                  await typeInto(l2,'Shopify'); if(BETWEEN) await sleep(BETWEEN);
                  await Promise.all([typeAppend(l2,' Plus'), typeInto(l3,'partneři')]); if(PAUSE) await sleep(PAUSE);
                  await Promise.all([eraseAppend(l2,' Plus'), eraseAll(l3)]); if(BETWEEN) await sleep(BETWEEN);
                  var words=['experti','vývojáři','designéři','analytici','specialisté'];
                  for(var i=0;i<words.length;i++){ await typeInto(l3,words[i]); if(PAUSE) await sleep(PAUSE); await eraseAll(l3); if(BETWEEN) await sleep(BETWEEN); }
                  await Promise.all([typeAppend(l2,' Plus'), typeInto(l3,'partneři')]); if(PAUSE) await sleep(PAUSE);
                }
                (async function loop(){ var prvni=true; while(true){ await runOnce(prvni); prvni=false; if(RESTART>0) await sleep(RESTART); } })();
              })();
            </script>
          </div>
        </div>
        <a href="#sluzby" class="btn-hero">Do čeho se spolu pustíme?</a>
      </div>
      <div class="hero-right" aria-hidden="true">
        <img src="/hero-glass.webp" alt="" width="704" height="630" class="hero-shape" loading="eager" />
      </div>
    </div>
  </section>

  <!-- SERVICE SELECTOR CAROUSEL -->
  <section class="services-section" id="sluzby">
    <div class="svc-wide">
    <div class="services-track-wrap" id="services-track-wrap">
      <div class="services-track" id="services-track">
        {services.map((s, i) => (
          <a href={s.href} class="service-item">
            <div class="service-content">
              <span class="service-num">{s.num}</span>
              <p class="service-text" set:html={s.pre}></p>
              <h2 class="h2-mini service-title" set:html={s.title}></h2>
            </div>
          </a>
        ))}
      </div>
    </div>
    </div>
    <button class="svc-nav svc-nav--prev" id="svc-prev" type="button" aria-label="Předchozí">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button class="svc-nav svc-nav--next" id="svc-next" type="button" aria-label="Další">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  </section>

  <!-- VALUE PROP -->
  <section class="value-prop">
    <div class="container value-inner">
      <h2 class="value-heading">
        <span class="val-shopify">Shopify</span> dodá technologii, <span class="val-aethero">aethero</span> strategii.
      </h2>
      <p class="value-body">
        Od výběru projektu přes design a vývoj až po první objednávku - a dál.
        Staráme se o celý životní cyklus vašeho e-shopu tak,
        <span class="value-purple">aby technologie nikdy nebyla překážka, ale nástroj růstu.</span>
      </p>
      <img src="/shopify-white.png" alt="Shopify" class="shopify-icon" loading="lazy" />
    </div>
  </section>

  <!-- FEATURES 4-COL -->
  <section class="features">
    <div class="container">
      <div class="features-grid">
        {features.map((col) => (
          <div class="feature-col">
            <h3 class="h3-mini feature-col-title">{col.title}</h3>
            <ul class="feature-list">
              {col.items.map((item) => (
                <li class="feature-item">
                  <img src={item.icon} alt="" width="36" height="36" loading="lazy" class="feature-icon" />
                  <div>
                    <strong class="feature-label">{item.label}</strong>
                    <span class="feature-desc">{item.desc}</span>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- STATS BAR -->
  <section class="stats-bar">
    <div class="stats-inner">
      <div class="stat">
        <span class="stat-num">4,8 mil</span>
        <span class="stat-label">e-shopů fungujících ve světě</span>
      </div>
      <div class="stat">
        <span class="stat-num">175 zemí</span>
        <span class="stat-label">kde můžete prodávat</span>
      </div>
      <div class="stat">
        <span class="stat-num">3 500 vývojářů</span>
        <span class="stat-label">z celkových cca 8 000 zaměstnanců</span>
      </div>
      <img src="/icons/shopify-monotone-white.svg" alt="Shopify" class="shopify-stats-logo" loading="lazy" />
    </div>
  </section>

  <!-- AE SERVICES SECTION -->
  <section class="ae-services">
    <div class="container">
      <div class="ae-services-header">
        <img src="/ae-znak.svg" alt="aethero" class="ae-znak" width="120" height="120" loading="lazy" />
        <p class="ae-services-title">KOMPLEXNÍ POMOC PŘI TVORBĚ, SPRÁVĚ A ROZVOJI SHOPIFY E-SHOPU</p>
      </div>
      <div class="ae-services-grid">
        {allServices.map((s) => (
          <div class="ae-service-item">
            <img src={s.icon} alt="" width="36" height="36" loading="lazy" class="ae-service-icon" />
            <div>
              <strong class="ae-service-label">{s.label}</strong>
              <span class="ae-service-desc">{s.desc}</span>
            </div>
          </div>
        ))}
      </div>
      <div class="ae-services-ctas">
        <a href="/kontakt/" class="btn-action btn-action--lg">Chci konzultaci</a>
        <a href="/co-umime/" class="btn-action btn-action--lg btn-action--ghost">Více o tom jak pracujeme</a>
      </div>
    </div>
  </section>

  <!-- REFERENCES -->
  <section class="references">
    <div class="container">
      <h2 class="h2-maxi section-heading">Reference</h2>
      <div class="ref-grid">
        <div class="ref-card">
          <h3 class="h3-mini ref-title"><a href="https://bu1.cz" target="_blank" rel="noopener noreferrer">BU1.cz, BU1sport.com</a></h3>
          <p class="ref-desc body">Pro značku <a href="https://bu1.cz" target="_blank" rel="noopener noreferrer" class="text-link">BU1.cz</a> jsme vytvořili mezinárodní moderní Shopify obchod s novým designem a důrazem na uživatelský zážitek. Řešení podporuje vícejazyčný prodej a je připravené na rychlý růst.</p>
          <div class="ref-img-wrap">
            <img src="/ref-bu1.webp" alt="BU1 – Brankářské rukavice a oblečení" width="800" height="450" loading="lazy" class="ref-img" />
            <div class="ref-img-overlay">
              <span class="ref-img-label">Brankářské rukavice <br />a oblečení</span>
            </div>
          </div>
          <a href="https://bu1.cz" target="_blank" rel="noopener noreferrer" class="btn-action btn-action--lg ref-cta">Přejít na BU1</a>
        </div>
        <div class="ref-card">
          <h3 class="h3-mini ref-title"><a href="/groomo-cz-na-shopify/">GROOMO.cz</a></h3>
          <p class="ref-desc body">GROOMO vzniklo jako kompletní projekt v naší produkci - od tvorby značky až po vývoj Shopify e-shopu. Celý ekosystém značky stojí na touze i schopnosti pomoci, lásce ke psům a profesionalitě.</p>
          <div class="ref-img-wrap">
            <img src="/ref-groomo.webp" alt="GROOMO – Pro groomery, profi páníčky a paničky" width="800" height="450" loading="lazy" class="ref-img" />
            <div class="ref-img-overlay">
              <span class="ref-img-label">Pro groomery, <br />profi páníčky a paničky</span>
            </div>
          </div>
          <a href="/groomo-cz-na-shopify/" class="btn-action btn-action--lg ref-cta">Případová studie GROOMO.cz</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ZKUŠENOSTI -->
