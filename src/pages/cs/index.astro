<script>
  const track = document.getElementById('services-track') as HTMLElement | null;
  const wrap = document.getElementById('services-track-wrap') as HTMLElement | null;

  if (track && wrap) {
    const INTERVAL = 5000;
    // Reset slideru na první kartu - volá se z hero tlačítka (kotva #sluzby),
    // aby návštěvník po skoku nepřistál uprostřed rozjeté smyčky.
    let resetToFirst: (() => void) | null = null;

    if (window.innerWidth <= 640) {
      // MOBIL: natívny CSS scroll-snap - prehliadač rieši momentum sám
      let autoTimer = setInterval(autoAdvance, INTERVAL);

      function autoAdvance() {
        const item = track!.children[0] as HTMLElement | null;
        if (!item) return;
        const itemW = item.offsetWidth;
        const max = wrap!.scrollWidth - wrap!.clientWidth;
        const next = wrap!.scrollLeft + itemW;
        wrap!.scrollTo({ left: next > max ? 0 : next, behavior: 'smooth' });
      }

      wrap.addEventListener('touchstart', () => clearInterval(autoTimer), { passive: true });
      wrap.addEventListener('touchend', () => { autoTimer = setInterval(autoAdvance, INTERVAL); }, { passive: true });

      resetToFirst = () => {
        clearInterval(autoTimer);
        wrap!.scrollTo({ left: 0, behavior: 'smooth' });
        autoTimer = setInterval(autoAdvance, INTERVAL);
      };

    } else {
      // DESKTOP: clone-based infinite loop + pointer drag
      const DUR = 900;
      const EASE = `transform ${DUR}ms cubic-bezier(0.4, 0, 0.2, 1)`;

      const originals = Array.from(track.children) as HTMLElement[];
      const N = originals.length;
      // Klony jsou jen vizuální výplň nekonečné smyčky — čtečkám a tabu se schovávají,
      // jinak slyší 7 nadpisů služeb 3× (nález GPT crosscheck, změřeno 26 H2 v DOMu).
      const klon = (el: HTMLElement) => { const c = el.cloneNode(true) as HTMLElement; c.setAttribute('aria-hidden', 'true'); c.setAttribute('tabindex', '-1'); return c; };
      [...originals].reverse().forEach(el => track.insertBefore(klon(el), track.firstChild));
      originals.forEach(el => track.appendChild(klon(el)));

      const itemW = () => (track.children[N] as HTMLElement).offsetWidth;
      let pos = N * itemW();
      track.style.transition = 'none';
      track.style.transform = `translateX(-${pos}px)`;
      track.offsetWidth;
      track.style.transition = EASE;

      const moveTo = (p: number, animated: boolean) => {
        pos = p;
        if (!animated) {
          track.style.transition = 'none';
          track.style.transform = `translateX(-${p}px)`;
          track.offsetWidth;
          track.style.transition = EASE;
        } else {
          track.style.transform = `translateX(-${p}px)`;
        }
      };

      const normalize = () => {
        const w = itemW();
        if (pos >= 2 * N * w) moveTo(pos - N * w, false);
        else if (pos < N * w) moveTo(pos + N * w, false);
      };

      const advance = () => { moveTo(pos + itemW(), true); setTimeout(normalize, DUR + 50); };
      let timer = setInterval(advance, INTERVAL);

      let dragStartX = 0, dragStartY = 0, dragStartPos = 0;
      let dragging = false, dragMoved = false, dragLocked = false;

      track.addEventListener('pointerdown', (e: PointerEvent) => {
        dragging = true; dragMoved = false; dragLocked = false;
        dragStartX = e.clientX; dragStartY = e.clientY; dragStartPos = pos;
        clearInterval(timer);
      });

      track.addEventListener('pointermove', (e: PointerEvent) => {
        if (!dragging) return;
        const dx = Math.abs(e.clientX - dragStartX);
        const dy = Math.abs(e.clientY - dragStartY);
        if (!dragLocked) {
          if (dx < 6 && dy < 6) return;
          if (dy > dx) { dragging = false; timer = setInterval(advance, INTERVAL); return; }
          dragLocked = true;
          track.style.transition = 'none';
          track.setPointerCapture(e.pointerId);
          track.classList.add('is-dragging');
        }
        const delta = dragStartX - e.clientX;
        if (Math.abs(delta) > 5) dragMoved = true;
        pos = dragStartPos + delta;
        track.style.transform = `translateX(-${pos}px)`;
      });

      const finishDrag = () => {
        if (!dragging) return;
        dragging = false;
        if (!dragLocked) { timer = setInterval(advance, INTERVAL); return; }
        track.classList.remove('is-dragging');
        const w = itemW();
        pos = Math.round(pos / w) * w;
        track.style.transition = EASE;
        track.style.transform = `translateX(-${pos}px)`;
        setTimeout(() => { normalize(); timer = setInterval(advance, INTERVAL); }, DUR + 50);
      };

      track.addEventListener('pointerup', finishDrag);
      track.addEventListener('pointercancel', finishDrag);
      track.addEventListener('click', (e: MouseEvent) => { if (dragMoved) e.preventDefault(); }, true);

      // Ruční navigace na obě strany (šipky)
      const stepBy = (dir: number) => {
        clearInterval(timer);
        moveTo(pos + dir * itemW(), true);
        setTimeout(() => { normalize(); timer = setInterval(advance, INTERVAL); }, DUR + 50);
      };
      document.getElementById('svc-prev')?.addEventListener('click', () => stepBy(-1));
      document.getElementById('svc-next')?.addEventListener('click', () => stepBy(1));

      resetToFirst = () => {
        clearInterval(timer);
        moveTo(N * itemW(), true);
        setTimeout(() => { normalize(); timer = setInterval(advance, INTERVAL); }, DUR + 50);
      };
    }

    document.querySelectorAll('a[href="#sluzby"]').forEach((a) => {
      a.addEventListener('click', () => { if (resetToFirst) resetToFirst(); });
    });
  }
</script>

