      <div class="zk-logos">
        <img src="/icons/genkia-logo.svg" alt="Genkia" class="zk-logo-img" loading="lazy" />
        <img src="/icons/bu1-logo.svg" alt="BU1" class="zk-logo-img" loading="lazy" />
