---
import PageLayout from '../../layouts/PageLayout.astro';

// Obsah 1:1 podle ostrého aethero.cz/o-nas (pokyn DK 2026-08-05) — osobní
// bios se při dřívějším přepisu ztratily a byly to nejoriginálnější texty
// na stránce. Fotky staženy z .cz (duotone + blob zapečený v PNG);
// DK je později vymění.
const team = [
  {
    name: 'David',
    role: 'Design, Business Development',
    photo: '/team-david.png',
    desc: 'David dělá pro aethero hlavně design a business development. Takže když k nám budete volat, dovoláte se právě jemu.',
    email: 'david@aethero.cz',
    phone: '+420 776 067 663',
  },
  {
    name: 'Bára',
    role: 'Kódování, UX/UI, Projekt management',
    photo: '/team-bara.png',
    desc: '„Aby vše dávalo smysl", to asi nejlíp vystihuje, co Bára dělá. Je totiž jedna z těch mála neustále se pohybujících bytostí, které umí ovládat čas a prostor. Jak jinak by zvládla všechnu tu práci a rodinu s neustálým úsměvem, si jinak neumíme vysvětlit!',
    email: 'bara@aethero.cz',
  },
  {
    name: 'Tom',
    role: 'Design',
    photo: '/team-tom.png',
    desc: 'Má pod palcem grafiku, video, 3D, motion design a všechno to „zpěkňování" produktů, které děláme pro klienty. Tom je na Cestě, učí jógu, streamuje o zdravém bytí, chová včely a je pohodář.',
  },
];

// Externí tým — texty u jmen jsou zatím Lorem ipsum (vědomě, pokyn DK
// 2026-08-05; web není spuštěný). DK je nahradí skutečnými větami.
const spoluprace: { jmeno: string; obor: string; poznamka?: string }[] = [
  { jmeno: 'Petr', photo: '/team-placeholder.svg', obor: 'AI evangelist, procesní řízení, analytika', poznamka: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt.' },
  { jmeno: 'Dominik', photo: '/team-placeholder.svg', obor: 'SEO specialista', poznamka: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt.' },
  { jmeno: 'Daniel', photo: '/team-placeholder.svg', obor: 'Právní služby', poznamka: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt.' },
  { jmeno: 'Honza', photo: '/team-placeholder.svg', obor: 'Design', poznamka: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt.' },
];

// Tech partneři — blok je PŘIPRAVENÝ, ale zobrazí se až od 4 položek
// (pokyn DK 2026-08-05: „až budou 4, nastal čas"). Logo je nepovinné —
// bez něj se vykreslí jen název. Kandidáti k doplnění: Packeta/Zásilkovna,
// Comgate, Make, Gorgias, Judge.me (viz answers/78).
const techPartneri: { nazev: string; logo?: string; url?: string }[] = [
  { nazev: 'Klaviyo', url: 'https://www.klaviyo.com' },
  { nazev: 'Ecomail', url: 'https://ecomail.cz' },
];

// Čemu věříme — manifest místo frází (formát 37signals, obsah aethero;
// zadání DK 2026-08-05 „zkus to napsat")
const principy = [
  { titulek: 'Senior od začátku do konce', text: 'Váš projekt nikdy nedostane junior na zaučení. Kdo s vámi mluví na první schůzce, ten váš e-shop opravdu staví.' },
  { titulek: 'Specializace vyhrává', text: 'Děláme Shopify — a proto o něm víme víc než generalisté. Jedna platforma dělaná pořádně je víc než pět platforem napůl.' },
  { titulek: 'AI je náš nástroj, ne náhrada řemesla', text: 'Automatizujeme všechno, co stroj umí líp, aby na design, strategii a obsah zbylo víc hlavy. Rozhoduje vždycky člověk.' },
  { titulek: 'Spuštění je začátek, ne konec', text: 'E-shop se nespouští, e-shop se provozuje: měření, iterace, podpora, růst. Proto s námi klienti zůstávají roky.' },
  { titulek: 'Žádná překvapení', text: 'Víte, co se dělá, proč se to dělá a kolik to stojí — průběžně, ne až na faktuře.' },
];

// Děláme / Neděláme — kultura humorem (formát Humaan)
const delame = [
  'Shopify od brandu po custom aplikace',
  'Pořádné řemeslo: typografie, rychlost, přístupnost',
  'vlastní appky v Shopify App Store — testujeme na sobě',
  'dlouhodobé vztahy — spuštěním to u nás začíná',
  'med — Tom fakt chová včely',
];
const nedelame = [
  'projekty, kterým sami nevěříme',
  'weby za víkend a „nějak to dopadne"',
  'přeprodávání anonymních juniorů',
  'WordPress (promiňte)',
  'víkendové deadliny — o víkendu jsme s rodinami',
];

const certifikace = [
  { img: '/badge-selling.png', alt: 'Shopify — Selling Fundamentals, ověřená dovednost' },
  { img: '/badge-development.png', alt: 'Shopify — Development Fundamentals, ověřená dovednost' },
  { img: '/badge-solution.png', alt: 'Shopify — Solution Planning Fundamentals, ověřená dovednost' },
];
---

<PageLayout title="O nás" description="Potkali jsme se na pár projektech a po chvíli bylo jasné, že má smysl dát dohromady něco oficiálnějšího. Společně máme pár desítek let zkušeností v oboru." lang="cs" skryjLogo>

  <section class="o-nas-hero">
    <div class="hero-blob" aria-hidden="true"></div>
    <div class="container">
      <img src="/ae-logo.svg" alt="æthero" class="hero-logo" width="1120" height="280" loading="eager" />
      <h1>O nás</h1>
      <div class="hero-manifest">
        <p>Jsme malý, vysoce specializovaný tým z Čech. Děláme <strong class="hl">Shopify a AI</strong>. Jsme <strong class="hl">Shopify Plus Partner</strong> a jsme na to hrdí.</p>
        <p>A ještě něco: i když riskujeme, že vás zklameme, musíte to vědět… ne, nejsme velká firma. Nejsme agentura s desítkami zaměstnanců, open spacem a account manažerem, který vám přeposílá maily od týmu. Pokud hledáte tohle, musíte jinam.</p>
        <p>Zakládáme si totiž na tom, že jsme <strong class="hl">skalpel a ne parní válec</strong>. Vždy víc <strong class="hl">fištrónu než síly</strong>. Když za námi přijdete a víte, co chcete, dodáme to rychle a čistě. Když nevíte, pomůžeme vám to zjistit a postavit.</p>
        <p>Naše motto je: <strong class="hl">Dělat e-commerce jednodušší.</strong></p>
      </div>
    </div>
  </section>

  <section class="section bg-primary team-sekce">
    <div class="container">
      <h2 class="h2 section-title">Tým</h2>
      <div class="team-grid">
        {team.map((member) => (
          <div class="team-card">
            <img src={member.photo} alt={`${member.name} — ${member.role}`} class="team-photo" width="700" height="700" loading="lazy" />
            <h3 class="h3-mini team-name">{member.name}</h3>
            <p class="team-role">{member.role}</p>
            <p class="team-desc">{member.desc}</p>
            <div class="team-contacts">
              {member.phone && <a href={`tel:${member.phone.replace(/\s/g, '')}`} class="contact-pill">{member.phone}</a>}
              {member.email && <a href={`mailto:${member.email}`} class="contact-pill">{member.email}</a>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Externí tým — navazuje na Tým jako jeden blok (DK 2026-08-05) -->
  <section class="section bg-primary externi-sekce">
    <div class="container spoluprace-inner">
      {spoluprace.length > 0 && (
        <div class="spoluprace-grid">
          {spoluprace.map((s) => (
            <div class="spoluprace-card">
              <img src={s.photo} alt={`${s.jmeno} — ${s.obor}`} class="team-photo" width="700" height="700" loading="lazy" />
              <h3 class="h3-mini spoluprace-jmeno">{s.jmeno}</h3>
              <p class="spoluprace-obor">{s.obor}</p>
              {s.poznamka && <p class="spoluprace-poznamka">{s.poznamka}</p>}
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- Čemu věříme + Děláme/Neděláme (formáty 37signals + Humaan, DK 2026-08-05) -->
  <section class="section bg-primary">
    <div class="container">
      <h2 class="h2 section-title">Čemu věříme</h2>
      <div class="principy">
        {principy.map((p, i) => (
          <div class="princip">
            <span class="princip-num">0{i + 1}</span>
            <div>
              <h3 class="h3-mini princip-titulek">{p.titulek}</h3>
              <p class="princip-text">{p.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-primary delame-sekce">
    <div class="container">
      <div class="delame-grid">
        <div>
          <h2 class="h2 section-title">Co děláme,</h2>
          <ul class="delame-list delame-list--ano">
            {delame.map((d) => <li>{d}</li>)}
          </ul>
        </div>
        <div>
          <h2 class="h2 section-title">a co neděláme</h2>
          <ul class="delame-list delame-list--ne">
            {nedelame.map((n) => <li>{n}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {techPartneri.length >= 4 && (
    <section class="section bg-primary">
      <div class="container spoluprace-inner">
          <h2 class="h2 section-title">Tech partneři</h2>
        <div class="partneri-lista">
          {techPartneri.map((t) => (
            <a href={t.url} class="partner-cell" target="_blank" rel="noopener noreferrer">
              {t.logo
                ? <img src={t.logo} alt={t.nazev} class="partner-logo" loading="lazy" />
                : <span class="partner-nazev">{t.nazev}</span>}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Certifikace — vědomě až na konci, nenápadně (pokyn DK: badge nejsou důležité) -->
  <section class="certifikace">
    <div class="container certifikace-inner">
      <p class="certifikace-label">Certifikace Shopify</p>
      <div class="certifikace-badges">
        {certifikace.map((c) => (
          <img src={c.img} alt={c.alt} class="certifikace-badge" loading="lazy" />
        ))}
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container cta-inner">
      <h2>Zavolejte, napište! <br />Nekoušeme.</h2>
      <div class="cta-contacts">
        <a href="mailto:info@aethero.cz" class="cta-link">info@aethero.cz</a>
        <a href="tel:+420776067663" class="cta-link">+420 776 067 663</a>
      </div>
    </div>
  </section>

</PageLayout>

<style>
  .o-nas-hero {
    position: relative; padding: 130px 0 80px;
    background: var(--ae-bg-primary-alt); overflow: hidden;
  }
  .hero-blob {
    position: absolute; top: -20%; right: -5%; width: 500px; height: 500px;
    background: radial-gradient(ellipse, rgba(203,0,215,0.15) 0%, transparent 70%);
    border-radius: 50%; filter: blur(60px); pointer-events: none;
  }
  .o-nas-hero .container { position: relative; }
  /* Velké logo místo toho v menu — jako na .cz (DK 2026-08-05) */
  .hero-logo { width: 64%; height: auto; display: block; margin: var(--space-48) 0 var(--space-120); }
  .o-nas-hero h1 { font-size: var(--fs-64); font-weight: 700; margin-left: 12.5%; }
  .hero-manifest { margin-top: var(--space-24); margin-left: 12.5%; max-width: 600px; display: flex; flex-direction: column; gap: var(--space-16); }
  .hero-manifest p { font-size: 20px; color: #fff; line-height: 1.65; }

  /* Stejná mřížka jako Externí tým — všichni mají stejně velkou kartu
     (pokyn DK 2026-08-05); u jádra zbývá čtvrté pole volné. */
  .team-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-16); }
  .team-card {
    background: var(--ae-bg-primary);
    border-radius: var(--radius-md); padding: var(--space-24);
    display: flex; flex-direction: column; gap: 10px;
  }
  /* Duotone + blob jsou zapečené přímo v PNG z .cz — fotka se jen položí */
  .team-photo { width: min(150px, 70%); height: auto; align-self: flex-start; }
  .team-name { }
  .team-role { font-size: var(--text-small); color: rgba(255,255,255,0.6); font-weight: 500; }
  .team-desc { font-size: var(--text-small); color: var(--neutral-300); line-height: 1.6; flex: 1; }
  .team-contacts { display: flex; flex-direction: column; gap: 6px; margin-top: auto; }
  .contact-pill { font-size: 14px; color: var(--neutral-500); transition: color var(--transition-base); }
  .contact-pill:hover { color: var(--action); }

  /* S kým spolupracujeme */
  .spoluprace-inner { }
  .spoluprace-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-16); }
  .spoluprace-card {
    background: var(--ae-bg-primary);
    border-radius: var(--radius-md); padding: var(--space-24);
    display: flex; flex-direction: column; gap: 10px;
  }
  .spoluprace-card .team-photo { margin-bottom: 0; }
  .spoluprace-jmeno { margin-bottom: 4px; }
  .spoluprace-obor { font-size: var(--text-small); color: rgba(255,255,255,0.6); font-weight: 500; margin-bottom: 8px; }
  .spoluprace-poznamka { font-size: var(--text-small); color: var(--neutral-300); line-height: 1.6; }

  /* Externí tým lepí na Tým — jeden souvislý blok lidí, bez vlastního
     nadpisu (DK 2026-08-05); mezera mezi mřížkami = gap mřížky */
  .team-sekce { padding-bottom: var(--space-16); }
  .externi-sekce { padding-top: 0; }

  /* Tech partneři — lišta ve stylu Swanky (mřížka buněk s logy) */
  .partneri-lista {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px;
    background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--radius-md); overflow: hidden; margin-top: var(--space-40);
  }
  .partner-cell {
    background: var(--ae-bg-primary); min-height: 120px;
    display: flex; align-items: center; justify-content: center;
    padding: var(--space-24); text-decoration: none;
    transition: background var(--transition-base);
  }
  .partner-cell:hover { background: rgba(255,255,255,0.04); }
  .partner-logo { max-height: 40px; max-width: 70%; width: auto; }
  .partner-nazev { font-family: var(--font-primary); font-size: 20px; font-weight: 700; color: var(--neutral-300); }

  /* Čemu věříme — číslované principy (gradientová čísla jako na Co umíme) */
  .principy { display: flex; flex-direction: column; gap: var(--space-40); max-width: 760px; margin-top: var(--space-40); }
  .princip { display: grid; grid-template-columns: 88px 1fr; gap: var(--space-24); align-items: start; }
  .princip-num {
    font-family: var(--font-primary); font-size: var(--fs-56); font-weight: 700; line-height: 1;
    background: linear-gradient(135deg, var(--accent-purple), var(--action));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .princip-titulek { margin-bottom: 8px; }
  .princip-text { font-size: 17px; color: var(--neutral-300); line-height: 1.65; max-width: 560px; }

  /* Děláme / Neděláme */
  .delame-sekce { padding-top: 0; }
  .delame-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-64); }
  .delame-list { list-style: none; padding: 0; margin: var(--space-32) 0 0; display: flex; flex-direction: column; gap: var(--space-16); }
  .delame-list li { position: relative; padding-left: 34px; font-size: 17px; color: var(--neutral-300); line-height: 1.55; }
  .delame-list li::before { position: absolute; left: 0; top: 0; font-weight: 700; }
  .delame-list--ano li::before { content: '✓'; color: var(--action); }
  .delame-list--ne li::before { content: '✕'; color: var(--semantic-error); }

  /* Certifikace — nenápadný pás na konci */
  .certifikace { background: var(--ae-bg-primary); padding: var(--space-40) 0 var(--space-80); }
  .certifikace-inner { display: flex; align-items: center; gap: var(--space-40); flex-wrap: wrap; }
  .certifikace-label {
    font-family: var(--font-primary); font-size: 13px; font-weight: 600;
    letter-spacing: 0.09em; text-transform: uppercase; color: var(--neutral-500);
  }
  .certifikace-badges { display: flex; gap: var(--space-32); align-items: center; flex-wrap: wrap; }
  .certifikace-badge { height: 220px; width: auto; }

  .cta-link { font-size: var(--fs-40); color: var(--ae-straight-blue); font-family: var(--font-primary); font-weight: 700; text-decoration: none; transition: opacity var(--transition-base); }
  .cta-link:hover { text-decoration: underline; text-underline-offset: 4px; }

  @media (max-width: 1100px) {
    .team-grid { grid-template-columns: repeat(2, 1fr); }
    .spoluprace-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .team-grid { grid-template-columns: 1fr; }
    .spoluprace-grid { grid-template-columns: 1fr; }
    .partneri-lista { grid-template-columns: repeat(2, 1fr); }
    .delame-grid { grid-template-columns: 1fr; gap: var(--space-40); }
    .princip { grid-template-columns: 64px 1fr; }
    .princip-num { font-size: var(--fs-40); }
    .cta-contacts { flex-direction: column; align-items: center; gap: var(--space-16); }
    .o-nas-hero { padding: 90px 0 60px; }
    .hero-manifest { margin-left: 0; }
    .o-nas-hero h1 { margin-left: 0; }
    .hero-manifest p { font-size: 18px; }
    .certifikace-badge { height: 150px; }
  }
  @media (max-width: 480px) {
    .o-nas-hero { padding: 70px 0 48px; }
    .o-nas-hero h1 { font-size: var(--fs-48); }
    .hero-manifest p { font-size: 16px; }
    .section { padding: var(--space-80) 0; }
  }
</style>
