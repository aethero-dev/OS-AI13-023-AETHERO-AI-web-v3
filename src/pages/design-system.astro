---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleFaq from '../components/ArticleFaq.astro';

// Ukázka pro blok 10g — živá komponenta, ne obrázek. Ať je v DS vidět
// skutečná věc, včetně rozbalování (DK 2026-08-04).
const faqUkazka = [
  { q: 'Kolik to stojí?', a: ['To záleží. Jedna drobná úprava může být rychlovka, aplikace je už ale projekt.'] },
  { q: 'Děláte i „jen“ konzultaci?', a: ['Ano. Někdy stačí 60–90 minut a máme všichni jasno, co stavět a čemu se vyhnout.'] },
  { q: 'Umíte napojit i něco, co „nemá integraci“?', a: ['Pokud má služba API nebo aspoň rozumný export a import, většinou se cesta najde.'] },
];
---

<BaseLayout title="Design System — aethero web v3.1" lang="cs">
  <div class="ds-page">

    <!-- NAV -->
    <nav class="ds-nav">
      <a href="/" class="ds-nav-logo">← web</a>
      <div class="ds-nav-links">
        <a href="#web-v31">web-v3.1</a>
        <a href="#viewports">Viewport</a>
        <a href="#colors">Barvy</a>
        <a href="#rules">Pravidla</a>
        <a href="#typography">Typografie</a>
        <a href="#spacing">Spacing</a>
        <a href="#components">Tlačítka</a>
        <a href="#pills">Pills</a>
        <a href="#blocks">Bloky</a>
        <a href="#cards">Karty</a>
        <a href="#gallery">Galerie</a>
      </div>
    </nav>

    <!-- HEADER -->
    <header class="ds-header">
      <div class="ds-header-inner">
        <div>
          <p class="ds-label">Design System</p>
          <h1 class="ds-title">aethero web</h1>
          <p class="ds-version" id="web-v31">v3.1</p>
        </div>
        <div class="ds-header-meta">
          <div class="ds-meta-item">
            <span class="ds-meta-label">Fonts</span>
            <span class="ds-meta-val">Kanit + Montserrat</span>
          </div>
          <div class="ds-meta-item">
            <span class="ds-meta-label">Framework</span>
            <span class="ds-meta-val">Astro 6 / SSG</span>
          </div>
          <div class="ds-meta-item">
            <span class="ds-meta-label">Deploy</span>
            <span class="ds-meta-val">Cloudflare Pages</span>
          </div>
        </div>
      </div>
    </header>

    <main class="ds-main">

      <!-- LOGO -->
      <section class="ds-section" id="logo">
        <h2 class="ds-section-title">Logo</h2>
        <div class="ds-logo-grid">
          <div class="ds-logo-swatch ds-bg-dark">
            <img src="/ae-logo.svg" alt="æthero" height="40" />
            <span class="ds-swatch-label">Na tmavém pozadí</span>
          </div>
          <div class="ds-logo-swatch ds-bg-teal">
            <img src="/ae-logo.svg" alt="æthero" height="40" />
            <span class="ds-swatch-label">Na teal pozadí</span>
          </div>
          <div class="ds-logo-swatch ds-bg-white">
            <img src="/ae-logo.svg" alt="æthero" height="40" style="filter: invert(1) brightness(0);" />
            <span class="ds-swatch-label ds-label-dark">Na bílém pozadí</span>
          </div>
          <div class="ds-logo-swatch ds-bg-dark" style="align-items: flex-start; gap: 16px;">
            <img src="/ae-logo.svg" alt="æthero" height="28" />
            <img src="/shopify-plus-badge.svg" alt="Shopify Plus Partner" height="28" style="filter: brightness(0) invert(1);" />
            <span class="ds-swatch-label">Logo + badge (footer)</span>
          </div>
        </div>
      </section>

      <!-- COLORS -->
      <section class="ds-section" id="colors">
        <h2 class="ds-section-title">Barvy</h2>

        <h3 class="ds-subsection-title ds-locked">Pozadí</h3>
        <div class="ds-color-grid">
          <div class="ds-chip2" style="--chip-bg: #00021A;">
            <div class="ds-chip2-swatch" style="background: #00021A;"></div>
            <div class="ds-chip2-body">
              <div class="ds-chip2-top">
                <code>--ae-bg-deep</code>
                <span class="ds-chip2-hex">#00021A</span>
              </div>
              <strong class="ds-chip2-name">Deep · darkest</strong>
              <p class="ds-chip2-desc">Nejhlubší vrstva — podklady za gradienty, výjimečné použití.</p>
            </div>
          </div>
          <div class="ds-chip2" style="--chip-bg: #000326;">
            <div class="ds-chip2-swatch"></div>
            <div class="ds-chip2-body">
              <div class="ds-chip2-top">
                <code>--ae-bg-primary</code>
                <span class="ds-chip2-hex">#000326</span>
              </div>
              <strong class="ds-chip2-name">Primary · canvas</strong>
              <p class="ds-chip2-desc">Hlavní canvas webu. Většina sekcí, header po scrollu, dropdowny.</p>
            </div>
          </div>
          <div class="ds-chip2" style="--chip-bg: #0C0C42;">
            <div class="ds-chip2-swatch" style="background: #0C0C42;"></div>
            <div class="ds-chip2-body">
              <div class="ds-chip2-top">
                <code>--ae-bg-raised</code>
                <span class="ds-chip2-hex">#0C0C42</span>
              </div>
              <strong class="ds-chip2-name">Raised · cards</strong>
              <p class="ds-chip2-desc">Karty, inputy, vyvýšené elementy — lehce světlejší než canvas.</p>
            </div>
          </div>
          <div class="ds-chip2" style="--chip-bg: #2F324D;">
            <div class="ds-chip2-swatch" style="background: #2F324D;"></div>
            <div class="ds-chip2-body">
              <div class="ds-chip2-top">
                <code>--card-button</code>
                <span class="ds-chip2-hex">#2F324D</span>
              </div>
              <strong class="ds-chip2-name">Card / Button</strong>
              <p class="ds-chip2-desc">Šedomodrá — pozadí karet, tlačítek a interaktivních prvků.</p>
            </div>
          </div>
        </div>

        <h3 class="ds-subsection-title ds-locked">Akcenty</h3>
        <div class="ds-color-grid">
          <div class="ds-chip2 ds-chip2-accent">
            <div class="ds-chip2-swatch" style="background: #16BECF;"></div>
            <div class="ds-chip2-body">
              <div class="ds-chip2-top">
                <code>--action</code>
                <span class="ds-chip2-hex">#16BECF</span>
              </div>
              <strong class="ds-chip2-name">Primární akcent — cyan</strong>
              <p class="ds-chip2-desc">Výhradně pro klikací prvky: nav linky při hoveru, nadpisy-linky (.t-ac třída), quick-nav, CTA sekce pozadí na app stránkách.</p>
              <span class="ds-chip2-rule ds-rule-link">📌 Cyan = vždy odkaz nebo CTA</span>
            </div>
          </div>
          <div class="ds-chip2">
            <div class="ds-chip2-swatch" style="background: #0DD4CD;"></div>
            <div class="ds-chip2-body">
              <div class="ds-chip2-top">
                <code>--action-hover</code>
                <span class="ds-chip2-hex">#0DD4CD</span>
              </div>
              <strong class="ds-chip2-name">Action hover / Footer CTA bg</strong>
              <p class="ds-chip2-desc">Hover stav action barvy. Zároveň pozadí footer CTA sekce (Máme spolu co probrat?) a teal tlačítek.</p>
            </div>
          </div>
          <div class="ds-chip2 ds-chip2-accent">
            <div class="ds-chip2-swatch" style="background: #A081D1;"></div>
            <div class="ds-chip2-body">
              <div class="ds-chip2-top">
                <code>--text-secondary</code>
                <span class="ds-chip2-hex">#A081D1</span>
              </div>
              <strong class="ds-chip2-name">Zvýraznění textu / Stats bar</strong>
              <p class="ds-chip2-desc">Tučné zvýraznění klíčových frází v popisech sekcí (třída .ac, font-weight 900). Pozadí stats baru na homepage. Nikdy odkaz.</p>
              <span class="ds-chip2-rule ds-rule-nolink">🚫 Fialová = nikdy odkaz</span>
            </div>
          </div>
          <div class="ds-chip2">
            <div class="ds-chip2-swatch" style="background: #552A9F;"></div>
            <div class="ds-chip2-body">
              <div class="ds-chip2-top">
                <code>--accent-purple</code>
                <span class="ds-chip2-hex">#552A9F</span>
              </div>
              <strong class="ds-chip2-name">Gradient čísel SVG</strong>
              <p class="ds-chip2-desc">Výhradně v gradientu číslovacích SVG souborů sekcí (no-01.svg až no-07.svg). V textu na webu nepoužívat — příliš agresivní.</p>
            </div>
          </div>
          <div class="ds-chip2">
            <div class="ds-chip2-swatch" style="background: #96BF48;"></div>
            <div class="ds-chip2-body">
              <div class="ds-chip2-top">
                <code>--accent-shopify</code>
                <span class="ds-chip2-hex">#96BF48</span>
              </div>
              <strong class="ds-chip2-name">Shopify zelená</strong>
              <p class="ds-chip2-desc">Pouze pro Shopify branding — badge, ikona, explicitní zmínky o Shopify platformě.</p>
            </div>
          </div>
          <div class="ds-chip2" style="--chip-bg: #092066;">
            <div class="ds-chip2-swatch" style="background: #092066;"></div>
            <div class="ds-chip2-body">
              <div class="ds-chip2-top">
                <code>--ae-straight-blue</code>
                <span class="ds-chip2-hex">#092066</span>
              </div>
              <strong class="ds-chip2-name">Straight Blue</strong>
              <p class="ds-chip2-desc">Text na světlém nebo barevném pozadí — čísla ve stats baru, kontaktní info v cyan CTA bloku. Nikdy jako pozadí.</p>
            </div>
          </div>
        </div>

      </section>

      <!-- PRAVIDLA -->
      <section class="ds-section" id="rules">
        <h2 class="ds-section-title">Pravidla barev</h2>

        <div class="ds-rules">

          <div class="ds-rule-card">
            <div class="ds-rule-pill" style="background: #16BECF; color: #000326;">CYAN</div>
            <div class="ds-rule-body">
              <strong>Cyan je vždy klikací prvek</strong>
              <p>Pokud je něco cyan, musí jít kliknout. Cyan slouží jako vizuální signál interaktivity — uživatel instinktivně ví, že na to může sáhnout.</p>
              <div class="ds-rule-cols">
                <div class="ds-rule-ok">
                  <span class="ds-rule-badge-ok">✓ správně</span>
                  <ul>
                    <li>Nav položka při hoveru</li>
                    <li>Nadpis sekce jako odkaz (.t-ac)</li>
                    <li>Quick-nav sekce</li>
                    <li>Pozadí CTA bloku (celý blok je klikací zóna)</li>
                  </ul>
                </div>
                <div class="ds-rule-bad">
                  <span class="ds-rule-badge-bad">✗ špatně</span>
                  <ul>
                    <li>Zvýraznění klíčového slova v textu</li>
                    <li>Dekorativní label nebo badge</li>
                    <li>Čísla sekcí nebo ikonky</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <div class="ds-rule-card">
            <div class="ds-rule-pill" style="background: #A081D1; color: #000326;">FIALOVÁ</div>
            <div class="ds-rule-body">
              <strong>Fialová je zvýraznění — nikdy odkaz</strong>
              <p>Fialová (--text-secondary) označuje důležité fráze v body textu. Je to ekvivalent tučného písma, jen s barvou navíc. Nesmí být zaměnitelná za odkaz.</p>
              <div class="ds-rule-cols">
                <div class="ds-rule-ok">
                  <span class="ds-rule-badge-ok">✓ správně</span>
                  <ul>
                    <li>&lt;strong class="ac"&gt; v popisech sekcí Co umíme</li>
                    <li>Pozadí stats baru</li>
                  </ul>
                </div>
                <div class="ds-rule-bad">
                  <span class="ds-rule-badge-bad">✗ špatně</span>
                  <ul>
                    <li>&lt;a&gt; tag s fialovou barvou</li>
                    <li>Tlačítko nebo CTA</li>
                    <li>Nav položka</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>


        </div>
      </section>

      <!-- SIGNÁLNÍ BARVY -->
      <section class="ds-section" id="signal-colors">
        <h2 class="ds-section-title">Signální barvy</h2>
        <p style="font-size:12px;color:rgba(255,255,255,0.4);line-height:1.6;margin-bottom:32px">Sémantické tokeny pro stavové info bloky. Nikdy jako dekorativní barvy nebo branding — pouze pro funkční sdělení.</p>

        <!-- Paleta -->
        <div class="ds-block-label ds-locked">Tokeny</div>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:40px">
          <div style="border-radius:8px;overflow:hidden">
            <div style="background:#FF5252;height:64px"></div>
            <div style="background:rgba(255,255,255,0.04);padding:12px 14px">
              <div style="font-family:var(--font-primary);font-size:13px;font-weight:700;color:#FF5252;margin-bottom:4px">Error</div>
              <div style="font-size:11px;color:rgba(255,255,255,0.4);font-family:monospace">--semantic-error<br/>#FF5252</div>
            </div>
          </div>
          <div style="border-radius:8px;overflow:hidden">
            <div style="background:#4ECCA3;height:64px"></div>
            <div style="background:rgba(255,255,255,0.04);padding:12px 14px">
              <div style="font-family:var(--font-primary);font-size:13px;font-weight:700;color:#4ECCA3;margin-bottom:4px">Success</div>
              <div style="font-size:11px;color:rgba(255,255,255,0.4);font-family:monospace">--semantic-success<br/>#4ECCA3</div>
            </div>
          </div>
          <div style="border-radius:8px;overflow:hidden">
            <div style="background:#FFA940;height:64px"></div>
            <div style="background:rgba(255,255,255,0.04);padding:12px 14px">
              <div style="font-family:var(--font-primary);font-size:13px;font-weight:700;color:#FFA940;margin-bottom:4px">Warning</div>
              <div style="font-size:11px;color:rgba(255,255,255,0.4);font-family:monospace">--semantic-warning<br/>#FFA940</div>
            </div>
          </div>
          <div style="border-radius:8px;overflow:hidden">
            <div style="background:#5DADE2;height:64px"></div>
            <div style="background:rgba(255,255,255,0.04);padding:12px 14px">
              <div style="font-family:var(--font-primary);font-size:13px;font-weight:700;color:#5DADE2;margin-bottom:4px">Info</div>
              <div style="font-size:11px;color:rgba(255,255,255,0.4);font-family:monospace">--semantic-info<br/>#5DADE2</div>
            </div>
          </div>
        </div>

        <!-- Info bloky -->
        <div class="ds-block-label">Info bloky — použití</div>
        <div class="ds-bg-dark" style="padding:40px 48px;display:flex;flex-direction:column;gap:16px">

          <div style="display:flex;gap:20px;align-items:center;padding:20px 24px;border-left:4px solid #FF5252;background:rgba(255,82,82,0.13);border-radius:0 6px 6px 0;max-width:520px">
            <svg xmlns="http://www.w3.org/2000/svg" width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="#FF5252" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:2px"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
            <div>
              <p style="font-family:var(--font-primary);font-size:13px;font-weight:700;color:#FF5252;text-transform:uppercase;letter-spacing:0.08em;margin:0 0 6px">NOT OK — chyba</p>
              <p style="font-size:var(--fs-18);font-weight:500;color:rgba(255,255,255,0.8);margin:0;line-height:1.65">Popis problému nebo kritického stavu. Např. chybějící data, selhání procesu, špatný vzor.</p>
            </div>
          </div>

          <div style="display:flex;gap:20px;align-items:center;padding:20px 24px;border-left:4px solid #4ECCA3;background:rgba(78,204,163,0.13);border-radius:0 6px 6px 0;max-width:520px">
            <svg xmlns="http://www.w3.org/2000/svg" width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="#4ECCA3" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:2px"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
            <div>
              <p style="font-family:var(--font-primary);font-size:13px;font-weight:700;color:#4ECCA3;text-transform:uppercase;letter-spacing:0.08em;margin:0 0 6px">OK — úspěch</p>
              <p style="font-size:var(--fs-18);font-weight:500;color:rgba(255,255,255,0.8);margin:0;line-height:1.65">Potvrzení správného stavu nebo výsledku. Např. splněný krok, validní vstup, schválený vzor.</p>
            </div>
          </div>

          <div style="display:flex;gap:20px;align-items:center;padding:20px 24px;border-left:4px solid #FFA940;background:rgba(255,169,64,0.13);border-radius:0 6px 6px 0;max-width:520px">
            <svg xmlns="http://www.w3.org/2000/svg" width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="#FFA940" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:2px"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
            <div>
              <p style="font-family:var(--font-primary);font-size:13px;font-weight:700;color:#FFA940;text-transform:uppercase;letter-spacing:0.08em;margin:0 0 6px">Varování</p>
              <p style="font-size:var(--fs-18);font-weight:500;color:rgba(255,255,255,0.8);margin:0;line-height:1.65">Upozornění na riziko nebo hraniční situaci. Nevyžaduje okamžitou akci, ale pozornost.</p>
            </div>
          </div>

          <div style="display:flex;gap:20px;align-items:center;padding:20px 24px;border-left:4px solid #5DADE2;background:rgba(93,173,226,0.13);border-radius:0 6px 6px 0;max-width:520px">
            <svg xmlns="http://www.w3.org/2000/svg" width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="#5DADE2" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:2px"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
            <div>
              <p style="font-family:var(--font-primary);font-size:13px;font-weight:700;color:#5DADE2;text-transform:uppercase;letter-spacing:0.08em;margin:0 0 6px">Info</p>
              <p style="font-size:var(--fs-18);font-weight:500;color:rgba(255,255,255,0.8);margin:0;line-height:1.65">Neutrální doplňující informace nebo kontext. Např. poznámka, tip, definice pojmu.</p>
            </div>
          </div>

        </div>

        <!-- Info-box / callout varianty -->
        <div class="ds-block-label ds-locked" style="margin-top:24px">info-box — 4 barevné varianty (error · success · warning · info)</div>
        <div class="ds-bg-dark" style="padding:40px 48px;display:flex;flex-direction:column;gap:20px">

          <!-- error -->
          <div style="border-left:4px solid var(--semantic-error);padding:20px 24px;background:rgba(255,82,82,0.13);border-radius:0 8px 8px 0;max-width:640px">
            <p style="font-family:var(--font-primary);font-size:14px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:var(--semantic-error);margin:0 0 8px;display:flex;align-items:center;gap:8px">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
              Not OK — Chyba:
            </p>
            <p style="font-size:var(--fs-18);font-weight:500;color:rgba(255,255,255,0.8);margin:0;line-height:1.65">Zákazníci emaily otvírali, ale přestávali klikat — tím se propad v emailovém výkonu přímo přenášel do obratu. Email přitom tvoří téměř polovinu celkových tržeb.</p>
          </div>

          <!-- success -->
          <div style="border-left:4px solid var(--semantic-success);padding:20px 24px;background:rgba(78,204,163,0.13);border-radius:0 8px 8px 0;max-width:640px">
            <p style="font-family:var(--font-primary);font-size:14px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:var(--semantic-success);margin:0 0 8px;display:flex;align-items:center;gap:8px">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
              OK — Úspěch:
            </p>
            <p style="font-size:var(--fs-18);font-weight:500;color:rgba(255,255,255,0.8);margin:0;line-height:1.65">Zákazníci emaily otvírali, ale přestávali klikat — tím se propad v emailovém výkonu přímo přenášel do obratu. Email přitom tvoří téměř polovinu celkových tržeb.</p>
          </div>

          <!-- warning -->
          <div style="border-left:4px solid var(--semantic-warning);padding:20px 24px;background:rgba(255,168,68,0.13);border-radius:0 8px 8px 0;max-width:640px">
            <p style="font-family:var(--font-primary);font-size:14px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:var(--semantic-warning);margin:0 0 8px;display:flex;align-items:center;gap:8px">
