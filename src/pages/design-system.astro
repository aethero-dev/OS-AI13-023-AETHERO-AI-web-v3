    --ds-muted: rgba(255,255,255,0.45);
    --ds-accent: #0DD4CD;
    --ds-purple: #A081D1;
  }

  body { background: var(--ds-bg); color: var(--ds-text); }

  .ds-page {
    min-height: 100vh;
    font-family: 'Montserrat', sans-serif;
    background: var(--ds-bg);
    color: var(--ds-text);
    -webkit-font-smoothing: antialiased;
  }

  /* NAV */
  .ds-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(10,10,26,0.95);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--ds-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 40px;
    height: 48px;
    gap: 40px;
  }
  .ds-nav-logo {
    font-size: 14px;
    color: var(--ds-muted);
    text-decoration: none;
    transition: color 0.2s;
    white-space: nowrap;
  }
  .ds-nav-logo:hover { color: var(--ds-text); }
  .ds-nav-links {
    display: flex;
    gap: 32px;
  }
  .ds-nav-links a {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--ds-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .ds-nav-links a:hover { color: var(--ds-accent); }

  /* HEADER */
  .ds-header {
    padding: 80px 40px 60px;
    border-bottom: 1px solid var(--ds-border);
    background: linear-gradient(180deg, rgba(13,212,205,0.04) 0%, transparent 100%);
  }
  .ds-header-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
  }
  .ds-label {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 12px;
  }
  .ds-title {
    font-family: 'Kanit', sans-serif;
    font-size: var(--fs-80);
    font-weight: 700;
    line-height: 1;
    color: #fff;
  }
  .ds-version {
    font-family: 'Kanit', sans-serif;
    font-size: 32px;
    font-weight: 400;
    color: var(--ds-purple);
    margin-top: 8px;
  }
  .ds-header-meta {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-bottom: 4px;
  }
  .ds-meta-item {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .ds-meta-label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ds-muted);
    min-width: 80px;
  }
  .ds-meta-val {
    font-size: 15px;
    font-family: 'Kanit', sans-serif;
    color: #fff;
  }

  /* MAIN */
  .ds-main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px 80px;
  }

  /* SECTIONS */
  .ds-section {
    padding: 80px 0;
    border-bottom: 1px solid var(--ds-border);
  }
  .ds-section-title {
    font-family: 'Kanit', sans-serif;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 40px;
  }
  .ds-subsection-title {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--ds-muted);
    margin: 48px 0 16px;
  }
  .ds-subsection-title:first-of-type { margin-top: 0; }

  /* LOGO */
  .ds-logo-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .ds-logo-swatch {
    border-radius: 10px;
    padding: 32px 24px 16px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    border: 1px solid var(--ds-border);
  }
  .ds-bg-dark { background: #000326; }
  .ds-bg-teal { background: #0DD4CD; }
  .ds-bg-white { background: #fff; }
  .ds-swatch-label {
    font-size: 13px;
    color: rgba(255,255,255,0.4);
  }
  .ds-label-dark { color: rgba(0,0,0,0.4); }

  /* COLORS */
  .ds-color-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 12px;
    margin-bottom: 8px;
  }
  .ds-color-grid-4 {
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  }
  .ds-chip2 {
    display: flex;
    flex-direction: column;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.03);
  }
  .ds-chip2-swatch {
    height: 120px;
    background: var(--chip-bg, #888);
    flex-shrink: 0;
  }
  .ds-chip2-body {
    padding: 12px 14px 14px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
  }
  .ds-chip2-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 2px;
  }
  .ds-chip2-top code {
    font-size: 13px;
    color: var(--ds-cyan);
    background: rgba(22,190,207,0.08);
    padding: 2px 7px;
    border-radius: 4px;
  }
  .ds-chip2-hex {
    font-size: 13px;
    color: rgba(255,255,255,0.35);
    font-family: monospace;
  }
  .ds-chip2-hex-dark { color: rgba(0,0,0,0.35); }
  .ds-chip2-name {
    font-size: 15px;
    font-weight: 600;
    color: #fff;
    line-height: 1.3;
  }
  .ds-chip2-name-dark { color: rgba(0,0,0,0.75); }
  .ds-chip2-desc {
    font-size: 14px;
    color: rgba(255,255,255,0.45);
    line-height: 1.55;
    margin: 0;
  }
  .ds-chip2-desc-dark { color: rgba(0,0,0,0.45); }
  .ds-chip2-rule {
    display: inline-block;
    margin-top: 6px;
    font-size: 13px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
    align-self: flex-start;
  }
  .ds-rule-link {
    background: rgba(22,190,207,0.15);
    color: var(--ds-cyan);
  }
  .ds-rule-nolink {
    background: rgba(160,129,209,0.15);
    color: #A081D1;
  }

  /* RULES */
  .ds-rules {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .ds-rule-card {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px;
    padding: 20px 24px;
  }
  .ds-rule-pill {
    flex-shrink: 0;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-top: 3px;
  }
  .ds-rule-pill-outline {
    background: transparent;
    border: 2px solid rgba(255,255,255,0.5);
    color: rgba(255,255,255,0.7);
  }
  .ds-rule-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ds-rule-body strong {
    font-size: 17px;
    font-weight: 700;
    color: #fff;
    display: block;
  }
  .ds-rule-body > p {
    font-size: 15px;
    color: rgba(255,255,255,0.55);
    line-height: 1.6;
    margin: 0;
  }
  .ds-rule-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 4px;
  }
  .ds-rule-ok, .ds-rule-bad {
    background: rgba(255,255,255,0.03);
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 14px;
    line-height: 1.6;
  }
  .ds-rule-ok { border-left: 3px solid #4ECCA3; }
  .ds-rule-bad { border-left: 3px solid #FF5252; }
  .ds-rule-badge-ok, .ds-rule-badge-bad {
    display: block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .ds-rule-badge-ok { color: #4ECCA3; }
  .ds-rule-badge-bad { color: #FF5252; }
  .ds-rule-ok ul, .ds-rule-bad ul {
    margin: 0;
    padding-left: 14px;
    color: rgba(255,255,255,0.55);
  }
  .ds-rule-ok li, .ds-rule-bad li { margin-bottom: 2px; }

  /* TYPOGRAPHY */
  .ds-type-specimens {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .ds-type-row {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 24px;
    align-items: stretch;
  }
  .ds-type-meta {
    font-size: 14px;
    color: var(--ds-muted);
    line-height: 1.6;
    padding: 24px 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .ds-type-meta code {
    font-size: 15px;
    font-weight: 700;
    color: var(--ds-accent);
    font-family: monospace;
  }
  .ds-type-meta em {
    font-style: italic;
    color: var(--ds-muted);
    font-size: 13px;
  }
  .ds-type-preview {
    border-radius: 10px;
    padding: 32px 40px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    border: 1px solid var(--ds-border);
    overflow: hidden;
  }

  /* TEXT DEMO */
  .ds-text-demo-note { font-size: 14px; color: rgba(255,255,255,0.4); font-family: monospace; margin-bottom: 20px; }
  .ds-text-demo-note code { color: rgba(255,255,255,0.6); }
  .ds-text-demo-block { background: var(--ds-surface); border: 1px solid var(--ds-border); border-radius: 10px; padding: 32px 40px; }
  .ds-text-demo { font-family: 'Montserrat', sans-serif; font-size: 18px; font-weight: 400; line-height: 1.65; color: rgba(255,255,255,0.75); }
  .ds-ac { color: #A081D1; font-weight: 600; font-style: normal; }

  /* SPACING */
  .ds-spacing-grid {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .ds-spacing-item {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .ds-spacing-bar {
    height: 20px;
    background: linear-gradient(90deg, var(--ds-accent), var(--ds-purple));
    border-radius: 4px;
    flex-shrink: 0;
  }
  .ds-spacing-item code {
    font-size: 14px;
    color: rgba(255,255,255,0.6);
    min-width: 120px;
    font-family: monospace;
  }
  .ds-spacing-val {
    font-size: 14px;
    color: var(--ds-muted);
  }

  /* COMPONENTS */
  .ds-component-row {
    display: flex;
    align-items: center;
    border-radius: 10px;
    border: 1px solid var(--ds-border);
    overflow: hidden;
  }
  .ds-component-notes {
    font-size: 16px;
    color: var(--ds-muted);
    line-height: 1.7;
    padding: 16px 0;
    border-bottom: 1px solid var(--ds-border);
  }
  .ds-component-notes code {
    color: rgba(255,255,255,0.6);
    font-family: monospace;
  }

  /* Button groups */
  .ds-btn-group-label {
    font-family: 'Kanit', sans-serif;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #A081D1;
    padding: 14px 0 8px;
    border-top: 1px solid var(--ds-border);
    margin-top: 16px;
  }
  .ds-btn-row {
    border-radius: 10px;
    padding: 36px 40px;
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    align-items: flex-start;
    margin-bottom: 4px;
  }
  .ds-btn-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-start;
  }
  .ds-btn-tag {
    font-family: monospace;
    font-size: 13px;
    color: rgba(255,255,255,0.85);
    background: rgba(255,255,255,0.08);
    padding: 2px 8px;
    border-radius: 4px;
  }
  .ds-btn-tag--dark {
    color: #000326;
    background: rgba(0,3,38,0.15);
  }
  .ds-btn-note {
    font-family: 'Montserrat', sans-serif;
    font-size: 13px;
    color: rgba(255,255,255,0.45);
    max-width: 280px;
    line-height: 1.5;
  }
  .ds-btn-note--dark {
    color: rgba(0,3,38,0.6);
  }

  /* FONT STACK */
  .ds-font-stack {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 8px;
  }
  .ds-font-card {
    background: var(--ds-surface);
    border: 1px solid var(--ds-border);
    border-radius: 10px;
    padding: 24px 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .ds-font-var code { font-size: 14px; color: #fff; }
  .ds-font-name { font-size: 40px; font-weight: 700; color: #fff; line-height: 1; }
  .ds-font-weights { display: flex; gap: 16px; flex-wrap: wrap; }
  .ds-font-weights span { font-size: 14px; color: #fff; }
  .ds-font-use { font-size: 14px; color: rgba(255,255,255,0.5); font-style: italic; }

  /* TYPE META — nový layout */
  .ds-type-meta {
    font-size: 14px;
    color: var(--ds-muted);
    line-height: 1.6;
    padding: 24px 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .ds-type-meta code { font-size: 15px; font-weight: 700; color: rgba(255,255,255,0.85); font-family: monospace; margin-bottom: 4px; }
  .ds-type-meta span { color: rgba(255,255,255,0.55); }
  .ds-type-meta em { font-style: italic; color: rgba(255,255,255,0.4); font-size: 13px; margin-top: 4px; }

  /* INCONSISTENCIES */
  .ds-section-warn { border-color: rgba(255,82,82,0.2); background: rgba(255,82,82,0.02); }
  .ds-title-warn { color: #FF5252 !important; }
  .ds-incon-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
    margin-bottom: 8px;
  }
  .ds-incon-card {
    background: var(--ds-surface);
    border: 1px solid var(--ds-border);
    border-radius: 10px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .ds-incon-card.ds-incon-bad { border-color: rgba(255,82,82,0.35); }
  .ds-incon-label { font-size: 14px; font-weight: 600; text-transform: uppercase; color: var(--ds-muted); letter-spacing: 0.03em; }
  .ds-incon-file { display: block; color: rgba(255,82,82,0.8); font-weight: 400; text-transform: none; margin-top: 2px; font-family: monospace; font-size: 13px; }
  .ds-incon-preview { background: #000326; border-radius: 6px; padding: 16px; min-height: 60px; display: flex; align-items: center; }
  .ds-incon-card code { font-size: 13px; color: rgba(255,82,82,0.9); font-family: monospace; }

  .ds-token-unused-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-bottom: 12px;
  }
  .ds-unused-token {
    background: var(--ds-surface);
    border: 1px solid rgba(255,82,82,0.3);
    border-radius: 8px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .ds-unused-token code { font-size: 13px; color: rgba(255,255,255,0.6); font-family: monospace; }
  .ds-unused-val { font-size: 14px; font-weight: 700; color: rgba(255,255,255,0.5); }
  .ds-unused-badge { font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #FF5252; margin-top: 4px; }

  .ds-code-diff {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 12px;
  }
  .ds-diff-bad, .ds-diff-good {
    border-radius: 8px;
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .ds-diff-bad { background: rgba(255,82,82,0.08); border: 1px solid rgba(255,82,82,0.3); }
  .ds-diff-good { background: rgba(78,204,163,0.08); border: 1px solid rgba(78,204,163,0.3); }
  .ds-diff-label { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
  .ds-diff-bad .ds-diff-label { color: #FF5252; }
  .ds-diff-good .ds-diff-label { color: #4ECCA3; }
  .ds-diff-bad pre, .ds-diff-good pre { margin: 0; }
  .ds-diff-bad code, .ds-diff-good code { font-size: 14px; font-family: monospace; line-height: 1.7; }
  .ds-diff-bad code { color: rgba(255,82,82,0.9); }
  .ds-diff-good code { color: #4ECCA3; }

  .ds-incon-note {
    font-size: 14px;
    color: var(--ds-muted);
    line-height: 1.6;
    padding: 10px 14px;
    background: rgba(255,255,255,0.03);
    border-left: 2px solid rgba(255,82,82,0.4);
    border-radius: 0 4px 4px 0;
    margin-top: 4px;
  }
  .ds-incon-note code { color: rgba(255,255,255,0.6); font-family: monospace; }

  /* REF CARD */
  .ds-ref-card {
    position: relative;
    max-width: 280px;
    width: 100%;
    border-radius: 6px;
    overflow: hidden;
    flex-shrink: 0;
  }
  .ds-ref-img { width: 100%; display: block; }
  .ds-ref-cta {
    position: absolute; bottom: 20px; left: 20px; right: 20px;
    border-radius: 6px;
    display: flex; align-items: center; justify-content: center;
    padding: 14px 20px;
    background: rgba(255,255,255,0.18);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.45);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.2), 0 4px 24px rgba(0,0,0,0.2);
    color: #000326;
    font-family: var(--font-primary); font-size: 16px; font-weight: 600;
    text-transform: uppercase; text-align: center; line-height: 1.4;
    text-decoration: none;
    transition: background var(--transition-base), border-color var(--transition-base);
  }
  .ds-ref-cta:hover { background: rgba(255,255,255,0.28); border-color: rgba(255,255,255,0.65); }

  /* K7 — TESTIMONIAL CARD */
  .ds-tc-card { background: var(--card-button); border-radius: var(--radius-md); padding: 48px; display: flex; flex-direction: column; gap: 32px; width: 460px; flex-shrink: 0; }
  .ds-tc-text { font-size: 18px; color: rgba(255,255,255,0.85); line-height: 1.75; font-style: italic; font-family: var(--font-secondary); margin: 0; flex: 1; }
  .ds-tc-google { display: flex; flex-direction: row; align-items: center; gap: 6px; flex-shrink: 0; }
  .ds-tc-footer { display: flex; align-items: center; gap: 20px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,0.08); }
  .ds-tc-avatar { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; object-position: top center; flex-shrink: 0; border: 3px solid rgba(255,255,255,0.15); }
  .ds-tc-person { flex: 1; min-width: 0; }
  .ds-tc-person strong { display: block; font-size: 22px; font-weight: 700; color: #fff; }
  .ds-tc-person span { display: block; font-size: 16px; color: rgba(255,255,255,0.5); margin-top: 4px; }
  .ds-tc-logo-link { display: inline-flex; flex-shrink: 0; margin-left: auto; }
  .ds-tc-logo { height: 48px; width: auto; max-width: 140px; object-fit: contain; }

  /* CITÁT / CITACE */
  .ds-block-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
    margin-bottom: 10px;
    margin-top: 20px;
  }
  .ds-block-label:first-of-type { margin-top: 0; }
  .ds-locked::before { content: '🔒'; margin-right: 6px; font-size: 10px; }

  .ds-spec-grid {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .ds-spec-item {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: 13px;
  }
  .ds-spec-item code {
    font-family: monospace;
    font-size: 13px;
    color: rgba(255,255,255,0.75);
    white-space: nowrap;
    min-width: 130px;
  }
  .ds-spec-item span { color: rgba(255,255,255,0.4); }

  /* Citát: styly z globálního .quote / .quote--center (global.css) */

  /* Sidebar — služby / kroky (icon list) */
  .work-aside { background: var(--ae-bg-deep); border: 1px solid rgba(255,255,255,0.10); border-radius: var(--radius-md); padding: var(--space-32); }
  .work-heading { font-size: var(--fs-18); font-weight: 700; letter-spacing: 0.08em; margin-bottom: var(--space-24); color: #fff; text-transform: uppercase; line-height: 1.3; padding-left: calc(42px + var(--space-16)); }
  .work-list { display: flex; flex-direction: column; gap: var(--space-32); }
  .work-item { display: flex; gap: var(--space-16); align-items: flex-start; }
