---
import PageLayout from '../../../layouts/PageLayout.astro';
import ServiceHero from '../../../components/layout/ServiceHero.astro';
import WorkSidebar from '../../../components/layout/WorkSidebar.astro';

const processItems = [
  { icon: '<path d="M9 17H7A5 5 0 0 1 7 7h2"/><path d="M15 7h2a5 5 0 1 1 0 10h-2"/><line x1="8" x2="16" y1="12" y2="12"/>', title: 'Data connection', desc: 'Send us exports or API access. No access? We\'ll help — we can pull the data ourselves, discreetly.' },
  { icon: '<line x1="12" x2="12" y1="20" y2="10"/><line x1="18" x2="18" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="16"/>', title: 'Analysis', desc: 'We go through the data in depth: orders, campaigns, customers. Typically 1–3 days depending on scope.' },
  { icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>', title: 'Live collaboration', desc: 'We go through results with you in real time. Bespoke strategy — no templates.' },
  { icon: '<path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/>', title: 'Strategy document + plan', desc: 'An online document with analysis and a clickable 365-day plan, accessible any time.' },
];

const analyzeItemsSidebar = [
  { icon: '<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>', title: 'Email marketing', desc: 'Leadhub, Klaviyo, Mailchimp, Ecomail. Campaigns, automations, segments, open rate, CTR, revenue per email.' },
  { icon: '<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>', title: 'E-commerce platform', desc: 'Shoptet, Shopify, WooCommerce — orders, customers, products, seasonality, retention, AOV.' },
  { icon: '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>', title: 'Google Analytics / GA4', desc: 'Traffic sources, conversion paths, attribution model, channel performance, user behaviour.' },
  { icon: '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>', title: 'Google Ads', desc: 'Campaign performance, ROAS, search terms, lost impressions, opportunities to scale or save.' },
  { icon: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>', title: 'Meta Ads', desc: 'Facebook & Instagram — reach, frequency, CPM, ROAS, audience overlap, funnel analysis.' },
  { icon: '<circle cx="12" cy="12" r="10"/><line x1="2" x2="22" y1="12" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>', title: 'Web crawling', desc: 'Data not in an export? We crawl the store automatically — product catalogue, prices, categories, UX patterns.' },
];

const deliverables = [
  '<strong class="hl">Key metrics overview</strong> — 24-month horizon, year-on-year comparison, trend identification',
  '<strong class="hl">Root causes of growth or decline</strong> — specific months, specific channels, specific revenue impacts',
  '<strong class="hl">Top campaign and automation analysis</strong> — what works, what does not, and why',
  '<strong class="hl">Cross-sell mapping</strong> — most common product combinations from real customer orders',
  '<strong class="hl">Segmentation recommendations</strong> — RFM analysis, club vs customers, win-back opportunities',
  '<strong class="hl">Specific marketing recommendations</strong> — beyond email: SEO, Pinterest, NPS, attribution model',
  '<strong class="hl">365-day action plan</strong> — 40+ specific tasks, each with priority and estimated impact',
];

const forWho = [
  'Your store generates data but you lack the capacity or know-how to read it properly',
  'You suspect your emails, ads or flows could perform better — but do not know how to do it',
  'You need a specific action plan with clear prioritisation, not generic recommendations',
  'You are deciding where to invest your marketing budget in the next year',
];

---

<PageLayout title="Analytics & Strategy" description="Stop guessing — find out why your store is not growing. We connect your data and deliver a strategy that works right away." lang="en">
  <ServiceHero
    lang="en"
    label="Analytics & Strategy"
    title="ANALYTICS <br /><span style='color:#fff'>& STRATEGY</span>"
    subtitle="Do you know why your store is growing? And why it sometimes is not? We connect your data, apply AI + context — and the results are truly impressive."
    ctaLabel="Let's talk"
    ctaHref="tel:+420776067663"
    cta2Label="Find out how"
    cta2Href="#how-it-works"
    image="/aethero-gradient-222.png"
    imageAlt="Strategy and analytics for an e-shop"
  />

  <!-- Stop guessing + WHAT WE ANALYSE sidebar -->
  <section class="section bg-primary">
    <div class="container intro-layout">
      <div class="intro-main">
        <h2 class="h1 intro-h2">Stop guessing, <br /><span class="accent-purple">FIND OUT WHY</span></h2>
        <p class="intro-text">Your store is telling you something. <strong class="hl">Are you listening?</strong> Every store has a story hidden inside its data — where it earns, where it bleeds, why some customers stay and others disappear after the first purchase. <strong class="hl">You already have that data — nobody is reading it.</strong> And someone should.</p>
        <p class="intro-text">It takes experience and a bit of technical voodoo, but then we sit down with your data, plans and a tamed AI, connect them to what is needed: Google Ads, Analytics, Meta and your email client — and <strong class="hl">hand you back a strategy with numbers against every recommendation</strong>: how much it will earn, how much it will save, when to switch it on.</p>
        <a href="#cta" class="btn-action btn-action--lg">Want an analysis? Call or write</a>
      </div>
      <WorkSidebar heading="WHAT WE ANALYSE" items={analyzeItemsSidebar} />
    </div>
  </section>

  <!-- How it works -->
  <section class="section bg-primary" id="how-it-works">
    <div class="container">
      <div class="jak-grid">
        <WorkSidebar heading="HOW IT WORKS" items={processItems} />
        <div>
          <h2 class="h2 section-title">From data to strategy <br />in 1–2 weeks</h2>
          <p class="section-text body">Send us access or exports — the rest is on us. We go through the data in depth, sit down with you in real time, and hand back a live strategy document with a clickable 365-day plan and a number next to every recommendation.</p>
          <p class="section-text body"><strong>No templates. No generic advice. A strategy built specifically for your store.</strong></p>
          <a href="#cta" class="btn-action btn-action--lg">I want an analysis</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Your data says more + For whom -->
  <section class="section bg-primary">
    <div class="container">
      <div class="data-forwho-grid">
        <div>
          <h2 class="h2 section-title">Your data says more <br />than you think</h2>
          <p class="section-text body">API access, CSV exports or web crawling — we can connect almost any data source. We combine data from your store, email campaigns, Google Ads, Analytics and social media. And you then receive a specific strategy with the quantified benefit of each recommendation — no generic advice.</p>
          <p class="section-text body">We most often work with stores from €120k annual revenue on Shoptet, Shopify and WooCommerce.</p>
        </div>
        <div>
          <h2 class="h3 section-title">This service is for you, <span class="text-action">if...</span></h2>
          <ul class="arrow-list">
            {forWho.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section bg-primary">
    <div class="container">
      <h2 class="h2 testimonials-label">References from e-shop owners</h2>
      <div class="testimonials-grid">
        <div class="testimonial-card">
          <p class="testimonial-text">"The output was well-crafted, clear and above all full of specific insights we can immediately use to drive further growth for our store. No generic recommendations — solutions tailored specifically to us."</p>
          <div class="google-review">
            <svg class="google-g-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-label="Google">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            <div class="google-stars">★★★★★</div>
          </div>
          <div class="testimonial-footer">
            <img src="/ref-lucie.jpg" alt="Lucie" class="testimonial-avatar" />
            <div class="testimonial-person">
              <span>Lucie, owner</span>
              <a href="https://www.fleppi.cz" target="_blank" rel="noopener noreferrer" class="text-link">Fleppi.cz</a>
            </div>
            <a href="https://www.fleppi.cz" target="_blank" rel="noopener noreferrer" class="testimonial-logo-link">
              <img src="/ref-fleppi-logo.png" alt="fleppi" class="testimonial-logo" />
            </a>
          </div>
        </div>
        <div class="testimonial-card">
          <p class="testimonial-text">"I am thrilled, because for the first time I have a complete picture of everything happening in the store, all in one place. The biggest thing is how the data connects with each other. I can see whether the content on the site actually engaged people and add info from the mailing — what people respond to best in emails. These overlaps, where I see the entire customer journey from search to purchase, allow me to make changes in Shopify that actually make sense."</p>
          <div class="testimonial-footer">
            <img src="/ref-petr.png" alt="Petr" class="testimonial-avatar" />
            <div class="testimonial-person">
              <span>Petr, owner</span>
              <a href="https://bu1.cz" target="_blank" rel="noopener noreferrer" class="text-link">BU1.cz</a>
            </div>
            <a href="https://bu1.cz" target="_blank" rel="noopener noreferrer" class="testimonial-logo-link">
              <img src="/ref-bu1-logo.svg" alt="BU1" class="testimonial-logo" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Output / Case study -->
  <section class="section bg-primary">
    <div class="container">
      <h2 class="h2-mini section-title-center">You get output, <br /><span class="text-action">you can use straight away.</span></h2>
      <div class="output-col">
        <div>
          <p class="section-text body">No Excel tables that nobody opens. The result is a <strong class="hl">live strategy document available online</strong> — clear, specific, with a clickable action plan.</p>
          <ul class="arrow-list" style="margin-bottom: var(--space-32)">
            {deliverables.map((d) => (
              <li><span set:html={d}></span></li>
            ))}
          </ul>
        </div>
        <div class="case-study-wrap">
          <div class="case-study-card">
            <img src="/fleppi-study-v2.webp" alt="Email strategy for fleppi.cz" class="case-study-img" loading="lazy" />
            <a href="/en/pripadova-studie-email-marketing-fleppi-cz" class="ref-card-cta">Read the <br/>case study</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section" id="cta">
    <div class="container cta-inner">
      <h2>I want the analysis to show me <br />where things are going wrong — calling, writing!</h2>
      <div class="cta-contacts">
        <a href="mailto:info@aethero.cz" class="cta-contact">info@aethero.cz</a>
        <a href="tel:+420776067663" class="cta-contact">+420 776 067 663</a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  /* .hl (bold lavender) — globální utilita v global.css */
  .section-title-center { font-size: var(--fs-48); font-weight: 600; margin-bottom: var(--space-40); text-align: center; }

  /* Intro + sidebar = 2 sloupce */
  .intro-layout { display: grid; grid-template-columns: 1fr 420px; gap: var(--space-64); align-items: start; }
  @media (max-width: 900px) { .intro-layout { grid-template-columns: 1fr; gap: var(--space-40); } }

  .jak-grid { display: grid; grid-template-columns: 420px 1fr; gap: var(--space-80); align-items: start; }
  @media (max-width: 900px) { .jak-grid { grid-template-columns: 1fr; } }

  .data-forwho-grid { display: grid; grid-template-columns: 2fr 1fr; gap: var(--space-80); align-items: start; }
  @media (max-width: 900px) { .data-forwho-grid { grid-template-columns: 1fr; } }

  .output-col { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-80); align-items: start; }

  .case-study-wrap { display: flex; }
  .case-study-card { position: relative; border-radius: var(--radius-md); overflow: hidden; }
  .case-study-img { display: block; width: 100%; height: auto; }

  .testimonials-label { margin-bottom: var(--space-40); text-align: center; }
  .testimonials-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: stretch; }
  .testimonial-card {
    background: var(--card-button);
    border-radius: var(--radius-md);
    padding: 48px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .testimonial-footer { display: flex; align-items: center; gap: 20px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,0.08); }
  .google-review { display: flex; flex-direction: row; align-items: center; gap: 6px; flex-shrink: 0; margin-top: 16px; }
  .google-g-icon { width: 20px; height: 20px; display: block; }
  .google-stars { color: #FABB05; font-size: 16px; letter-spacing: 1px; line-height: 1; }
  .testimonial-avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    object-position: top center;
    flex-shrink: 0;
    border: 3px solid rgba(255,255,255,0.15);
  }
  .testimonial-person { min-width: 0; flex: 1; }
  .testimonial-person span { font-size: 16px; color: rgba(255,255,255,0.85); font-weight: 600; display: block; }
  .testimonial-text {
    font-size: 18px;
    color: rgba(255,255,255,0.85);
    line-height: 1.75;
    font-style: italic;
    font-family: var(--font-secondary);
    margin: 0;
    flex: 1;
  }
  .testimonial-logo-link { display: inline-flex; flex-shrink: 0; margin-left: auto; }
  .testimonial-logo { height: 48px; width: auto; max-width: 140px; object-fit: contain; flex-shrink: 0; }

  @media (max-width: 1024px) {
    .output-col { grid-template-columns: 1fr; }
    .case-study-wrap { display: none; }
    .testimonials-grid { grid-template-columns: 1fr; }
  }
</style>
