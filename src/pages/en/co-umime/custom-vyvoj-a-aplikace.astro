---
import ArticleFaq from '../../../components/ArticleFaq.astro';
import PageLayout from '../../../layouts/PageLayout.astro';
import ServiceHero from '../../../components/layout/ServiceHero.astro';
import WorkSidebar from '../../../components/layout/WorkSidebar.astro';

const processItems = [
  { icon: '<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>', title: 'Quick audit & brief', desc: 'What exactly should the result be and how will we know it works.' },
  { icon: '<polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/>', title: 'Solution design', desc: 'Options: app vs. modification vs. integration (and why).' },
  { icon: '<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>', title: 'MVP', desc: 'The first version that already delivers value (and is safe to run in production).' },
  { icon: '<polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>', title: 'Iteration & scaling', desc: 'We smooth out the edges, add automations, speed things up.' },
  { icon: '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><line x1="4.93" y1="4.93" x2="9.17" y2="9.17"/><line x1="14.83" y1="14.83" x2="19.07" y2="19.07"/><line x1="14.83" y1="9.17" x2="19.07" y2="4.93"/><line x1="4.93" y1="19.07" x2="9.17" y2="14.83"/>', title: 'Support', desc: 'So it still works 3 months later - not just on launch day.' },
];

const whenCustom = [
  'you need to connect to an ERP / warehouse / supplier, but the data is "different"',
  'you want custom logic in the cart / shipping / discounts / B2B that generic apps cannot handle',
  'you deal with local requirements (CZ/SK and beyond) and do not want more "duct-tape" solutions',
  'you need automations that save time every single day',
];

const deliverables = [
  'Shopify theme modifications (Liquid, UX/CRO tweaks, performance)',
  'Shopify Functions & checkout logic (discounts, shipping, B2B rules - where Shopify allows it)',
  'API integrations (ERP, CRM, WMS, carriers, invoicing, PIM…)',
  'Custom apps (private/public), admin tools, dashboards',
  'Data workflows (imports/exports, validation, field mapping, automation)',
];

const hardCases = [
  { title: 'Supplier feeds & imports', desc: 'When a "universal" parser is not enough and you need custom mapping, rules, validation and monitoring.' },
  { title: 'B2B logic', desc: 'Login-based pricing, individual price lists, order approval, payment limits.' },
  { title: 'Shipping & payments', desc: 'Locally and internationally: rules that change per country, cart, warehouse, margin.' },
  { title: 'ERP/WMS integration', desc: 'Stock movements, invoicing, returns, order status - so data matches everywhere.' },
  { title: 'Admin tools', desc: "Internal dashboards that speed up the team's work (and reduce errors)." },
];

const whyUs = [
  { title: 'Shopify-first approach', desc: 'Get the maximum out of the platform - and go custom only where it makes sense.' },
  { title: 'Value for money', desc: 'A smart solution rather than an expensive build for the sake of building.' },
  { title: 'E-commerce in our DNA', desc: 'We solve not just the code, but also UX, data and operational impact.' },
  { title: 'Sustainability', desc: 'So it is not a "one-off", but something you can continue to develop.' },
];

const faq = [
  { q: 'How much does it cost?', a: 'It depends. A small tweak can be a quick job, but an app is already a proper project. After a short brief we will give you options and a recommendation for the best value-for-money approach.' },
  { q: 'Do you also do "just" consulting?', a: 'Yes. Sometimes 60–90 minutes is all it takes for everyone to know what to build, what to buy as an app and what to avoid - and why.' },
  { q: 'Can you integrate something that "has no integration"?', a: 'If the service has an API (or at least a reasonable export/import), a path can usually be found.' },
];
---

<PageLayout title="Custom Development & Apps" description="Custom Shopify apps, integrations and theme modifications tailored to your needs." lang="en">
  <ServiceHero
    lang="en"
    label="Custom Development"
    title="APPS & <br /><span style='color:#fff'>CUSTOM DEVELOPMENT</span>"
    subtitle="Feel like you have exhausted all app options or have something atypical? OK - let's tackle it!"
    ctaLabel="Let's talk"
    ctaHref="tel:+420776067663"
    cta2Label="Find out how"
    cta2Href="#how-we-do-it"
    image="/na-miru-pen.webp"
    imageAlt="Custom development and apps for Shopify"
  />

  <!-- Intro + HOW WE DO IT sidebar -->
  <section class="section bg-primary" id="how-we-do-it">
    <div class="container intro-layout">
      <div class="intro-main">
        <h2 class="h1 intro-h2">Do you need an <span class="accent-purple">APP</span> <br />or a <span class="accent-purple">CUSTOM MODIFICATION</span>?</h2>
        <p class="intro-text">This part of our work is, on one hand, wonderfully simple to explain - and on the other, <strong class="hl">quite unpredictable to actually build</strong>. In the ideal scenario, you come to us with a problem and leave with a solution. Somewhere in between, we find or build that solution. Makes sense?</p>
        <h3 class="h3 intro-subhead">Understand first, then solve.</h3>
        <p class="intro-text">So that a custom solution does not burn through your budget or your nerves, we follow a simple logic: first understand the problem, then build anything.</p>
        <p class="intro-text">We'll first check whether a ready-made solution already exists - then we'll break your problem down together so we can actually solve it. Sometimes it's one small tweak that lifts conversions. Other times it's an integration that <strong class="hl">straightens out data across your entire operation</strong>. And sometimes it's an app you simply can't do without.</p>
        <a href="#cta" class="btn-action btn-action--lg">Let's go</a>
      </div>
      <WorkSidebar heading="HOW WE DO IT" items={processItems} />
    </div>
  </section>

  <!-- When is it time for custom? + deliverables (2-col) -->
  <section class="section bg-primary">
    <div class="container">
      <h2 class="h2 section-title">When is it time for "custom"?</h2>
      <p class="section-text body">The Shopify App Store is great. But sometimes you hit a limit: <strong class="hl">local specifics, atypical data, a more complex process - or you simply have a need that's "just yours"</strong>, because of your product or service. That's when it makes sense to build something: fast, clean, and in a way that can be maintained long-term.</p>
      <div class="custom-2col">
        <div>
          <h3 class="h3 when-subhead">An app sometimes is not enough when</h3>
          <ul class="arrow-list">
            {whenCustom.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <a href="tel:+420776067663" class="btn-action btn-action--lg">Great, bring it on.</a>
        </div>
        <div>
          <h3 class="h3 when-subhead">Modifications, integrations and custom apps</h3>
          <ul class="arrow-list">
            {deliverables.map((d) => (
              <li>{d}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Why us + Typical trickier nuts - 2 columns -->
  <section class="section bg-primary">
    <div class="container proc-row">
      <div class="proc-card edge-glow">
        <h2 class="proc-heading">Why work with us</h2>
        <ul class="arrow-list">
          {whyUs.map((w) => (
            <li><span><strong class="hl">{w.title}</strong>: {w.desc}</span></li>
          ))}
        </ul>
      </div>
      <div class="oricky-col">
        <h2 class="h2 section-title">Typical "trickier nuts to crack"</h2>
        <ul class="arrow-list">
          {hardCases.map((h) => (
            <li><span><strong class="hl">{h.title}</strong>: {h.desc}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- FAQ - sdílená komponenta ArticleFaq; vlastní akordeon na téhle
       stránce byl STARŠÍ podoba téhož bloku (DK 2026-08-04) -->
  <ArticleFaq title="FAQ (quick and no fluff)" items={faq.map((f) => ({ q: f.q, a: [f.a] }))} />

  <!-- Our current apps -->
  <section class="section bg-primary">
    <div class="container">
      <h2 class="h2 section-title">Our current apps</h2>
      <div class="apps-grid">
        <a href="/en/esyncer" class="app-card">
          <div class="app-card-header" style="background-image: url('/header-image-esyncer.webp')">
            <img src="/es-sipky.svg" alt="eSyncer" class="app-logo" />
          </div>
          <div class="app-card-body">
            <h3 class="h3">eSyncer</h3>
            <p>Product data import, sync & automation for Shopify and beyond.</p>
            <span class="btn-action btn-action--lg app-cta">Learn more about eSyncer</span>
          </div>
        </a>
        <a href="/en/ae-translator" class="app-card">
          <div class="app-card-header" style="background-image: url('/ae-translator-hero.webp')">
            <img src="/ae-translate-znak.svg" alt="AE Translator" class="app-logo" />
          </div>
          <div class="app-card-body">
            <h3 class="h3">AE Translator</h3>
            <p>AI-powered Shopify content translation. DeepL, Claude or DeepSeek - your choice.</p>
            <span class="btn-action btn-action--lg app-cta">Learn more about AE Translator</span>
          </div>
        </a>
        <a href="/en/kontakt" class="app-card app-card--teaser">
          <div class="app-card-header app-card-header--teaser">
            <svg class="app-logo" width="84" height="84" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/></svg>
          </div>
          <div class="app-card-body">
            <h3 class="h3">What about your app?</h3>
            <p>Got an idea for your own app or need something custom? Get in touch and we can start.</p>
            <span class="btn-action btn-action--lg app-cta">Get in touch</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section" id="cta">
    <div class="container cta-inner">
      <h2>Shall we build something together? <br />Get in touch</h2>
      <div class="cta-contacts">
        <a href="mailto:info@aethero.cz" class="cta-contact">info@aethero.cz</a>
        <a href="tel:+420776067663" class="cta-contact">+420 776 067 663</a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .intro-subhead { margin-top: var(--space-16); color: #fff; }
  /* Intro + sidebar = 2 columns */
  .intro-layout { display: grid; grid-template-columns: 1fr 355px; gap: var(--space-64); align-items: start; }
  @media (max-width: 900px) { .intro-layout { grid-template-columns: 1fr; gap: var(--space-40); } }
  .section-text { margin-bottom: var(--space-24); max-width: 760px; }

  .when-subhead { color: #fff; margin-bottom: var(--space-24); }
  .custom-2col { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-64); align-items: start; }
  .custom-2col .arrow-list { margin-bottom: var(--space-40); }
  .custom-2col .btn-action--lg { margin-top: 30px; }
  @media (max-width: 900px) { .custom-2col { grid-template-columns: 1fr; gap: var(--space-40); } }

  .proc-row { display: grid; grid-template-columns: 2fr 3fr; gap: var(--space-64); align-items: start; }
  @media (max-width: 900px) { .proc-row { grid-template-columns: 1fr; gap: var(--space-40); } }
  .proc-card {
    background: var(--ae-bg-deep);
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: var(--radius-md);
    padding: var(--space-32);
  }
  .proc-heading {
    font-family: var(--font-primary);
    font-size: var(--fs-18); font-weight: 700; letter-spacing: 0.08em;
    text-transform: uppercase; color: #fff; margin-bottom: var(--space-24);
  }

  /* FAQ Accordion */

  /* Apps - 3-card grid */
  .app-card { background: rgba(255,255,255,0.08); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.08); border-radius: var(--radius-md); overflow: hidden; display: flex; flex-direction: column; transition: border-color 0.2s, transform 0.2s; text-decoration: none; }
  .app-card:hover { border-color: rgba(13,212,205,0.3); transform: translateY(-2px); }
  .app-card-header { position: relative; height: 260px; background-size: cover; background-position: center top; }
  .app-card-header.app-card-header--teaser { background-image: url('/a-multitvar-bgr-v33.webp'); background-size: 200%; background-position: right -50px top -50px; }
  .app-card-header--teaser .app-logo { color: #fff; }
  .app-logo { position: absolute; left: 28px; bottom: 20px; width: 84px; height: 84px; object-fit: contain; z-index: 2; filter: drop-shadow(0 4px 14px rgba(0,0,0,0.5)); }
  .app-card-body { padding: 28px 32px 36px; flex: 1; display: flex; flex-direction: column; }
  .app-card-body h3 { margin-bottom: 10px; }
  .app-card-body p { font-size: 16px; color: var(--neutral-300); line-height: 1.6; margin-bottom: 20px; flex: 1; }
  .app-cta { align-self: flex-start; }

  @media (max-width: 768px) { .apps-grid { grid-template-columns: 1fr; } }
</style>
