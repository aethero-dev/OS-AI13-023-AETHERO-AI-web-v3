---
import PageLayout from '../../../layouts/PageLayout.astro';
import ArticleFaq from '../../../components/ArticleFaq.astro';
import ServiceHero from '../../../components/layout/ServiceHero.astro';
import WorkSidebar from '../../../components/layout/WorkSidebar.astro';

// Four steps for how work with us starts. They replaced the placeholder
// "To be added" text that was live on the site (DK 2026-08-04).
const startSteps = [
  { icon: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>', title: 'Tell us what hurts', desc: 'A few sentences or a link to your store is enough. We don\'t need a three-page brief — we need to know what\'s holding you back.' },
  { icon: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>', title: 'We look under the hood', desc: 'We go through the theme, the apps and the connected systems. We tell you what\'s the cause and what\'s only a symptom — even when that means the problem isn\'t where you expected.' },
  { icon: '<path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z"/>', title: 'You get options', desc: 'What can be fixed right away, what deserves a proper project, and what\'s worth avoiding. Always with an estimate of time and cost.' },
  { icon: '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>', title: 'We keep going', desc: 'A one-off fix or long-term support — both are fine. We don\'t tie anyone into a contract they don\'t want.' },
];

// FAQ built on what merchants genuinely ask about agency support for Shopify
// (research 2026-08-04). Written for AI SEO the way our own article prescribes:
// answer in the opening sentences, concrete detail, no filler. ArticleFaq adds
// FAQPage schema on top.
const faq = [
  {
    q: 'Do I need a long-term contract, or is a one-off fix enough?',
    a: [
      'A one-off fix is fine. Plenty of our relationships start with a single problem nobody else solved, and carry on from there by themselves.',
      'Ongoing support makes sense when changes keep coming, the store is growing, or you need to know somebody picks up the phone at the weekend. We don\'t push anyone into it.',
    ],
  },
  {
    q: 'How much does support cost?',
    a: [
      'It depends on whether it\'s one change or continuous care. A small tweak can take a couple of hours; a custom app is a project.',
      'After a short conversation to pin down the brief, you get options with an estimate of time and cost — plus a recommendation on what gives the best value. Any number before that would be made up.',
    ],
  },
  {
    q: 'Will you take over a store somebody else built?',
    a: [
      'Yes, and we do it often. We start by going through the theme, the apps and the connected systems, and telling you what state it\'s in.',
      'We don\'t rewrite someone else\'s work on principle. If it works, we leave it; we change what holds you back or is likely to break.',
    ],
  },
  {
    q: 'How fast do you respond when something breaks?',
    a: [
      'If sales are down, we start immediately — that\'s the one thing with absolute priority on an e-shop.',
      'For regular changes we agree a date up front, so you know what to expect. We don\'t pretend everything is done within the hour.',
    ],
  },
  {
    q: 'What if my problem can be solved by an App Store app?',
    a: [
      'Then we\'ll recommend it. There\'s no reason to build something custom when a ready-made app does it for a few euros a month, maintained by someone who works on it full time.',
      'Custom development makes sense where no app exists, where you\'d need five at once, or where two years of subscription fees would outgrow the cost of building your own.',
    ],
  },
  {
    q: 'Can you help with performance and Core Web Vitals?',
    a: [
      'Yes. We deal with theme speed, the load apps put on the store, and stability during sales peaks.',
      'Most slow Shopify stores are slow because of stacked apps and third-party scripts, not because of Shopify itself. We start by measuring what each script actually costs you.',
    ],
  },
  {
    q: 'Can you handle international selling through Shopify Markets?',
    a: [
      'Yes. We set up markets, currencies, languages, domains, tax rules, shipping and local payment methods so it works without duplicating the store.',
      'The most common mistake is launching a second separate store for abroad. It almost always comes back as double the work on products and content.',
    ],
  },
];

const features = [
  { title: 'Technical support & troubleshooting', desc: 'We solve complex technical problems in Liquid templates, custom apps, Shopify Functions, checkout and connected services. We identify the root cause of errors — not just the symptoms.', img: '/support.jpg', reverse: false },
  { title: 'Feature expansion & custom development', desc: 'We develop custom modifications to order — advanced work with products, pricing, checkout, shipping and payment logic, including custom apps.', img: '/custom.webp', reverse: true },
  { title: 'Integrations & system architecture', desc: 'We design and deliver robust integrations with ERP, CRM, warehouse and logistics systems. We automate data flows and set up scalable architecture without vendor lock-in.', img: '/system1.webp', reverse: false },
  { title: 'Shopify Markets setup for international expansion', desc: 'Technical configuration of multiple markets, currencies, languages, domains, tax rules, shipping and local payments. We prepare your store for operation across countries without duplicating solutions.', img: '/shopify-international.webp', reverse: true },
  { title: 'Performance, stability & scaling', desc: 'We keep template performance, app load, Core Web Vitals and overall store stability in a state that handles high traffic and sales peaks.', img: '/vykon.webp', reverse: false },
  { title: 'Design & UX support with technical depth', desc: 'We help with design adjustments, UX optimisation and design system implementation directly in Shopify — from working with an existing theme to custom solutions, all aligned with the brand and technical best practices.', img: '/ux-we-do.webp', reverse: true },
  { title: 'Technical consulting & long-term support', desc: 'We are your technical partner for continuous development — from audits and code reviews to strategic decisions about the future direction of your Shopify solution.', img: '/longtime-support.jpg', reverse: false },
];

---

<PageLayout title="Development & Support" description="Long-term technical partner for your Shopify project. We are here for support, development, integrations and strategy." lang="en">
  <ServiceHero
    lang="en"
    label="Development & Support"
    title="DEVELOPMENT <br /><span style='color:#fff'>& SUPPORT</span>"
    subtitle="Shopify project? We are ready where help is needed. Missing people, time, knowledge? Write, call."
    ctaLabel="Let's talk"
    ctaHref="tel:+420776067663"
    cta2Label="Find out how"
    cta2Href="#what-we-do"
    image="/lifebuoy.webp"
    imageAlt="Shopify development and support"
  />

  <!-- Intro + HOW WE START sidebar -->
  <section class="section bg-primary">
    <div class="container intro-layout">
      <div class="intro-main">
        <h2 class="h1 intro-h2"><span class="accent-purple">WHAT DO YOU NEED HELP WITH</span> <br />on your Shopify project?</h2>
        <p class="intro-text"><strong class="hl">Sometimes searching for tutorial videos just isn't enough.</strong> What you need is deeper technical insight, experience from multiple real-world projects, and the ability to connect the dots.</p>
        <p class="intro-text">We want you to know that even after years in this field, <strong class="hl">we haven't lost our humility</strong> — and when we can help, we will.</p>
        <p class="intro-text">Developing and supporting a Shopify project doesn't end at launch. We know that not every problem has an answer in a tutorial or a video — often what's needed is deeper technical insight, experience from real projects and the ability to see how things connect.</p>
        <p class="intro-text">We're here as a partner for the continued development of your Shopify solution, whether that means performance optimisation, new features, integrations or strategic decisions. Even after years of working with Shopify we approach every project with humility and an open mind — if there's a way, we'll help you find a workable and sustainable solution.</p>
        <a href="#cta" class="btn-action btn-action--lg">Let's get to it</a>
      </div>
      <WorkSidebar heading="HOW WE START" items={startSteps} />
    </div>
  </section>

  <!-- What we will do for you -->
  <section class="section bg-primary">
    <div class="container">
      <h2 class="h2-mini section-title" id="what-we-do">What we can do for you as part of our technical support</h2>
    </div>
  </section>

  <!-- Feature sections -->
  {features.map((f) => (
    <section class={`feature-section${f.reverse ? ' feature-section--reverse' : ''}`}>
      <div class="container feature-inner">
        <div class="feature-text">
          <h3 class="h3 feature-title">{f.title}</h3>
          <p class="body">{f.desc}</p>
        </div>
        <div class="feature-img-wrap">
          <img src={f.img} alt={f.title} class="feature-img" loading="lazy" />
        </div>
      </div>
    </section>
  ))}

  <ArticleFaq title="Support and development — frequently asked questions" items={faq} />

  <!-- CTA -->
  <section class="cta-section" id="cta">
    <div class="container cta-inner">
      <h2>Can we help? Get in touch</h2>
      <div class="cta-contacts">
        <a href="mailto:info@aethero.cz" class="cta-contact">info@aethero.cz</a>
        <a href="tel:+420776067663" class="cta-contact">+420 776 067 663</a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .intro-layout { display: grid; grid-template-columns: 1fr 355px; gap: var(--space-64); align-items: start; }
  @media (max-width: 900px) { .intro-layout { grid-template-columns: 1fr; gap: var(--space-40); } }

  .section-title { text-align: center; }

  .feature-section--reverse .feature-inner { direction: rtl; }
  .feature-section--reverse .feature-text,
  .feature-section--reverse .feature-img-wrap { direction: ltr; }
  .feature-title { margin-bottom: var(--space-24); color: #fff; }
  .feature-img-wrap { display: flex; align-items: center; justify-content: center; }


  @media (max-width: 1024px) {
    .feature-inner { grid-template-columns: 1fr; }
    .feature-section--reverse .feature-inner { direction: ltr; }
    .feature-img-wrap { display: none; }
  }
</style>
