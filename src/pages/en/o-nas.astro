---
import PageLayout from '../../layouts/PageLayout.astro';

// Obsah 1:1 podle ostrého aethero.cz/o-nas (pokyn DK 2026-08-05) - osobní
// bios se při dřívějším přepisu ztratily a byly to nejoriginálnější texty
// na stránce. Fotky = pixel avatary (PixelLab, DK 2026-08-05; zdroj
// __1 AETHERO/02 WEB/__WEB AE 3-0/TYM icons/, 424×424, pozadí zapečené).
const team = [
  {
    name: 'David',
    role: 'Design, Business Development',
    photo: '/team-david.png',
    desc: "David handles mainly design and business development at aethero. So when you call us, he's the one who'll pick up.",
    email: 'david@aethero.cz',
    phone: '+420 776 067 663',
  },
  {
    name: 'Bára',
    role: 'Coding, UX/UI, Project Management',
    photo: '/team-bara.png',
    desc: "“Making sure everything makes sense” probably best describes what Bára does. She's one of those rare, perpetually moving beings who can bend time and space. How else she manages all that work and a family with a constant smile, we simply can't explain!",
    email: 'bara@aethero.cz',
  },
  {
    name: 'Tom',
    role: 'Design',
    photo: '/team-tom.png',
    desc: "He's in charge of graphics, video, 3D, motion design and all the “prettifying” of the products we make for clients. Tom is on the Path - he teaches yoga, streams about healthy living, keeps bees and is an all-round easy-going guy.",
  },
];

// External team - poznámky jsou zatím Lorem ipsum (vědomě, pokyn DK
// 2026-08-05; web není spuštěný). DK je nahradí skutečnými větami.
const spoluprace: { jmeno: string; obor: string; poznamka?: string }[] = [
  { jmeno: 'Petr', photo: '/team-placeholder.svg', obor: 'AI evangelist, process management, analytics', poznamka: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt.' },
  { jmeno: 'Dominik', photo: '/team-placeholder.svg', obor: 'SEO specialist', poznamka: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt.' },
  { jmeno: 'Daniel', photo: '/team-placeholder.svg', obor: 'Legal services', poznamka: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt.' },
  { jmeno: 'Honza', photo: '/team-placeholder.svg', obor: 'Design', poznamka: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt.' },
];

// Tech partners - block is READY but renders only with 4+ items
// (DK 2026-08-05: show once there are four). Candidates: Packeta,
// Comgate, Make, Gorgias, Judge.me (see answers/78).
const techPartneri: { nazev: string; logo?: string; url?: string }[] = [
  { nazev: 'Klaviyo', url: 'https://www.klaviyo.com' },
  { nazev: 'Ecomail', url: 'https://ecomail.cz' },
];

// What we believe - manifest (37signals format; DK 2026-08-05)
const principy = [
  { titulek: 'Launch is just the beginning, not the end', text: "You don't launch a store, you run it: measurement, iteration, support, growth. That's why clients stay with us for years." },
  { titulek: 'No surprises', text: "With us you know what's being done, why, and what it costs - continuously, not on the invoice." },
  { titulek: 'Step by step to the finish line', text: "We do Shopify every day, which is why we know more about it than others. It's not magic - just a few years of work, searching and trying again and again." },
  { titulek: 'AI is our tool, not a substitute for craft', text: 'We automate absolutely everything a machine does better, so more brainpower is left for strategy, design, communication and content. A human always makes the call.' },
];

// We do / We don't - culture with humour (Humaan format)
const delame = [
  'long-term client relationships',
  'Shopify from brand to custom apps',
  'proper craft: speed, accessibility, design, logic',
  'our own apps in the Shopify App Store - and in your store',
  'honey - really, Tom does keep bees',
];
const nedelame = [
  "projects we don't believe in ourselves",
  "promises we can't keep",
];

const certifikace = [
  { img: '/badge-selling.png', alt: 'Shopify - Selling Fundamentals, verified skill' },
  { img: '/badge-development.png', alt: 'Shopify - Development Fundamentals, verified skill' },
  { img: '/badge-solution.png', alt: 'Shopify - Solution Planning Fundamentals, verified skill' },
];
---

<PageLayout title="About Us" description="We met on a few projects and it soon became clear it made sense to put together something more official. Between us, we have a few decades of experience in the field." lang="en" skryjLogo>

  <section class="o-nas-hero">
    <div class="hero-blob" aria-hidden="true"></div>
    <div class="container">
      <img src="/ae-logo.svg" alt="æthero" class="hero-logo" width="1120" height="280" loading="eager" />
      <h1>About us</h1>
      <div class="hero-manifest">
        <p>We're a small, highly specialised team from the Czech Republic. We do <strong class="hl">Shopify and AI</strong>. We're a <strong class="hl">Shopify Plus Partner</strong> and proud of it.</p>
        <p>And one more thing - even at the risk of disappointing you, you should know… no, we're not a big company. We're not an agency with dozens of employees, an open space and an account manager forwarding you emails from the team. If that's what you're looking for, you'll have to go elsewhere.</p>
        <p>We pride ourselves on being <strong class="hl">a scalpel, not a steamroller</strong>. Always more <strong class="hl">brains than brawn</strong>. If you come to us knowing what you want, we'll deliver it fast and clean. If you don't know yet, we'll help you figure it out and build it.</p>
        <p>Our motto: <strong class="hl">Making e-commerce simpler.</strong></p>
      </div>
    </div>
  </section>

  <section class="section bg-primary team-sekce" id="tym">
    <div class="container">
      <h2 class="h2 section-title">The team</h2>
      <div class="team-grid">
        {team.map((member) => (
          <div class="team-card">
            <img src={member.photo} alt={`${member.name} - ${member.role}`} class="team-photo" width="424" height="424" loading="lazy" />
            <h3 class="h3-mini team-name">{member.name}</h3>
            <p class="team-role">{member.role}</p>
            <p class="team-desc">{member.desc}</p>
            <div class="team-contacts">
              {member.phone && <a href={`tel:${member.phone.replace(/\s/g, '')}`} class="contact-pill">{member.phone}</a>}
              {member.email && <a href={`mailto:${member.email}`} class="contact-pill">{member.email}</a>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Externí tým - navazuje na Tým jako jeden blok (DK 2026-08-05) -->
  <section class="section bg-primary externi-sekce">
    <div class="container spoluprace-inner">
      {spoluprace.length > 0 && (
        <div class="spoluprace-grid">
          {spoluprace.map((s) => (
            <div class="spoluprace-card">
              <img src={s.photo} alt={`${s.jmeno} - ${s.obor}`} class="team-photo" width="424" height="424" loading="lazy" />
              <h3 class="h3-mini spoluprace-jmeno">{s.jmeno}</h3>
              <p class="spoluprace-obor">{s.obor}</p>
              {s.poznamka && <p class="spoluprace-poznamka">{s.poznamka}</p>}
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- Naše zásady + Co děláme/neděláme vedle sebe (DK 2026-08-05 večer:
       bez čísel, bez „Senior od začátku", dva sloupce) -->
  <section class="section bg-primary">
    <div class="container">
      <div class="zasady-grid">
        <div>
          <h2 class="h2 section-title">Our principles</h2>
          <div class="principy">
            {principy.map((p) => (
              <div class="princip">
                <h3 class="h3-mini princip-titulek">{p.titulek}</h3>
                <p class="princip-text">{p.text}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="delame-karta">
          <h2 class="h2 section-title">What we do,</h2>
          <ul class="delame-list delame-list--ano">
            {delame.map((d, i) => <li style={`--i: ${i}`}>{d}</li>)}
          </ul>
          <h2 class="h2 section-title nedelame-nadpis">and what we don't</h2>
          <ul class="delame-list delame-list--ne">
            {nedelame.map((n, i) => <li style={`--i: ${i + delame.length}`}>{n}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {techPartneri.length >= 4 && (
    <section class="section bg-primary">
      <div class="container spoluprace-inner">
          <h2 class="h2 section-title">Tech partners</h2>
        <div class="partneri-lista">
          {techPartneri.map((t) => (
            <a href={t.url} class="partner-cell" target="_blank" rel="noopener noreferrer">
              {t.logo
                ? <img src={t.logo} alt={t.nazev} class="partner-logo" loading="lazy" />
                : <span class="partner-nazev">{t.nazev}</span>}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Certifikace - originální Shopify badge, NIKDY nepřekreslovat do vlastních
       karet (DK 2026-08-05: „je to odznak, co jinak nezískáš") -->
  <section class="certifikace">
    <div class="container certifikace-inner">
      <p class="certifikace-label">Shopify certifications</p>
      <div class="certifikace-badges">
        {certifikace.map((c) => (
          <img src={c.img} alt={c.alt} class="certifikace-badge" loading="lazy" />
        ))}
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container cta-inner">
      <h2>Call, write! <br />We don't bite.</h2>
      <div class="cta-contacts">
        <a href="mailto:info@aethero.cz" class="cta-link">info@aethero.cz</a>
        <a href="tel:+420776067663" class="cta-link">+420 776 067 663</a>
      </div>
    </div>
  </section>

</PageLayout>

<script>
  // Animace karty Co děláme/neděláme - položky nastoupí, až když je karta vidět
  const karta = document.querySelector('.delame-karta');
  if (karta && 'IntersectionObserver' in window) {
    karta.classList.add('anim-ready');
    const io = new IntersectionObserver((zaznamy) => {
      zaznamy.forEach((z) => {
        if (z.isIntersecting) { karta.classList.add('zije'); io.disconnect(); }
      });
    }, { threshold: 0.2 });
    io.observe(karta);
  }
</script>

<style>
  .o-nas-hero {
    position: relative; padding: 130px 0 80px;
    background: var(--ae-bg-primary-alt); overflow: hidden;
  }
  .hero-blob {
    position: absolute; top: -20%; right: -5%; width: 500px; height: 500px;
    background: radial-gradient(ellipse, rgba(203,0,215,0.15) 0%, transparent 70%);
    border-radius: 50%; filter: blur(60px); pointer-events: none;
  }
  .o-nas-hero .container { position: relative; }
  /* Velké logo místo toho v menu - jako na .cz (DK 2026-08-05) */
  .hero-logo { width: 64%; height: auto; display: block; margin: var(--space-48) 0 var(--space-120); }
  .o-nas-hero h1 { font-size: var(--fs-64); font-weight: 700; }
  .hero-manifest { margin-top: var(--space-24); max-width: 680px; display: flex; flex-direction: column; gap: var(--space-16); }
  .hero-manifest p { font-size: 20px; color: #fff; line-height: 1.65; }

  /* Stejná mřížka jako Externí tým - všichni mají stejně velkou kartu
     (pokyn DK 2026-08-05); u jádra zbývá čtvrté pole volné. */
  .team-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-16); }
  .team-card {
    background: var(--ae-bg-primary);
    border-radius: var(--radius-md); padding: var(--space-24);
    display: flex; flex-direction: column; gap: 10px;
  }
  /* Duotone + blob jsou zapečené přímo v PNG z .cz - fotka se jen položí */
  .team-photo { width: min(150px, 70%); height: auto; align-self: flex-start;
    image-rendering: pixelated; border-radius: var(--radius-md); }
  .team-name { }
  .team-role { font-size: var(--text-small); color: rgba(255,255,255,0.6); font-weight: 500; }
  .team-desc { font-size: var(--text-small); color: var(--neutral-300); line-height: 1.6; flex: 1; }
  .team-contacts { display: flex; flex-direction: column; gap: 6px; margin-top: auto; }
  .contact-pill { font-size: 14px; color: var(--neutral-500); transition: color var(--transition-base); }
  .contact-pill:hover { color: var(--action); }

  /* S kým spolupracujeme */
  .spoluprace-inner { }
  .spoluprace-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-16); }
  .spoluprace-card {
    background: var(--ae-bg-primary);
    border-radius: var(--radius-md); padding: var(--space-24);
    display: flex; flex-direction: column; gap: 10px;
  }
  .spoluprace-card .team-photo { margin-bottom: 0; }
  .spoluprace-jmeno { margin-bottom: 4px; }
  .spoluprace-obor { font-size: var(--text-small); color: rgba(255,255,255,0.6); font-weight: 500; margin-bottom: 8px; }
  .spoluprace-poznamka { font-size: var(--text-small); color: var(--neutral-300); line-height: 1.6; }

  /* Externí tým lepí na Tým - jeden souvislý blok lidí, bez vlastního
     nadpisu (DK 2026-08-05); mezera mezi mřížkami = gap mřížky */
  .team-sekce { padding-bottom: var(--space-16); scroll-margin-top: 90px; }
  .externi-sekce { padding-top: 0; }

  /* Tech partneři - lišta ve stylu Swanky (mřížka buněk s logy) */
  .partneri-lista {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px;
    background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--radius-md); overflow: hidden; margin-top: var(--space-40);
  }
  .partner-cell {
    background: var(--ae-bg-primary); min-height: 120px;
    display: flex; align-items: center; justify-content: center;
    padding: var(--space-24); text-decoration: none;
    transition: background var(--transition-base);
  }
  .partner-cell:hover { background: rgba(255,255,255,0.04); }
  .partner-logo { max-height: 40px; max-width: 70%; width: auto; }
  .partner-nazev { font-family: var(--font-primary); font-size: 20px; font-weight: 700; color: var(--neutral-300); }

  /* Naše zásady + Děláme/Neděláme - dva sloupce */
  .zasady-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-64); align-items: start; }
  .principy { display: flex; flex-direction: column; gap: var(--space-32); margin-top: var(--space-40); }
  .princip-titulek { margin-bottom: 6px; }
  .princip-text { font-size: 17px; color: var(--neutral-300); line-height: 1.65; max-width: 520px; }
  .nedelame-nadpis { margin-top: var(--space-48); }

  /* Děláme / Neděláme - tmavá karta (DK 2026-08-05) */
  .delame-karta {
    background: #000114; border: 1px solid rgba(255,255,255,0.10);
    border-radius: var(--radius-md); padding: var(--space-40);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .delame-karta:hover { border-color: rgba(22,190,207,0.35); box-shadow: 0 12px 40px rgba(0,0,0,0.35); }
  /* Nástup položek: schová je až JS (progressive enhancement) - bez něj je vše vidět */
  .delame-karta.anim-ready .delame-list li {
    opacity: 0; transform: translateX(-14px);
    transition: opacity 0.45s ease, transform 0.45s ease;
    transition-delay: calc(var(--i, 0) * 70ms);
  }
  .delame-karta.anim-ready.zije .delame-list li { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .delame-karta.anim-ready .delame-list li { opacity: 1; transform: none; transition: none; }
  }
  .delame-karta .section-title:first-child { margin-top: 0; }

  .delame-list { list-style: none; padding: 0; margin: var(--space-32) 0 0; display: flex; flex-direction: column; gap: var(--space-16); }
  .delame-list li { position: relative; padding-left: 34px; font-size: 17px; color: var(--neutral-300); line-height: 1.55; }
  .delame-list li::before { position: absolute; left: 0; top: 0; font-weight: 700; }
  .delame-list--ano li::before { content: '✓'; color: var(--action); }
  .delame-list--ne li::before { content: '✕'; color: var(--semantic-error); }

  /* Certifikace - originální badge, nenápadně na konci */
  .certifikace { background: var(--ae-bg-primary); padding: var(--space-40) 0 var(--space-80); }
  .certifikace-inner { display: flex; align-items: center; gap: var(--space-40); flex-wrap: wrap; }
  .certifikace-label {
    font-family: var(--font-primary); font-size: 13px; font-weight: 600;
    letter-spacing: 0.09em; text-transform: uppercase; color: var(--neutral-500);
  }
  .certifikace-badges { display: flex; gap: var(--space-32); align-items: center; flex-wrap: wrap; }
  .certifikace-badge { height: 220px; width: auto; }

  .cta-link { font-size: var(--fs-40); color: var(--ae-straight-blue); font-family: var(--font-primary); font-weight: 700; text-decoration: none; transition: opacity var(--transition-base); }
  .cta-link:hover { text-decoration: underline; text-underline-offset: 4px; }

  @media (max-width: 1100px) {
    .team-grid { grid-template-columns: repeat(2, 1fr); }
    .spoluprace-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .team-grid { grid-template-columns: 1fr; }
    .spoluprace-grid { grid-template-columns: 1fr; }
    .partneri-lista { grid-template-columns: repeat(2, 1fr); }
    .zasady-grid { grid-template-columns: 1fr; gap: var(--space-40); }
    .certifikace-badge { height: 150px; }
    .cta-contacts { flex-direction: column; align-items: center; gap: var(--space-16); }
    .o-nas-hero { padding: 90px 0 60px; }
    .hero-manifest p { font-size: 18px; }
  }
  @media (max-width: 480px) {
    .o-nas-hero { padding: 70px 0 48px; }
    .o-nas-hero h1 { font-size: var(--fs-48); }
    .hero-manifest p { font-size: 16px; }
    .section { padding: var(--space-80) 0; }
  }
</style>
