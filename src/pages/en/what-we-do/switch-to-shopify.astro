---
import ArticleFaq from '../../../components/ArticleFaq.astro';
import PageLayout from '../../../layouts/PageLayout.astro';
import ServiceHero from '../../../components/layout/ServiceHero.astro';
import WorkSidebar from '../../../components/layout/WorkSidebar.astro';

// FAQ based on what merchants actually fear about migration (research 2026-08-04).
const faq = [
  {
    q: 'Will migration cost me my search rankings?',
    a: [
      'Not if a map of old URLs to new ones is built and <strong>301 redirects</strong> are deployed. That\'s the one measure that genuinely holds rankings; without it Google finds the old URLs as 404s and drops them.',
      'We build the map before launch and check indexing after the switch. Short-term movement in rankings is normal. A real drop is usually the result of missing redirects, not of the migration itself.',
    ],
  },
  {
    q: 'How long will my store be down?',
    a: [
      'With a properly run migration there is <strong>no loss of trading time</strong>. The new store is built alongside the existing one on a test domain and only switched over after full testing, by changing DNS.',
      'We schedule the switch for the night. The real window where anything might show is a few hours - and even that is DNS propagation rather than downtime.',
    ],
  },
  {
    q: 'What can be transferred?',
    a: [
      'Products, variants, collections, customers, orders, page and blog content. We move order history too, so customer support and analytics carry on where they left off.',
      'What doesn\'t move by itself: app settings, loyalty points and email lists. Those are handled separately and are worth planning for early - losing a subscriber list hurts more than anything else.',
    ],
  },
  {
    q: 'Can I convert the products myself?',
    a: [
      'If you\'re coming from Shoptet, yes. We built a [free tool](/shoptet-to-shopify-migration/) for exactly that, running right in your browser: upload the export, download a file in the format Shopify accepts.',
      'For more complex catalogues - many variants, metafields, warehouse links - it\'s worth talking the migration through. Not because it can\'t be done, but because cleaning the data usually costs more than moving it.',
    ],
  },
  {
    q: 'When is migration not worth it?',
    a: [
      'When you sell locally only, have no expansion plans, are happy with support in your own language and nothing on your current platform is holding you back. Then changing platform is a cost without a return.',
      'We\'ll tell you so. We have no reason to push anyone into a migration they gain nothing from - we wrote a [comparison of Shopify and Shoptet](/blog/shopify-vs-shoptet/) that goes through it in detail.',
    ],
  },
  {
    q: 'Can Shopify handle local payments and carriers?',
    a: [
      'Yes, but not out of the box - unlike a local platform, it has to be set up. Language is handled by translating the theme, payments through gateways like Comgate or GoPay, carriers through apps.',
      'It\'s one-off work at setup. Budget for it, so it doesn\'t come as a surprise that "Shopify can\'t do it". It can - it just isn\'t switched on overnight.',
    ],
  },
];

const migrationSteps = [
  { icon: '<path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" x2="4" y1="22" y2="15"/>', title: 'Start', desc: 'You have decided to migrate to Shopify with us.' },
  { icon: '<line x1="21" x2="14" y1="4" y2="4"/><line x1="10" x2="3" y1="9" y2="9"/><line x1="21" x2="3" y1="14" y2="14"/><line x1="21" x2="13" y1="19" y2="19"/><polyline points="17 1 21 5 17 9"/><polyline points="7 6 3 10 7 14"/>', title: 'Preparation', desc: 'Together we will prepare for the migration.' },
  { icon: '<rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/>', title: 'Data & SEO', desc: 'We will check inputs and set outputs to your expectations.' },
  { icon: '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>', title: 'Migration to Shopify', desc: 'Brand, narrative, colours, digital presence - all of it plays a role.' },
];

const features = [
  { title: 'Multichannel integration', desc: 'Sell <strong class="hl">from a single admin across all channels</strong> - Instagram, TikTok, Google Shopping, Amazon. One warehouse, one source of truth for inventory, everything from the Shopify admin.', img: '/shopify-chanels.webp', reverse: false },
  { title: 'Social media integration', desc: '<strong class="hl">Direct selling via Instagram, TikTok, Facebook and YouTube.</strong> Unified management of campaigns, products and orders from one place. Customers buy where they already are.', img: '/fbandinsta.webp', reverse: true },
  { title: 'Taxonomy and categorisation', desc: 'Advanced product organisation with Shopify product taxonomy - over 10,000 standardised categories. <strong class="hl">Better search, SEO and customer experience.</strong>', img: '/shopify-produkt-taxonomy.webp', reverse: false },
  { title: 'Show it to the world in the app', desc: '<strong class="hl">The Shopify Shop App gives customers a branded mobile experience.</strong> Notifications, order tracking, personalised feed - in every customer\'s phone.', img: '/shopapp.webp', reverse: true },
  { title: 'B2B pro solution', desc: 'Shopify Plus enables <strong class="hl">full B2B functionality - custom price lists, company accounts, approval processes, ERP connection and B2B checkout.</strong> Enterprise features without the enterprise price.', img: '/b2b.webp', reverse: false },
];

---

<PageLayout title="Migration to Shopify" description="Migrate from Shoptet, WooCommerce or another platform to Shopify without losing SEO, data or customers." lang="en">
  <ServiceHero
    lang="en"
    label="Migration"
    title="MIGRATION <br /><span style='color:#fff'>TO SHOPIFY</span>"
    subtitle="Hesitating? Want advice? Or have you already decided? Then let's go."
    ctaLabel="Let's talk"
    ctaHref="tel:+420776067663"
    cta2Label="Find out how"
    cta2Href="#why-migrate"
    image="/donut.webp"
    imageAlt="Migration to Shopify"
  />

  <!-- Intro + HOW WE DO IT sidebar -->
  <section class="section bg-primary">
    <div class="container intro-layout">
      <div class="intro-main">
        <h2 class="h1 intro-h2">We'll kickstart your <br /><span class="accent-purple">MIGRATION TO SHOPIFY</span></h2>
        <p class="intro-text">If you've hit the limits of your current platform, <strong class="hl">Shopify is the logical next step</strong>. Instead of a closed system with limited customisation, you get an open global platform built for growth - and expansion into international markets.</p>
        <p class="intro-text">It supports <strong class="hl">multiple currencies and languages, integrations with external systems</strong>, and seamless connection between online and offline sales through a unified POS. We'll help you migrate smoothly - preserving your SEO, data and customer experience.</p>
        <a href="#cta" class="btn-action btn-action--lg">Yes, we want to migrate</a>
      </div>
      <WorkSidebar heading="HOW WE DO IT" items={migrationSteps} />
    </div>
  </section>

  <!-- Shopify Edition Winter 2026 -->
  <section class="section bg-primary" id="why-migrate">
    <div class="container edition-split">
      <div class="edition-media">
        <img src="/shopify-update-winter-2026.webp" alt="Shopify Edition Winter 2026" class="edition-img" loading="lazy" />
        <a href="/blog/shopify-editions-winter-2026/" class="edition-square">
          <h3 class="edition-square-title">Shopify <br />Edition <br />Winter 26 <span class="edition-arrow">➔</span></h3>
        </a>
      </div>
      <div class="edition-text">
        <p class="section-text body">New features for speed, automation and international growth push Shopify another step ahead of local platforms. If you feel your store is held back by technology, now is the ideal time for a change. <a href="/blog/shopify-editions-winter-2026/" class="text-link">Read our overview of the most important things from Shopify Edition Winter 2026</a> or take a look right away at <a href="https://www.shopify.com/editions" target="_blank" rel="noopener noreferrer" class="text-link">everything Shopify can newly do on the official site</a>.</p>
        <a href="tel:+420776067663" class="btn-action btn-action--lg">Get in touch</a>
      </div>
    </div>
  </section>

  <!-- Feature sections -->
  {features.map((f, i) => (
    <section class={`feature-section${f.reverse ? ' feature-section--reverse' : ''}${i === 0 ? ' feature-section--first' : ''}`}>
      <div class="container feature-inner">
        <div class="feature-text">
          {i === 0 && (
            <div class="feature-lead">
              <h2 class="h2 feature-section-heading">Features you will love:</h2>
              <p class="body-maxi feature-lead-sub">If you have been around standard stores for a while, you will certainly appreciate these features and <strong class="hl">capabilities that come built-in with Shopify</strong></p>
            </div>
          )}
          <h3 class="h3 feature-title">{f.title}</h3>
          <p class="body" set:html={f.desc}></p>
        </div>
        <div class="feature-img-wrap">
          <img src={f.img} alt={f.title} class="feature-img" loading="lazy" />
        </div>
      </div>
    </section>
  ))}

  <ArticleFaq title="Migrating to Shopify - frequently asked questions" items={faq} />

  <!-- CTA -->
  <section class="cta-section" id="cta">
    <div class="container cta-inner">
      <h2>Time to get going? <br />Get in touch</h2>
      <div class="cta-contacts">
        <a href="mailto:info@aethero.cz" class="cta-contact">info@aethero.cz</a>
        <a href="tel:+420776067663" class="cta-contact">+420 776 067 663</a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .intro-layout { display: grid; grid-template-columns: 1fr 355px; gap: var(--space-64); align-items: start; }
  @media (max-width: 900px) { .intro-layout { grid-template-columns: 1fr; gap: var(--space-40); } }

  /* Shopify Edition blok - obrázek + fialový štítek vlevo, text+tlačítko vpravo */
  /* obrázek = levá 1/3, čtverec přesahuje doprava až ke středu (1/2), text = pravá půlka */
  .edition-split { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-80); align-items: center; }
  .edition-media { position: relative; }
  .edition-img { width: 72%; height: auto; border-radius: var(--radius-md); display: block; }
  /* H3 nadpis ve fialovém čtverci - ukotvený k pravému okraji levé půlky (= střed) */
  .edition-square {
    position: absolute; top: 50%; right: 0; transform: translateY(-50%);
    width: 44%; aspect-ratio: 1 / 1;
    display: flex; align-items: center; justify-content: center;
    background: var(--accent-purple); text-decoration: none;
    padding: var(--space-16);
    box-shadow: 0 16px 40px rgba(0,0,0,0.4);
    transition: background var(--transition-base);
  }
  .edition-square:hover { background: var(--text-secondary); }
  .edition-square-title { margin: 0; color: #fff; font-family: var(--font-primary); font-size: var(--fs-40); font-weight: 700; line-height: 1.1; }
  .edition-arrow { display: block; margin-top: var(--space-16); }
  /* check-list → globální .check-list (global.css) */

  .feature-section-heading { margin-bottom: var(--space-16); }
  /* lead text (sekční nadpis + perex) vložený do levého sloupce 1. bloku */
  .feature-lead { margin-bottom: var(--space-40); }
  .feature-lead-sub { margin-bottom: 0; }

  .feature-section--first { padding-top: var(--space-40); }
  .feature-section--reverse .feature-inner { direction: rtl; }
  .feature-section--reverse .feature-text,
  .feature-section--reverse .feature-img-wrap { direction: ltr; }
  .feature-title { margin-bottom: var(--space-24); }
  .feature-img-wrap { display: flex; align-items: center; justify-content: center; }


  @media (max-width: 1024px) {
    .edition-split { grid-template-columns: 1fr; gap: var(--space-40); }
    .feature-inner { grid-template-columns: 1fr; }
    .feature-section--reverse .feature-inner { direction: ltr; }
    .feature-img-wrap { display: none; }
  }
</style>
